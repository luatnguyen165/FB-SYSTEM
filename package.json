{
  "name": "fb-system",
  "version": "1.0.0",
  "main": "electron/main.js",
  "scripts": {
    "test": "echo \"Error: no test specified\" && exit 1",
    "telegram": "node telegram-claude.js",
    "dev": "nodemon app.js",
    "electron-dev": "cross-env NODE_ENV=development electron electron/main.js",
    "electron-start": "electron electron/main.js",
    "build": "electron-builder",
    "build:msi": "electron-builder --win msi",
    "build:portable": "electron-builder --win portable"
  },
  "keywords": [],
  "author": "FB System Team",
  "license": "ISC",
  "description": "FB System - Facebook Automation Desktop App",
  "dependencies": {
    "@reduxjs/toolkit": "^2.0.1",
    "axios": "^1.6.2",
    "bcryptjs": "^3.0.3",
    "connect-flash": "^0.1.1",
    "connect-mongo": "^6.0.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "crypto": "^1.0.1",
    "dotenv": "^17.4.2",
    "ejs": "^5.0.2",
    "electron-updater": "^6.8.9",
    "express": "^5.2.1",
    "express-ejs-layouts": "^2.5.1",
    "express-session": "^1.19.0",
    "ffmpeg-static": "^5.3.0",
    "fluent-ffmpeg": "^2.1.3",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^9.6.2",
    "morgan": "^1.10.1",
    "multer": "^2.1.1",
    "nodemailer": "^8.0.9",
    "nodemon": "^3.1.14",
    "openai": "^6.39.1",
    "playwright": "^1.60.0",
    "playwright-extra": "^4.3.6",
    "puppeteer-extra-plugin-stealth": "^2.11.2",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-redux": "^9.0.4",
    "redux-persist": "^6.0.0",
    "redux-saga": "^1.3.0",
    "sharp": "^0.34.5",
    "socket.io": "^4.8.3",
    "socket.io-client": "^4.8.3",
    "telegraf": "^4.16.3",
    "uuid": "^14.0.0",
    "yt-dlp-exec": "^1.0.2"
  },
  "devDependencies": {
    "cross-env": "^7.0.3",
    "electron": "^42.3.3",
    "electron-builder": "^26.15.2"
  },
  "build": {
    "appId": "com.fbsystem.app",
    "productName": "FB System",
    "directories": {
      "output": "release"
    },
    "publish": {
      "provider": "github",
      "owner": "luatnguyen165",
      "repo": "FB-SYSTEM",
      "releaseType": "release"
    },
    "files": [
      "electron/**/*",
      "app.js",
      "nodemon.json",
      "controllers/**/*",
      "locales/**/*",
      "middlewares/**/*",
      "models/**/*",
      "page_post/**/*",
      "public/**/*",
      "routes/**/*",
      "services/**/*",
      "uploads/**/*",
      "utils/**/*",
      "views/**/*",
      "package.json",
      ".env"
    ],
    "icon": "public/icon.png",
    "win": {
      "target": [
        {
          "target": "msi",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "${productName}-Setup-${version}.${ext}"
    },
    "extraMetadata": {
      "main": "electron/main.js"
    }
  }
}
