<%- include('partials/header') %>

<style>
    .license-card {
        transition: all .2s;
    }
    .license-card:hover {
        box-shadow: 0 4px 12px rgba(0,0,0,.1);
    }
    .license-key-text {
        font-family: 'Courier New', monospace;
        font-size: 14px;
        letter-spacing: 1px;
        user-select: all;
    }
    .badge-expired { background: #dc3545; color: #fff; }
    .badge-active { background: #28a745; color: #fff; }
    .badge-suspended { background: #ffc107; color: #000; }
    .badge-used { background: #17a2b8; color: #fff; }
    .badge-unused { background: #6c757d; color: #fff; }
</style>

<div class="container-fluid px-4 py-4">
    <!-- Header -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h4 class="mb-1"><i class="fas fa-key me-2"></i>Quản lý License Key</h4>
            <p class="text-muted mb-0">Tổng số: <strong><%= total %></strong> key</p>
        </div>
        <button class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#generateModal">
            <i class="fas fa-plus me-1"></i>Tạo Key mới
        </button>
    </div>

    <!-- Filter & Search -->
    <div class="card mb-4">
        <div class="card-body">
            <form method="GET" class="row g-3 align-items-end">
                <div class="col-md-3">
                    <label class="form-label">Trạng thái</label>
                    <select name="status" class="form-select" onchange="this.form.submit()">
                        <option value="">Tất cả</option>
                        <option value="active" <%= query.status === 'active' ? 'selected' : '' %>>Active</option>
                        <option value="suspended" <%= query.status === 'suspended' ? 'selected' : '' %>>Suspended</option>
                        <option value="expired" <%= query.status === 'expired' ? 'selected' : '' %>>Expired</option>
                    </select>
                </div>
                <div class="col-md-5">
                    <label class="form-label">Tìm kiếm (key / email)</label>
                    <input type="text" name="search" class="form-control" value="<%= query.search || '' %>" placeholder="Nhập key hoặc email...">
                </div>
                <div class="col-md-2">
                    <button type="submit" class="btn btn-outline-primary w-100">
                        <i class="fas fa-search me-1"></i>Tìm
                    </button>
                </div>
                <div class="col-md-2">
                    <a href="/admin/licenses" class="btn btn-outline-secondary w-100">
                        <i class="fas fa-redo me-1"></i>Reset
                    </a>
                </div>
            </form>
        </div>
    </div>

    <!-- List -->
    <div class="card">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover mb-0">
                    <thead class="table-light">
                        <tr>
                            <th>License Key</th>
                            <th>Loại</th>
                            <th>Trạng thái</th>
                            <th>Sử dụng</th>
                            <th>Người dùng</th>
                            <th>Ngày tạo</th>
                            <th>Hết hạn</th>
                            <th>Thao tác</th>
                        </tr>
                    </thead>
                    <tbody>
                        <% if (licenses.length === 0) { %>
                        <tr>
                            <td colspan="8" class="text-center py-4 text-muted">
                                <i class="fas fa-inbox fa-2x mb-2 d-block"></i>
                                Chưa có license key nào
                            </td>
                        </tr>
                        <% } %>
                        <% licenses.forEach(function(l) { %>
                        <tr class="license-card">
                            <td>
                                <span class="license-key-text"><%= l.key %></span>
                            </td>
                            <td>
                                <span class="badge bg-info"><%= l.productType %></span>
                            </td>
                            <td>
                                <% if (l.status === 'active') { %>
                                    <span class="badge badge-active">Active</span>
                                <% } else if (l.status === 'expired') { %>
                                    <span class="badge badge-expired">Expired</span>
                                <% } else { %>
                                    <span class="badge badge-suspended">Suspended</span>
                                <% } %>
                            </td>
                            <td>
                                <% if (l.isUsed) { %>
                                    <span class="badge badge-used">Đã dùng</span>
                                <% } else { %>
                                    <span class="badge badge-unused">Chưa dùng</span>
                                <% } %>
                            </td>
                            <td>
                                <%= l.assignedTo.email || '-' %>
                                <br><small class="text-muted"><%= l.maxDevices %> thiết bị</small>
                            </td>
                            <td><%= new Date(l.createdAt).toLocaleDateString('vi-VN') %></td>
                            <td>
                                <% if (l.expiresAt) { %>
                                    <span class="<%= new Date(l.expiresAt) < new Date() ? 'text-danger' : 'text-success' %>">
                                        <%= new Date(l.expiresAt).toLocaleDateString('vi-VN') %>
                                    </span>
                                <% } else { %>
                                    <span class="text-muted">Vĩnh viễn</span>
                                <% } %>
                            </td>
                            <td>
                                <div class="btn-group btn-group-sm">
                                    <% if (l.status === 'suspended') { %>
                                        <button class="btn btn-success toggle-btn" data-id="<%= l._id %>" title="Mở khóa">
                                            <i class="fas fa-unlock"></i>
                                        </button>
                                    <% } else { %>
                                        <button class="btn btn-warning toggle-btn" data-id="<%= l._id %>" title="Khóa">
                                            <i class="fas fa-lock"></i>
                                        </button>
                                    <% } %>
                                    <button class="btn btn-info extend-btn" data-id="<%= l._id %>" title="Gia hạn">
                                        <i class="fas fa-clock"></i>
                                    </button>
                                    <button class="btn btn-danger delete-btn" data-id="<%= l._id %>" title="Xóa">
                                        <i class="fas fa-trash"></i>
                                    </button>
                                </div>
                            </td>
                        </tr>
                        <% }); %>
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <!-- Pagination -->
    <% if (totalPages > 1) { %>
    <nav class="mt-3">
        <ul class="pagination justify-content-center">
            <li class="page-item <%= currentPage <= 1 ? 'disabled' : '' %>">
                <a class="page-link" href="?page=<%= currentPage - 1 %><%= query.status ? '&status=' + query.status : '' %><%= query.search ? '&search=' + query.search : '' %>">Trước</a>
            </li>
            <% for (let p = 1; p <= totalPages; p++) { %>
            <li class="page-item <%= p === currentPage ? 'active' : '' %>">
                <a class="page-link" href="?page=<%= p %><%= query.status ? '&status=' + query.status : '' %><%= query.search ? '&search=' + query.search : '' %>"><%= p %></a>
            </li>
            <% } %>
            <li class="page-item <%= currentPage >= totalPages ? 'disabled' : '' %>">
                <a class="page-link" href="?page=<%= currentPage + 1 %><%= query.status ? '&status=' + query.status : '' %><%= query.search ? '&search=' + query.search : '' %>">Sau</a>
            </li>
        </ul>
    </nav>
    <% } %>
</div>

<!-- Generate Modal -->
<div class="modal fade" id="generateModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <form method="POST" action="/admin/licenses/generate">
                <div class="modal-header">
                    <h5 class="modal-title"><i class="fas fa-key me-2"></i>Tạo License Key mới</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <div class="mb-3">
                        <label class="form-label">Số lượng key</label>
                        <input type="number" name="count" class="form-control" value="1" min="1" max="100">
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Loại sản phẩm</label>
                        <select name="productType" class="form-select">
                            <option value="standard">Standard</option>
                            <option value="premium">Premium</option>
                            <option value="enterprise">Enterprise</option>
                        </select>
                    </div>
                    <div class="row mb-3">
                        <div class="col">
                            <label class="form-label">Số thiết bị tối đa</label>
                            <input type="number" name="maxDevices" class="form-control" value="1" min="1">
                        </div>
                        <div class="col">
                            <label class="form-label">Số account tối đa</label>
                            <input type="number" name="maxAccounts" class="form-control" value="5" min="1">
                        </div>
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Số ngày hiệu lực</label>
                        <input type="number" name="daysValid" class="form-control" value="365" min="1">
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Hủy</button>
                    <button type="submit" class="btn btn-primary">
                        <i class="fas fa-plus me-1"></i>Tạo
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- Extend Modal -->
<div class="modal fade" id="extendModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title"><i class="fas fa-clock me-2"></i>Gia hạn License</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <div class="mb-3">
                    <label class="form-label">Số ngày gia hạn</label>
                    <input type="number" id="extendDays" class="form-control" value="365" min="1">
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Hủy</button>
                <button type="button" class="btn btn-primary" id="extendConfirm">
                    <i class="fas fa-check me-1"></i>Xác nhận
                </button>
            </div>
        </div>
    </div>
</div>

<script>
document.addEventListener('DOMContentLoaded', function() {
    // Toggle status
    document.querySelectorAll('.toggle-btn').forEach(btn => {
        btn.addEventListener('click', async function() {
            const id = this.dataset.id;
            const result = await fetch('/admin/licenses/' + id + '/toggle', { method: 'POST' });
            const data = await result.json();
            if (data.success) location.reload();
        });
    });

    // Extend
    let extendId = null;
    document.querySelectorAll('.extend-btn').forEach(btn => {
        btn.addEventListener('click', function() {
            extendId = this.dataset.id;
            new bootstrap.Modal(document.getElementById('extendModal')).show();
        });
    });
    document.getElementById('extendConfirm').addEventListener('click', async function() {
        const days = document.getElementById('extendDays').value;
        if (!extendId) return;
        const result = await fetch('/admin/licenses/' + extendId + '/extend', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ days: parseInt(days) })
        });
        const data = await result.json();
        if (data.success) location.reload();
    });

    // Delete
    document.querySelectorAll('.delete-btn').forEach(btn => {
        btn.addEventListener('click', async function() {
            if (!confirm('Xóa license này?')) return;
            const id = this.dataset.id;
            const result = await fetch('/admin/licenses/' + id, { method: 'DELETE' });
            const data = await result.json();
            if (data.success) location.reload();
        });
    });
});
</script>

<%- include('partials/footer') %>
