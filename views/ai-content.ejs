<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>AI Content Creator - ReelsFlow</title>
    <link rel="stylesheet" href="/css/base.css">
    <link rel="stylesheet" href="/css/style.css">
    <link rel="stylesheet" href="/css/ai-content-base.css">
    <link rel="stylesheet" href="/css/ai-content-cards.css">
    <link rel="stylesheet" href="/css/ai-content-modal.css">
    <link rel="stylesheet" href="/css/ai-content-schedule.css">
    <link rel="stylesheet" href="/css/ai-content-responsive.css">
    <link rel="stylesheet" href="/css/toast.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.6.0/css/all.min.css">
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
</head>
<body>
<%- include('partials/sidebar', { currentPage: 'ai-content' }) %>
<div class="main-content">
    <%- include('partials/header') %>
    <div class="content-body">

        <!-- Welcome Section -->
        <%- include('partials/welcome-section', {
            eyebrow: 'AI Content Creator',
            title: 'AI Viết Bài Tự Động',
            description: 'Tạo nội dung theo văn phong mẫu • Lên lịch tự động • Đăng đa nền tảng'
        }) %>

        <!-- API Key Status Bar -->
        <div class="ai-api-key-bar">
            <i class="fa-solid fa-key"></i>
            <span class="ai-api-key-status" id="apiKeyStatus"><%= openaiApiKey ? '✅ Đã cấu hình' : '⚠️ Chưa có OpenAI API Key' %></span>
            <% if (!openaiApiKey) { %>
            <a href="/settings" class="btn-save-apikey"><i class="fa-solid fa-gear"></i> Cấu hình ngay</a>
            <% } %>
        </div>

        <!-- Stats -->
        <div class="ai-content-stats">
            <div class="ai-content-stat-card">
                <div class="stat-icon primary"><i class="fa-solid fa-palette"></i></div>
                <div class="stat-info"><span class="stat-value" id="statStyles">0</span><span class="stat-label">Văn phong</span></div>
            </div>
            <div class="ai-content-stat-card">
                <div class="stat-icon success"><i class="fa-solid fa-calendar-check"></i></div>
                <div class="stat-info"><span class="stat-value" id="statSchedules">0</span><span class="stat-label">Lịch đang chạy</span></div>
            </div>
            <div class="ai-content-stat-card">
                <div class="stat-icon purple"><i class="fa-solid fa-file-lines"></i></div>
                <div class="stat-info"><span class="stat-value" id="statPosts">0</span><span class="stat-label">Bài đã tạo</span></div>
            </div>
            <div class="ai-content-stat-card">
                <div class="stat-icon warning"><i class="fa-solid fa-paper-plane"></i></div>
                <div class="stat-info"><span class="stat-value" id="statPublished">0</span><span class="stat-label">Đã đăng</span></div>
            </div>
        </div>

        <!-- Wizard entry buttons -->
        <div style="display: flex; gap: 10px; margin: 18px 0 8px;">
            <button type="button" class="btn-primary" id="btnOpenWizardPost">
                <i class="fa-solid fa-wand-magic-sparkles"></i> Tạo nội dung mới
            </button>
            <button type="button" class="btn-secondary" id="btnOpenWizardPipeline">
                <i class="fa-solid fa-robot"></i> Tạo Auto Pipeline
            </button>
        </div>

        <!-- Tabs -->
        <div class="ai-content-tabs">
            <button class="ai-tab-btn active" data-tab="styles"><i class="fa-solid fa-palette"></i> Văn Phong</button>
            <button class="ai-tab-btn" data-tab="schedules"><i class="fa-solid fa-calendar"></i> Lịch Nội Dung</button>
            <button class="ai-tab-btn" data-tab="posts"><i class="fa-solid fa-newspaper"></i> Bài Viết AI</button>
            <button class="ai-tab-btn" data-tab="products"><i class="fa-solid fa-box"></i> Sản Phẩm</button>
            <button class="ai-tab-btn" data-tab="autopipeline"><i class="fa-solid fa-robot"></i> Auto Pipeline</button>
        </div>

        <!-- Tab: Văn Phong -->
        <div class="ai-tab-content active" id="tab-styles">
            <div class="ai-content-section-header">
                <h2><i class="fa-solid fa-palette"></i> Quản lý Văn Phong</h2>
                <div style="display:flex;gap:10px;">
                    <button class="btn-secondary" id="btnResearchStyle"><i class="fa-solid fa-magnifying-glass-chart"></i> Học từ Group / Đối thủ</button>
                    <button class="btn-primary" id="btnNewStyle"><i class="fa-solid fa-plus"></i> Tạo Văn Phong Mới</button>
                </div>
            </div>

            <!-- Research Section -->
            <div class="ai-schedule-card" id="researchSection" style="display:none;margin-bottom:24px;border-left:3px solid var(--primary);">
                <div class="ai-schedule-header">
                    <div class="ai-schedule-icon active"><i class="fa-solid fa-graduation-cap"></i></div>
                    <div class="ai-schedule-info">
                        <h3>Học văn phong từ Group / Đối thủ</h3>
                        <div class="ai-schedule-meta">AI sẽ crawl bài viết và phân tích văn phong tự động</div>
                    </div>
                </div>
                <div style="padding-top:16px;">
                    <div class="form-row">
                        <div class="form-group">
                            <label>📍 Loại nguồn</label>
                            <select id="researchType" class="form-input">
                                <option value="group">Facebook Group</option>
                                <option value="profile">Profile đối thủ</option>
                            </select>
                        </div>
                        <div class="form-group">
                            <label>🔗 URL <span class="required">*</span></label>
                            <input type="text" id="researchUrl" class="form-input" placeholder="https://www.facebook.com/groups/... hoặc /profile/...">
                        </div>
                    </div>
                    <div class="form-row">
                        <div class="form-group">
                            <label>📝 Tên văn phong</label>
                            <input type="text" id="researchStyleName" class="form-input" placeholder="VD: Văn phong từ Group Skincare">
                        </div>
                        <div class="form-group">
                            <label>📊 Số bài crawl</label>
                            <select id="researchMaxPosts" class="form-input">
                                <option value="10">10 bài (nhanh)</option>
                                <option value="20" selected>20 bài (khuyến nghị)</option>
                                <option value="50">50 bài (chính xác hơn)</option>
                            </select>
                        </div>
                    </div>

                    <!-- Hiển thị groups đã cache -->
                    <% if (groupCaches && groupCaches.length > 0) { %>
                    <div class="form-group">
                        <label>📋 Hoặc chọn từ Group đã lưu:</label>
                        <div style="display:flex;flex-wrap:wrap;gap:8px;margin-top:8px;">
                            <% groupCaches.forEach(gc => { %>
                            <% (gc.groups || []).slice(0, 10).forEach(g => { %>
                            <button type="button" class="btn-sm btn-view" onclick="selectGroupUrl('<%= g.groupUrl || '' %>')" style="font-size:11px;">
                                <i class="fa-solid fa-users"></i> <%= (g.groupName || '').substring(0, 30) %>
                            </button>
                            <% }); %>
                            <% }); %>
                        </div>
                    </div>
                    <% } %>

                    <div style="display:flex;gap:10px;margin-top:8px;">
                        <button class="btn-primary" id="btnStartResearch" onclick="startResearch()">
                            <i class="fa-solid fa-brain"></i> Bắt đầu học
                        </button>
                        <button class="btn-secondary" onclick="document.getElementById('researchSection').style.display='none'">Đóng</button>
                    </div>
                    <div id="researchProgress" style="display:none;margin-top:16px;">
                        <div style="display:flex;align-items:center;gap:10px;">
                            <div class="btn-loading" style="width:20px;height:20px;"></div>
                            <span id="researchProgressText" style="font-size:13px;color:var(--text-muted);">Đang crawl bài viết...</span>
                        </div>
                    </div>
                </div>
            </div>

            <% if (styles.length === 0) { %>
            <div class="ai-content-empty">
                <i class="fa-solid fa-palette"></i>
                <h3>Chưa có văn phong nào</h3>
                <p>Tạo văn phong mẫu để AI học cách viết bài theo phong cách của bạn.</p>
            </div>
            <% } else { %>
            <div class="ai-content-grid">
                <% styles.forEach(function(style) { %>
                <div class="ai-style-card" data-id="<%= style._id %>">
                    <div class="ai-style-header">
                        <div class="ai-style-icon"><i class="fa-solid fa-pen-fancy"></i></div>
                        <div class="ai-style-info">
                            <h3><%= style.name %></h3>
                            <span class="ai-style-meta">
                                <%= style.sampleArticles.length %> bài mẫu • <%= (style.topics || []).length %> chủ đề
                                <% if (style.trainingVersion > 0) { %>
                                • <span style="color:var(--success);font-weight:600;">v<%= style.trainingVersion %></span>
                                <% } %>
                            </span>
                        </div>
                        <div class="ai-style-actions">
                            <button class="btn-sm btn-analyze" onclick="analyzeStyle('<%= style._id %>')" title="Phân tích AI"><i class="fa-solid fa-magnifying-glass-chart"></i></button>
                            <% if (style.trainingVersion > 0) { %>
                            <button class="btn-sm btn-retrain" onclick="retrainStyle('<%= style._id %>')" title="Train lại từ bài tốt nhất"><i class="fa-solid fa-brain"></i></button>
                            <% } %>
                            <button class="btn-sm btn-edit" onclick="editStyle('<%= style._id %>')" title="Sửa"><i class="fa-solid fa-pen"></i> Sửa</button>
                            <button class="btn-sm btn-delete" onclick="deleteStyle('<%= style._id %>')" title="Xóa"><i class="fa-solid fa-trash"></i> Xóa</button>
                        </div>
                    </div>
                    <% if (style.styleAnalysis && style.styleAnalysis.tone) { %>
                    <div class="ai-style-analysis">
                        <div class="analysis-tag"><i class="fa-solid fa-comment"></i> <%= style.styleAnalysis.tone %></div>
                        <div class="analysis-tag"><i class="fa-solid fa-font"></i> <%= style.styleAnalysis.vocabulary %></div>
                        <% if (style.styleAnalysis.keywords && style.styleAnalysis.keywords.length) { %>
                        <div class="analysis-keywords">
                            <% style.styleAnalysis.keywords.slice(0, 5).forEach(function(kw) { %>
                            <span class="keyword-tag"><%= kw %></span>
                            <% }); %>
                        </div>
                        <% } %>
                        <p class="analysis-summary"><%= style.styleAnalysis.summary %></p>
                    </div>
                    <% } else { %>
                    <div class="ai-style-no-analysis">
                        <i class="fa-solid fa-exclamation-circle"></i> Chưa phân tích. Nhấn nút phân tích để AI học văn phong.
                    </div>
                    <% } %>
                </div>
                <% }); %>
            </div>
            <% } %>
        </div>

        <!-- Tab: Lịch Nội Dung -->
        <div class="ai-tab-content" id="tab-schedules">
            <div class="ai-content-section-header">
                <h2><i class="fa-solid fa-calendar"></i> Lịch Tạo Nội Dung</h2>
            <button class="btn-primary" id="btnNewSchedule" <%= styles.length === 0 ? 'disabled title="Cần tạo văn phong trước"' : '' %>><i class="fa-solid fa-plus"></i> Tạo Lịch & Tạo Bài Ngay</button>
            </div>

            <% if (schedules.length === 0) { %>
            <div class="ai-content-empty">
                <i class="fa-solid fa-calendar"></i>
                <h3>Chưa có lịch nào</h3>
                <p>Tạo lịch để AI tự động tạo bài viết theo khoảng ngày và khung giờ bạn thiết lập.</p>
            </div>
            <% } else { %>
            <div class="ai-content-list">
                <% schedules.forEach(function(sch) { %>
                <div class="ai-schedule-card" data-id="<%= sch._id %>">
                    <div class="ai-schedule-header">
                        <div class="ai-schedule-icon <%= sch.status === 'active' ? 'active' : sch.status === 'completed' ? 'completed' : '' %>">
                            <i class="fa-solid <%= sch.status === 'active' ? 'fa-play-circle' : sch.status === 'completed' ? 'fa-check-circle' : sch.status === 'paused' ? 'fa-pause-circle' : 'fa-edit' %>"></i>
                        </div>
                        <div class="ai-schedule-info">
                            <h3><%= sch.name %></h3>
                            <span class="ai-schedule-meta">
                                <i class="fa-solid fa-palette"></i> <%= sch.writingStyleId?.name || 'N/A' %> •
                                <span class="status-badge status-<%= sch.status %>"><%= sch.status %></span>
                            </span>
                        </div>
                        <div class="ai-schedule-actions">
                            <% if (sch.status === 'active' || sch.status === 'draft') { %>
                            <button class="btn-sm btn-generate" onclick="generateNow(this)" data-id="<%= sch._id %>" title="Tạo bài ngay"><i class="fa-solid fa-wand-magic-sparkles"></i> Tạo bài</button>
                            <% } %>
                            <button class="btn-sm btn-edit" onclick="openEditScheduleWizard('<%= sch._id %>')" title="Sửa"><i class="fa-solid fa-pen"></i> Sửa</button>
                            <button class="btn-sm btn-delete" onclick="deleteSchedule('<%= sch._id %>')" title="Xóa"><i class="fa-solid fa-trash"></i> Xóa</button>
                        </div>
                    </div>
                    <div class="ai-schedule-details">
                        <div class="schedule-detail"><i class="fa-solid fa-calendar-days"></i> <%= new Date(sch.dateRange.startDate).toLocaleDateString('vi-VN') %> - <%= new Date(sch.dateRange.endDate).toLocaleDateString('vi-VN') %></div>
                        <div class="schedule-detail"><i class="fa-solid fa-clock"></i> <%= (sch.timeSlots || []).map(function(s){ return (s.hour<10?'0':'')+s.hour+':'+(s.minute<10?'0':'')+s.minute; }).join(', ') || 'N/A' %></div>
                        <div class="schedule-detail"><i class="fa-solid fa-file-lines"></i> Đã tạo: <%= sch.postsGenerated || 0 %> bài</div>
                        <div class="schedule-detail"><i class="fa-solid fa-hashtag"></i> Chủ đề: <%= (sch.contentConfig?.topics || []).join(', ') || 'Chung' %></div>
                    </div>
                </div>
                <% }); %>
            </div>
            <% } %>
        </div>

        <!-- Tab: Sản Phẩm -->
        <div class="ai-tab-content" id="tab-products">
            <div class="ai-content-section-header">
                <h2><i class="fa-solid fa-box"></i> Sản Phẩm</h2>
                <button class="btn-primary" id="btnNewProduct"><i class="fa-solid fa-plus"></i> Thêm Sản Phẩm</button>
            </div>

            <div class="ai-content-empty" id="emptyProducts" style="<% if (products && products.length > 0) { %>display:none<% } %>">
                <i class="fa-solid fa-box"></i>
                <h3>Chưa có sản phẩm nào</h3>
                <p>Thêm sản phẩm để AI tự động tạo nội dung quảng cáo / bán hàng thông minh.</p>
            </div>

            <div class="ai-content-grid" id="productsList" <% if (!products || products.length === 0) { %>style="display:none"<% } %>>
                <% (products || []).forEach(function(p) { %>
                <div class="ai-style-card product-card" data-id="<%= p._id %>">
                    <div class="ai-style-header">
                        <div class="ai-style-icon"><i class="fa-solid fa-box"></i></div>
                        <div class="ai-style-info">
                            <h3><%= p.name %></h3>
                            <span class="ai-style-meta">
                                <%= p.category || 'Chưa phân loại' %>
                                <% if (p.price) { %> • <%= p.price %>đ<% } %>
                                <% if (p.aiAnalysis && p.aiAnalysis.suggestedDirection) { %>
                                • <span class="direction-badge direction-<%= p.aiAnalysis.suggestedDirection %>"><%= p.aiAnalysis.suggestedDirection === 'advertising' ? 'Quảng cáo' : p.aiAnalysis.suggestedDirection === 'purchase' ? 'Mua hàng' : 'Kết hợp' %></span>
                                <% } %>
                            </span>
                        </div>
                        <div class="ai-style-actions">
                            <button class="btn-sm btn-analyze" onclick="analyzeProductAI('<%= p._id %>')" title="Phân tích AI"><i class="fa-solid fa-magnifying-glass-chart"></i></button>
                            <button class="btn-sm btn-edit" onclick="editProduct('<%= p._id %>')" title="Sửa"><i class="fa-solid fa-pen"></i> Sửa</button>
                            <button class="btn-sm btn-delete" onclick="deleteProduct('<%= p._id %>')" title="Xóa"><i class="fa-solid fa-trash"></i> Xóa</button>
                        </div>
                    </div>
                    <% if (p.description) { %>
                    <p style="padding:0 15px 5px;color:var(--text-secondary);font-size:13px;"><%= p.description.substring(0, 120) %><%= p.description.length > 120 ? '...' : '' %></p>
                    <% } %>
                    <% if (p.aiAnalysis) { %>
                    <div class="ai-style-analysis">
                        <div class="analysis-tag"><i class="fa-solid fa-lightbulb"></i> <%= p.aiAnalysis.summary || 'Đã phân tích' %></div>
                        <% if (p.aiAnalysis.recommendedAngles && p.aiAnalysis.recommendedAngles.length) { %>
                        <div class="analysis-keywords" style="margin-top:6px;">
                            <% p.aiAnalysis.recommendedAngles.slice(0, 3).forEach(function(angle) { %>
                            <span class="keyword-tag"><%= angle %></span>
                            <% }); %>
                        </div>
                        <% } %>
                    </div>
                    <% } else { %>
                    <div class="ai-style-no-analysis">
                        <i class="fa-solid fa-exclamation-circle"></i> Chưa phân tích. Nhấn nút phân tích để AI đề xuất hướng nội dung.
                    </div>
                    <% } %>
                </div>
                <% }); %>
            </div>
        </div>

        <!-- Tab: Bài Viết AI -->
        <div class="ai-tab-content" id="tab-posts">
            <div class="ai-content-section-header">
                <h2><i class="fa-solid fa-newspaper"></i> Bài Viết Đã Tạo</h2>
                <div class="ai-content-filter">
                    <select id="filterSchedule" onchange="filterPosts()">
                        <option value="">Tất cả lịch</option>
                        <% schedules.forEach(function(s) { %>
                        <option value="<%= s._id %>"><%= s.name %></option>
                        <% }); %>
                    </select>
                    <select id="filterStatus" onchange="filterPosts()">
                        <option value="">Tất cả trạng thái</option>
                        <option value="draft">Draft</option>
                        <option value="pending">Chờ đăng</option>
                        <option value="posted">Đã đăng</option>
                        <option value="failed">Thất bại</option>
                    </select>
                </div>
            </div>

            <% if (posts.length === 0) { %>
            <div class="ai-content-empty">
                <i class="fa-solid fa-newspaper"></i>
                <h3>Chưa có bài viết nào</h3>
                <p>Bài viết sẽ xuất hiện ở đây sau khi AI tạo xong.</p>
            </div>
            <% } else { %>
            <div class="ai-posts-list" id="postsList">
                <% posts.forEach(function(post) { %>
                <div class="ai-post-card" data-id="<%= post._id %>" data-schedule-id="<%= post.scheduleId?._id || post.scheduleId || '' %>" data-status="<%= post.status %>">
                    <div class="ai-post-header">
                        <div class="ai-post-status status-<%= post.status %>"><%= post.status %></div>
                        <div class="ai-post-date"><%= new Date(post.scheduledAt).toLocaleString('vi-VN') %></div>
                    </div>
                    <h3 class="ai-post-title"><%= post.title || '(Không tiêu đề)' %></h3>
                    <p class="ai-post-content-preview"><%= (post.content || '').substring(0, 200) %><%= post.content.length > 200 ? '...' : '' %></p>
                    <div class="ai-post-meta">
                        <span><i class="fa-solid fa-calendar"></i> <%= post.scheduleId?.name || 'N/A' %></span>
                        <span><i class="fa-solid fa-globe"></i> <%= (post.platforms || []).join(', ') || 'N/A' %></span>
                    </div>
                    <div class="ai-post-actions">
                        <button class="btn-sm btn-view" onclick="viewPost('<%= post._id %>')"><i class="fa-solid fa-eye"></i> Xem</button>
                        <button class="btn-sm btn-edit" onclick="editPost('<%= post._id %>')"><i class="fa-solid fa-pen"></i> Sửa</button>
                        <% if (post.status === 'draft') { %>
                        <button class="btn-sm btn-publish" onclick="publishPost('<%= post._id %>')"><i class="fa-solid fa-paper-plane"></i> Đăng</button>
                        <% } %>
                        <button class="btn-sm btn-delete" onclick="deletePost('<%= post._id %>')"><i class="fa-solid fa-trash"></i></button>
                    </div>
                </div>
                <% }); %>
            </div>
            <% } %>
        </div>

        <!-- Tab: Auto Pipeline -->
        <div class="ai-tab-content" id="tab-autopipeline">
            <div class="ai-content-section-header">
                <h2><i class="fa-solid fa-robot"></i> Auto Content Pipeline</h2>
                <button class="btn-primary" id="btnNewPipeline"><i class="fa-solid fa-plus"></i> Tạo Pipeline Mới</button>
            <script>document.getElementById('btnNewPipeline').onclick = () => window.openWizard({ mode: 'new-pipeline', purpose: 'product' });</script>
            </div>

            <div id="pipelinesList">
                <% if (pipelines && pipelines.length > 0) { %>
                    <div class="ai-content-list">
                        <% pipelines.forEach(pipeline => { %>
                            <div class="ai-schedule-card" data-id="<%= pipeline._id %>">
                                <div class="ai-schedule-header">
                                    <div class="ai-schedule-icon <%= pipeline.status %>">
                                        <i class="fa-solid fa-<%= pipeline.status === 'active' ? 'play' : 'pause' %>"></i>
                                    </div>
                                    <div class="ai-schedule-info">
                                        <h3><%= pipeline.productId?.name || 'Sản phẩm' %></h3>
                                        <div class="ai-schedule-meta">
                                            <span class="status-badge status-<%= pipeline.status %>">
                                                <%= pipeline.status === 'active' ? 'ĐANG CHẠY' : 'TẠM DỪNG' %>
                                            </span>
                                            <span><%= pipeline.postsPerDay %> bài/ngày</span>
                                            <span>•</span>
                                            <span><%= (pipeline.platforms || []).join(', ') %></span>
                                        </div>
                                    </div>
                                    <div class="ai-schedule-actions">
                                        <button class="btn-sm btn-analyze" onclick="runPipelineNow('<%= pipeline._id %>')" title="Chạy ngay">
                                            <i class="fa-solid fa-play"></i> Chạy
                                        </button>
                                        <button class="btn-sm btn-edit" onclick="togglePipeline('<%= pipeline._id %>')" title="Bật/Tắt">
                                            <i class="fa-solid fa-power-off"></i>
                                        </button>
                                        <button class="btn-sm btn-edit" onclick="openEditPipelineWizard('<%= pipeline._id %>')" title="Sửa">
                                            <i class="fa-solid fa-pen"></i> Sửa
                                        </button>
                                        <button class="btn-sm btn-delete" onclick="deletePipeline('<%= pipeline._id %>')" title="Xóa">
                                            <i class="fa-solid fa-trash"></i>
                                        </button>
                                    </div>
                                </div>
                                <div class="ai-schedule-details">
                                    <div class="schedule-detail">
                                        <i class="fa-solid fa-box"></i>
                                        <span><%= pipeline.productId?.name || 'N/A' %></span>
                                    </div>
                                    <div class="schedule-detail">
                                        <i class="fa-solid fa-clock"></i>
                                        <span><%= (pipeline.timeSlots || []).map(s => s.hour + ':' + String(s.minute || 0).padStart(2, '0')).join(', ') %></span>
                                    </div>
                                    <div class="schedule-detail">
                                        <i class="fa-solid fa-bullseye"></i>
                                        <span><%= pipeline.contentDirection === 'advertising' ? 'Quảng cáo' : pipeline.contentDirection === 'purchase' ? 'Mua hàng' : 'Kết hợp' %></span>
                                    </div>
                                    <div class="schedule-detail">
                                        <i class="fa-solid fa-chart-line"></i>
                                        <span><%= pipeline.totalPosts %> bài đã tạo</span>
                                    </div>
                                    <div class="schedule-detail">
                                        <i class="fa-solid fa-clock-rotate-left"></i>
                                        <span><%= pipeline.lastRunAt ? new Date(pipeline.lastRunAt).toLocaleString('vi-VN') : 'Chưa chạy' %></span>
                                    </div>
                                </div>
                            </div>
                        <% }); %>
                    </div>
                <% } else { %>
                    <div class="ai-content-empty">
                        <i class="fa-solid fa-robot"></i>
                        <h3>Chưa có Pipeline nào</h3>
                        <p>Tạo pipeline mới để tự động tạo và đăng bài viết hàng ngày theo sản phẩm</p>
                    </div>
                <% } %>
            </div>
        </div>
    </div>
</div>

