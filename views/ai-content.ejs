<script>
    // Bridge: nút "Sửa" cũ trên schedule/pipeline card → mở wizard edit-mode
    function openEditScheduleWizard(id) {
        if (typeof window.openWizard === 'function') {
            window.openWizard({ mode: 'edit-schedule', scheduleId: id });
        } else {
            console.warn('Wizard chưa load, fallback về editSchedule() cũ');
            if (typeof editSchedule === 'function') editSchedule(id);
        }
    }
    function openEditPipelineWizard(id) {
        if (typeof window.openWizard === 'function') {
            window.openWizard({ mode: 'edit-pipeline', pipelineId: id });
        } else {
            console.warn('Wizard chưa load');
        }
    }
</script>

