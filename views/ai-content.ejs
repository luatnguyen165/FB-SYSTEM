<script>
// ===== Research Functions =====
document.getElementById('btnResearchStyle')?.addEventListener('click', function() {
    const section = document.getElementById('researchSection');
    section.style.display = section.style.display === 'none' ? 'block' : 'none';
});

function selectGroupUrl(url) {
    if (url) {
        document.getElementById('researchUrl').value = url;
        document.getElementById('researchType').value = 'group';
    }
}

async function startResearch() {
    const type = document.getElementById('researchType').value;
    const url = document.getElementById('researchUrl').value.trim();
    const styleName = document.getElementById('researchStyleName').value.trim();
    const maxPosts = document.getElementById('researchMaxPosts').value;

    if (!url) {
        showToast('Vui lòng nhập URL', 'error');
        return;
    }

    // Show progress
    document.getElementById('researchProgress').style.display = 'block';
    document.getElementById('btnStartResearch').disabled = true;
    document.getElementById('researchProgressText').textContent = 'Đang crawl bài viết từ ' + (type === 'group' ? 'group' : 'profile') + '...';

    try {
        const res = await fetch('/ai-content/api/research', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ type, url, styleName, maxPosts: parseInt(maxPosts) }),
        });
        const data = await res.json();

        if (data.success) {
            document.getElementById('researchProgressText').innerHTML =
                `<span style="color:var(--success);font-weight:600;">✅ ${data.message}</span>`;
            showToast(data.message, 'success');
            setTimeout(() => location.reload(), 2000);
        } else {
            document.getElementById('researchProgressText').innerHTML =
                `<span style="color:var(--danger);font-weight:600;">❌ ${data.error}</span>`;
            showToast(data.error || 'Lỗi research', 'error');
        }
    } catch (err) {
        document.getElementById('researchProgressText').innerHTML =
            `<span style="color:var(--danger);font-weight:600;">❌ Lỗi: ${err.message}</span>`;
        showToast('Lỗi: ' + err.message, 'error');
    } finally {
        document.getElementById('btnStartResearch').disabled = false;
    }
}

// ===== Auto Pipeline Functions =====
(function() {
    const products = window.__productsData || [];
    const styles = window.__stylesData || [];
    const channels = window.__channelsData || [];
    const pipelines = window.__pipelinesData || [];

    // Open modal
    document.getElementById('btnNewPipeline')?.addEventListener('click', openPipelineModal);

    function openPipelineModal() {
        // Populate products
        const sel = document.getElementById('pipelineProductSelect');
        sel.innerHTML = '<option value="">-- Chọn sản phẩm --</option>';
        products.forEach(p => {
            sel.innerHTML += `<option value="${p._id}">${p.name} (${p.category || 'N/A'})</option>`;
        });

        // Populate styles
        const styleSel = document.getElementById('pipelineStyleSelect');
        styleSel.innerHTML = '<option value="">-- Mặc định --</option>';
        styles.forEach(s => {
            styleSel.innerHTML += `<option value="${s._id}">${s.name}</option>`;
        });

        // Populate platforms
        const platformsDiv = document.getElementById('pipelinePlatforms');
        platformsDiv.innerHTML = '';
        [{v:'FB',i:'facebook',l:'Facebook'},{v:'TT',i:'tiktok',l:'TikTok'},{v:'IG',i:'instagram',l:'Instagram'}].forEach(p => {
            platformsDiv.innerHTML += `
                <label class="platform-chip" data-platform="${p.v}">
                    <input type="checkbox" name="platforms" value="${p.v}" ${p.v==='FB'?'checked':''}>
                    <i class="fa-brands fa-${p.i}"></i>
                    <span>${p.l}</span>
                    <span class="platform-chip__check"><i class="fa-solid fa-check"></i></span>
                </label>`;
        });

        // Populate accounts
        const accDiv = document.getElementById('pipelineAccounts');
        accDiv.innerHTML = '';
        if (channels.length === 0) {
            accDiv.innerHTML = '<div class="schedule-accounts-empty"><i class="fa-solid fa-link"></i> Chưa có tài khoản. <a href="/channels">Thêm ngay</a></div>';
        } else {
            channels.forEach(ch => {
                const icon = ch.platform==='FB'?'facebook':ch.platform==='TT'?'tiktok':'instagram';
                accDiv.innerHTML += `
                    <label class="schedule-account-item">
                        <input type="checkbox" name="accountIds" value="${ch._id}">
                        <div class="schedule-account-avatar"><i class="fa-brands fa-${icon}"></i></div>
                        <div class="schedule-account-info">
                            <span class="schedule-account-name">${ch.accountName}</span>
                            <span class="schedule-account-type">[${ch.platform}] ${ch.accountType}</span>
                        </div>
                        <span class="schedule-account-check"><i class="fa-solid fa-check"></i></span>
                    </label>`;
            });
        }

        document.getElementById('pipelineModal').style.display = 'flex';
    }

    window.closePipelineModal = function() {
        document.getElementById('pipelineModal').style.display = 'none';
    };

    window.submitPipeline = async function() {
        const form = document.getElementById('pipelineForm');
        const fd = new FormData(form);
        const platforms = fd.getAll('platforms');
        if (!fd.get('productId')) return showToast('Vui lòng chọn sản phẩm', 'error');
        if (platforms.length === 0) return showToast('Vui lòng chọn ít nhất 1 nền tảng', 'error');

        const accountIds = fd.getAll('accountIds');
        const groupIds = (fd.get('groupIds')||'').split('\n').map(s=>s.trim()).filter(Boolean);
        const timeSlots = [];
        for (let i=0;i<2;i++) {
            const h=parseInt(fd.get(`slot_hour_${i}`)), m=parseInt(fd.get(`slot_minute_${i}`));
            if(!isNaN(h)) timeSlots.push({hour:h,minute:m||0});
        }

        try {
            const res = await fetch('/ai-content/api/pipelines', {
                method:'POST', headers:{'Content-Type':'application/json'},
                body: JSON.stringify({
                    productId:fd.get('productId'), writingStyleId:fd.get('writingStyleId')||null,
                    postsPerDay:parseInt(fd.get('postsPerDay'))||2, platforms, accountIds, groupIds,
                    timeSlots, contentDirection:fd.get('contentDirection')||'mixed'
                })
            });
            const data = await res.json();
            if(data.success) { showToast('Tạo pipeline thành công!','success'); closePipelineModal(); setTimeout(()=>location.reload(),1000); }
            else showToast(data.error||'Lỗi','error');
        } catch(e) { showToast('Lỗi: '+e.message,'error'); }
    };

    window.runPipelineNow = async function(id) {
        if (!(await showConfirm('Chạy pipeline ngay? Sẽ tạo bài viết mới.'))) return;
        try {
            showToast('Đang tạo bài viết...','info');
            const res = await fetch(`/ai-content/api/pipelines/${id}/run`,{method:'POST'});
            const data = await res.json();
            if(data.success) { showToast(data.message,'success'); setTimeout(()=>location.reload(),2000); }
            else showToast(data.error||'Lỗi','error');
        } catch(e) { showToast('Lỗi: '+e.message,'error'); }
    };

    window.togglePipeline = async function(id) {
        try {
            const res = await fetch(`/ai-content/api/pipelines/${id}/toggle`,{method:'POST'});
            const data = await res.json();
            if(data.success) { showToast(data.message,'success'); setTimeout(()=>location.reload(),1000); }
            else showToast(data.error||'Lỗi','error');
        } catch(e) { showToast('Lỗi: '+e.message,'error'); }
    };

    window.deletePipeline = async function(id) {
        if (!(await showConfirm('Xóa pipeline này?'))) return;
        try {
            const res = await fetch(`/ai-content/api/pipelines/${id}`,{method:'DELETE'});
            const data = await res.json();
            if(data.success) { showToast('Đã xóa','success'); setTimeout(()=>location.reload(),1000); }
            else showToast(data.error||'Lỗi','error');
        } catch(e) { showToast('Lỗi: '+e.message,'error'); }
    };

    // Close on overlay click
    document.getElementById('pipelineModal')?.addEventListener('click', function(e) {
        if(e.target===this) closePipelineModal();
    });
})();
</script>
</body>
</html>