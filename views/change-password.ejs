<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="UTF-8">
    <title>Đổi Mật Khẩu - ReelsFlow AI</title>
    <link rel="stylesheet" href="/css/base.css">
    <link rel="stylesheet" href="/css/style.css">
    <link rel="stylesheet" href="/css/profile.css">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
</head>
<body data-flash-message='<%- typeof flash !== "undefined" && flash ? JSON.stringify(flash.message) : "" %>' data-flash-type="<%= typeof flash !== 'undefined' && flash ? (flash.type === 'success' ? 'success' : flash.type === 'warning' ? 'warning' : 'error') : '' %>">
<%- include('partials/sidebar', { currentPage: 'change-password' }) %>
    <div class="main-content">
        <%- include('partials/header') %>
        <div class="content-body">
            <div class="container">
                <%- include('partials/welcome-section', {
                    eyebrow: 'Bảo mật tài khoản',
                    title: 'Đổi mật khẩu tài khoản',
                    description: 'Thay đổi mật khẩu định kỳ để tăng cường bảo mật và giữ an toàn cho dữ liệu hệ thống.'
                }) %>
                <div class="page-layout">
                    <nav class="settings-nav">
                        <a href="/auth/profile" class="nav-item">
                            <i class="fa-regular fa-user"></i> Hồ sơ cá nhân
                        </a>
                        <a href="/auth/change-password" class="nav-item active">
                            <i class="fa-solid fa-key"></i> Đổi mật khẩu
                        </a>
                    </nav>
                    <div class="card-form">
                        <h2 class="section-title">Đổi mật khẩu bảo mật</h2>
                        <p class="section-desc">Vui lòng sử dụng mật khẩu mạnh gồm chữ hoa, chữ thường, số và ký tự đặc biệt để đảm bảo an toàn cho tài khoản.</p>

                        <form id="resetForm" method="post" action="/auth/change-password" novalidate>
                            <div class="form-group">
                                <label>MẬT KHẨU HIỆN TẠI</label>
                                <div class="password-field-wrapper">
                                    <input type="password" class="input" name="currentPassword" id="currentPassword" placeholder="Nhập mật khẩu hiện tại" required autocomplete="current-password">
                                    <button type="button" class="password-toggle-btn" data-toggle="currentPassword" aria-label="Hiện mật khẩu">
                                        <i class="fa-regular fa-eye"></i>
                                    </button>
                                </div>
                            </div>

                            <div class="section-divider"></div>

                            <div class="form-group">
                                <label>MẬT KHẨU MỚI</label>
                                <div class="password-field-wrapper">
                                    <input type="password" class="input" name="newPassword" id="newPassword" placeholder="Tối thiểu 8 ký tự" minlength="8" required autocomplete="new-password">
                                    <button type="button" class="password-toggle-btn" data-toggle="newPassword" aria-label="Hiện mật khẩu">
                                        <i class="fa-regular fa-eye"></i>
                                    </button>
                                </div>
                                <div class="password-strength-wrapper" id="strengthWrapper" style="display:none">
                                    <div class="strength-bar-track">
                                        <div class="strength-bar-fill" id="strengthBar"></div>
                                    </div>
                                    <div class="strength-label" id="strengthLabel">
                                        <span id="strengthText">Nhập mật khẩu mới</span>
                                        <span class="hint" id="strengthHint"></span>
                                    </div>
                                </div>
                            </div>

                            <div class="password-requirements" id="passwordRequirements">
                                <div class="requirement-item" id="req-length">
                                    <i class="fa-solid fa-circle"></i>
                                    <span>Tối thiểu 8 ký tự</span>
                                </div>
                                <div class="requirement-item" id="req-upper">
                                    <i class="fa-solid fa-circle"></i>
                                    <span>Ít nhất 1 chữ hoa</span>
                                </div>
                                <div class="requirement-item" id="req-lower">
                                    <i class="fa-solid fa-circle"></i>
                                    <span>Ít nhất 1 chữ thường</span>
                                </div>
                                <div class="requirement-item" id="req-number">
                                    <i class="fa-solid fa-circle"></i>
                                    <span>Ít nhất 1 chữ số</span>
                                </div>
                            </div>

                            <div class="form-group" style="margin-top:20px">
                                <label>XÁC NHẬN MẬT KHẨU MỚI</label>
                                <div class="password-field-wrapper">
                                    <input type="password" class="input" name="confirmPassword" id="confirmPassword" placeholder="Nhập lại mật khẩu mới" minlength="8" required autocomplete="new-password">
                                    <button type="button" class="password-toggle-btn" data-toggle="confirmPassword" aria-label="Hiện mật khẩu">
                                        <i class="fa-regular fa-eye"></i>
                                    </button>
                                </div>
                                <div class="field-validation-msg" id="confirmFeedback">
                                    <i class="fa-solid fa-circle-check"></i>
                                    <span></span>
                                </div>
                            </div>

                            <div class="form-action-row">
                                <button type="submit" class="btn-save" id="btnSubmitPassword">
                                    <i class="fa-solid fa-shield-halved"></i> Cập nhật mật khẩu
                                </button>
                            </div>
                        </form>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <script src="/js/toast.js"></script>
    <script src="/js/base.js"></script>
    <script src="/js/utils.js"></script>
    <script>
    (function () {
        const message = document.body.dataset.flashMessage;
        const type = document.body.dataset.flashType;
        if (message) showToast(message, type || 'info');
    })();

    (function () {
        /* ----- Password Toggle ----- */
        document.querySelectorAll('.password-toggle-btn[data-toggle]').forEach(btn => {
            btn.addEventListener('click', () => {
                const input = document.getElementById(btn.dataset.toggle);
                if (!input) return;
                const isPassword = input.type === 'password';
                input.type = isPassword ? 'text' : 'password';
                btn.querySelector('i').className = isPassword ? 'fa-regular fa-eye-slash' : 'fa-regular fa-eye';
                btn.setAttribute('aria-label', isPassword ? 'Ẩn mật khẩu' : 'Hiện mật khẩu');
            });
        });

        /* ----- Password Strength Meter ----- */
        const newPassInput = document.getElementById('newPassword');
        const confirmPassInput = document.getElementById('confirmPassword');
        const strengthWrapper = document.getElementById('strengthWrapper');
        const strengthBar = document.getElementById('strengthBar');
        const strengthLabel = document.getElementById('strengthLabel');
        const strengthText = document.getElementById('strengthText');
        const strengthHint = document.getElementById('strengthHint');
        const confirmFeedback = document.getElementById('confirmFeedback');

        const requirements = {
            length: document.getElementById('req-length'),
            upper: document.getElementById('req-upper'),
            lower: document.getElementById('req-lower'),
            number: document.getElementById('req-number')
        };

        function updateRequirement(el, met) {
            if (!el) return;
            el.classList.toggle('met', met);
            el.querySelector('i').className = met ? 'fa-solid fa-circle-check' : 'fa-solid fa-circle';
        }

        function getStrength(password) {
            let score = 0;
            if (!password) return 0;
            if (password.length >= 8) score++;
            if (password.length >= 12) score++;
            if (/[A-Z]/.test(password)) score++;
            if (/[a-z]/.test(password)) score++;
            if (/[0-9]/.test(password)) score++;
            if (/[^A-Za-z0-9]/.test(password)) score++;
            return score;
        }

        function updateStrength(password) {
            const score = getStrength(password);
            const pct = Math.min(100, Math.round(score / 6 * 100));

            strengthBar.style.width = pct + '%';
            strengthBar.className = 'strength-bar-fill';
            strengthLabel.className = 'strength-label';

            if (password.length === 0) {
                strengthBar.style.width = '0%';
                strengthText.textContent = 'Nhập mật khẩu mới';
                strengthHint.textContent = '';
            } else if (score <= 2) {
                strengthBar.classList.add('weak');
                strengthLabel.classList.add('weak');
                strengthText.textContent = 'Yếu';
                strengthHint.textContent = 'Dễ bị đoán';
            } else if (score <= 4) {
                strengthBar.classList.add('medium');
                strengthLabel.classList.add('medium');
                strengthText.textContent = 'Trung bình';
                strengthHint.textContent = 'Có thể cải thiện';
            } else {
                strengthBar.classList.add('strong');
                strengthLabel.classList.add('strong');
                strengthText.textContent = 'Mạnh';
                strengthHint.textContent = 'Mật khẩu tốt';
            }
        }

        function updateConfirmFeedback() {
            const pass = newPassInput?.value || '';
            const confirm = confirmPassInput?.value || '';

            if (!confirm) {
                confirmFeedback.classList.remove('visible', 'success', 'error');
                return;
            }

            confirmFeedback.classList.add('visible');
            if (pass === confirm) {
                confirmFeedback.className = 'field-validation-msg visible success';
                confirmFeedback.innerHTML = '<i class="fa-solid fa-circle-check"></i><span>Mật khẩu khớp nhau</span>';
            } else {
                confirmFeedback.className = 'field-validation-msg visible error';
                confirmFeedback.innerHTML = '<i class="fa-solid fa-circle-xmark"></i><span>Mật khẩu không khớp</span>';
            }
        }

        if (newPassInput) {
            newPassInput.addEventListener('input', () => {
                const val = newPassInput.value;
                strengthWrapper.style.display = val ? 'block' : 'none';
                updateRequirement(requirements.length, val.length >= 8);
                updateRequirement(requirements.upper, /[A-Z]/.test(val));
                updateRequirement(requirements.lower, /[a-z]/.test(val));
                updateRequirement(requirements.number, /[0-9]/.test(val));
                updateStrength(val);
                updateConfirmFeedback();
            });
        }

        if (confirmPassInput) {
            confirmPassInput.addEventListener('input', updateConfirmFeedback);
        }

        /* ----- Form Submit with Loading State ----- */
        const resetForm = document.getElementById('resetForm');
        const submitBtn = document.getElementById('btnSubmitPassword');

        if (resetForm && submitBtn) {
            resetForm.addEventListener('submit', () => {
                const orig = submitBtn.innerHTML;
                submitBtn.disabled = true;
                submitBtn.innerHTML = '<i class="fa-solid fa-spinner fa-spin"></i> Đang xử lý...';
                setTimeout(() => {
                    if (submitBtn.disabled) {
                        submitBtn.disabled = false;
                        submitBtn.innerHTML = orig;
                    }
                }, 15000);
            });
        }
    })();
    </script>
</body>
</html>
