<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Tài Khoản <%= platformLabel %> - ReelsFlow AI</title>
    <link rel="stylesheet" href="/css/base.css">
    <link rel="stylesheet" href="/css/style.css">
    <link rel="stylesheet" href="/css/channels.css">
    <link rel="stylesheet" href="/css/toast.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
</head>
<body>

    <%- include('partials/sidebar', { currentPage: 'channels', activePlatform, availablePlatforms }) %>

    <div class="main-content">
        <%- include('partials/header') %>

        <div class="content-body">

            <!-- Platform Hero Header -->
            <div class="platform-hero platform-hero--<%= activePlatform.toLowerCase() %>">
                <div class="platform-hero__bg"></div>
                <div class="platform-hero__content">
                    <div class="platform-hero__icon">
                        <i class="<%= activePlatform === 'ZO' ? 'fa-solid fa-message' : 'fa-brands fa-' + (activePlatform === 'FB' ? 'facebook' : activePlatform === 'TT' ? 'tiktok' : activePlatform === 'IG' ? 'instagram' : 'youtube') %>"></i>
                    </div>
                    <div class="platform-hero__info">
                        <h1 class="platform-hero__title"><%= platformLabel %></h1>
                        <p class="platform-hero__subtitle">Quản lý tài khoản kết nối</p>
                    </div>
                    <div class="platform-hero__stats">
                        <div class="platform-hero__stat">
                            <span class="platform-hero__stat-num" id="totalAccountsCount"><%= stats.total %></span>
                            <span class="platform-hero__stat-label">Tài khoản</span>
                        </div>
                        <div class="platform-hero__stat-divider"></div>
                    <%
                        // Compute active count once (reused below)
                        const channelList = channels || [];
                        const activeCount = channelList.reduce((n, c) => n + (c.apiStatus === 'active' ? 1 : 0), 0);
                    %>
                    <div class="platform-hero__stat">
                            <span class="platform-hero__stat-num"><%= activeCount %></span>
                            <span class="platform-hero__stat-label">Hoạt động</span>
                        </div>
                    </div>
                    <button class="btn-connect-hero btn-platform btn-<%= activePlatform.toLowerCase() %>" data-platform="<%= activePlatform %>">
                        <i class="fa-solid fa-plus"></i>
                        Thêm tài khoản
                    </button>
                </div>
            </div>

            <!-- Accounts grouped by type -->
            <div class="accounts-section" id="accountsContainer">
            <%
                const typeGroups = [
                    { key: 'Cá nhân',       icon: 'fa-solid fa-user',       color: 'personal' },
                    { key: 'Nhà Sáng Tạo',  icon: 'fa-solid fa-star',       color: 'creator'  },
                    { key: 'Fanpage',        icon: 'fa-solid fa-flag',       color: 'fanpage'  },
                ];
                const knownKeys = typeGroups.map(g => g.key);
                // Single-pass bucket: group channels by accountType, unknown → __other__
                const grouped = { 'Cá nhân': [], 'Nhà Sáng Tạo': [], 'Fanpage': [], '__other__': [] };
                channelList.forEach(function(c) {
                    (grouped[c.accountType] || grouped['__other__']).push(c);
                });
                if (grouped['__other__'].length) typeGroups.push({ key: '__other__', icon: 'fa-solid fa-circle-nodes', color: 'other' });
            %>
            <% if (!channels || channels.length === 0) { %>
                <div class="accounts-grid">
                    <div class="empty-state-card">
                        <div class="empty-state-icon empty-state-icon--<%= activePlatform.toLowerCase() %>">
                            <i class="<%= activePlatform === 'ZO' ? 'fa-solid fa-message' : 'fa-brands fa-' + (activePlatform === 'FB' ? 'facebook' : activePlatform === 'TT' ? 'tiktok' : activePlatform === 'IG' ? 'instagram' : 'youtube') %>"></i>
                        </div>
                        <h3>Chưa có tài khoản <%= platformLabel %></h3>
                        <p>Kết nối tài khoản <%= platformLabel %> để hệ thống tự động hóa nội dung của bạn.</p>
                        <button class="btn-empty-connect btn-connect btn-platform btn-<%= activePlatform.toLowerCase() %>" data-platform="<%= activePlatform %>">
                            <i class="fa-solid fa-link"></i>
                            Kết nối <%= platformLabel %>
                        </button>
                    </div>
                </div>
            <% } else { %>
                <%
                    let cardIdx = 0;
                %>
                <% typeGroups.forEach(function(group) { %>
                    <%
                        // Reuse the pre-built bucket — no re-filtering per group
                        const groupChannels = grouped[group.key] || [];
                        if (!groupChannels.length) return;
                        const groupLabel = group.key === '__other__' ? 'Loại khác' : group.key;
                    %>
                    <div class="account-type-section" style="animation-delay: <%= cardIdx * 20 %>ms">
                        <div class="account-type-header account-type-header--<%= group.color %>">
                            <div class="account-type-header__icon">
                                <i class="<%= group.icon %>"></i>
                            </div>
                            <div class="account-type-header__info">
                                <h2 class="account-type-header__title"><%= groupLabel %></h2>
                                <span class="account-type-header__count"><%= groupChannels.length %> tài khoản</span>
                            </div>
                        </div>

                        <div class="accounts-grid">
                            <% groupChannels.forEach(function(channel) { %>
                                <div
                                    class="account-card <%= channel.isEnabled ? '' : 'is-disabled' %> <%= ['FB','TT','IG','YT'].includes(channel.platform) ? 'is-openable' : '' %>"
                                    data-id="<%= channel._id %>"
                                    data-platform="<%= channel.platform %>"
                                    role="button"
                                    tabindex="0"
                                    aria-label="Mở tài khoản <%= channel.accountName %>"
                                    style="animation-delay: <%= cardIdx++ * 55 %>ms"
                                >
                                    <div class="account-card__glow"></div>

                                    <div class="account-top">
                                        <div class="account-avatar-wrapper">
                                            <% if (channel.avatarUrl) { %>
                                                <img class="account-avatar" src="<%= channel.avatarUrl %>" alt="Avatar của <%= channel.accountName %>">
                                            <% } else { %>
                                                <div class="account-avatar account-avatar-placeholder">
                                                    <i class="fa-solid fa-user"></i>
                                                </div>
                                            <% } %>
                                            <div class="platform-badge badge-<%= channel.platform.toLowerCase() %>">
                                                <i class="<%= channel.platform === 'ZO' ? 'fa-solid fa-message' : 'fa-brands fa-' + (channel.platform === 'FB' ? 'facebook' : channel.platform === 'TT' ? 'tiktok' : channel.platform === 'IG' ? 'instagram' : 'youtube') %>"></i>
                                            </div>
                                        </div>
                                        <div class="account-name-info">
                                            <h4><%= channel.accountName %></h4>
                                            <% if (channel.profileUrl) { %>
                                                <a href="<%= channel.profileUrl %>" target="_blank" rel="noopener" class="account-profile-link">
                                                    <i class="fa-solid fa-arrow-up-right-from-square"></i>
                                                    Xem profile
                                                </a>
                                            <% } %>
                                        </div>
                                        <label class="switch-toggle account-action-control" title="<%= channel.isEnabled ? 'Tắt tài khoản' : 'Bật tài khoản' %>">
                                            <input type="checkbox" <%= channel.isEnabled ? 'checked' : '' %>>
                                            <span class="slider-round"></span>
                                        </label>
                                    </div>

                                    <div class="account-meta-stats">
                                        <div class="meta-stat-item">
                                            <span class="meta-stat-label"><i class="fa-solid fa-circle-dot"></i> Trạng thái</span>
                                            <span class="meta-stat-value api-status-pill <%= channel.apiStatus === 'active' ? 'status-active' : 'status-inactive' %>">
                                                <span class="status-dot"></span>
                                                <%= channel.apiStatus === 'active' ? 'Sẵn sàng' : 'Ngoại tuyến' %>
                                            </span>
                                        </div>
                                        <div class="account-card-actions">
                                            <button
                                                class="btn-action btn-edit-channel account-action-control"
                                                type="button"
                                                title="Chỉnh sửa"
                                                data-id="<%= channel._id %>"
                                                data-platform="<%= channel.platform %>"
                                                data-account-name="<%= channel.accountName %>"
                                                data-account-type="<%= channel.accountType %>"
                                                data-profile-url="<%= channel.profileUrl || '' %>"
                                                data-avatar-url="<%= channel.avatarUrl || '' %>"
                                            >
                                                <i class="fa-regular fa-pen-to-square"></i>
                                            </button>
                                            <button class="btn-action btn-delete-channel account-action-control" type="button" title="Xóa tài khoản">
                                                <i class="fa-regular fa-trash-can"></i>
                                            </button>
                                        </div>
                                    </div>
                                </div>
                            <% }); %>
                        </div>
                    </div>
                <% }); %>
            <% } %>
            </div>

        </div>
    </div>

    <!-- OAuth Modal -->
    <div class="oauth-modal" id="oauthModal">
        <div class="oauth-card">
            <div class="oauth-modal-header">
                <div class="oauth-modal-header-left">
                    <div class="oauth-icon-box" id="oauthIconBox">
                        <i class="fa-brands fa-facebook"></i>
                    </div>
                    <div class="oauth-modal-title-group">
                        <h3 id="oauthTitle">Kết nối Facebook API</h3>
                        <p id="oauthDesc">Cấp quyền để hệ thống kết nối từng tài khoản riêng biệt.</p>
                    </div>
                </div>
                <button type="button" class="btn-close-oauth" id="btnCloseOAuthModal" aria-label="Đóng">
                    <i class="fa-solid fa-xmark"></i>
                </button>
            </div>

            <div class="oauth-form-group">
                <label class="oauth-form-label" for="oauthAccountName">Tên tài khoản / Page</label>
                <input type="text" class="oauth-input" id="oauthAccountName" placeholder="Ví dụ: Fanpage Công Nghệ 247" autocomplete="off">
            </div>

            <div class="oauth-form-group" id="profileUrlFieldWrapper" style="display: none;">
                <label class="oauth-form-label" for="oauthProfileUrl">Link Profile <span class="fb-required-hint" style="color:var(--danger);font-weight:400;text-transform:none;letter-spacing:0">(bắt buộc)</span></label>
                <input type="text" class="oauth-input" id="oauthProfileUrl" placeholder="https://facebook.com/username"
                    data-placeholder-fb="https://facebook.com/username"
                    data-placeholder-tt="https://www.tiktok.com/@username"
                    data-placeholder-ig="https://www.instagram.com/username"
                    data-placeholder-yt="https://www.youtube.com/@channel"
                    autocomplete="off">
            </div>

            <div id="oauthEditAvatarPreviewWrap" style="display:none" class="oauth-form-group">
                <label class="oauth-form-label">Avatar hiện tại</label>
                <div class="oauth-current-avatar" id="oauthCurrentAvatarBox">
                    <div class="oauth-current-avatar-text" id="oauthCurrentAvatarText">Chưa có avatar</div>
                </div>
            </div>

            <div class="oauth-form-group">
                <label class="oauth-form-label" for="oauthAvatar">Ảnh đại diện</label>
                <div class="oauth-upload-row">
                    <input type="file" class="oauth-file-input" id="oauthAvatar" accept="image/*">
                    <span class="oauth-upload-hint">Tải ảnh lên để quản lý tài khoản dễ nhận diện hơn.</span>
                </div>
            </div>

            <div id="oauthSecondaryField"></div>

            <div class="oauth-action-btns">
                <button type="button" class="btn-oauth-cancel" id="btnOAuthCancel">
                    <i class="fa-solid fa-ban"></i> Hủy bỏ
                </button>
                <button type="button" class="btn-oauth-submit" id="btnOAuthSubmit">
                    <i class="fa-solid fa-link"></i> Ủy quyền kết nối
                </button>
            </div>
        </div>
    </div>

    <script src="/js/toast.js"></script>
    <script src="/js/base.js"></script>
    <script src="/js/utils.js"></script>
    <script src="/js/cryptoVault.js"></script>
    <script src="/js/channels.js"></script>
</body>
</html>
