<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>FB Comment Crawler - ReelsFlow AI</title>
    <link rel="stylesheet" href="/css/base.css">
    <link rel="stylesheet" href="/css/style.css">
    <link rel="stylesheet" href="/css/toast.css">
    <link rel="stylesheet" href="/css/comment-crawler.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.6.0/css/all.min.css">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
    <script src="/socket.io/socket.io.js"></script>
</head>
<body>
<%- include('partials/sidebar', { currentPage: 'comment-crawler' }) %>

<div class="main-content">
    <%- include('partials/header') %>

    <main class="content-body cc-page">
        <!-- Hero -->
        <section class="cc-hero">
            <div class="cc-hero__row">
                <div class="cc-hero__text">
                    <span class="cc-hero__eyebrow">
                        <i class="fa-brands fa-facebook-messenger"></i>
                        Crawler bình luận
                    </span>
                    <h1 class="cc-hero__title">FB Comment Crawler</h1>
                    <p class="cc-hero__desc">Quét toàn bộ bình luận + reply lồng nhau từ một bài viết Facebook, xuất JSON/CSV. Tận dụng tài khoản FB đã kết nối.</p>
                </div>
                <div class="cc-hero__badge">
                    <i class="fa-solid fa-comments"></i>
                </div>
            </div>
        </section>

        <!-- Stats -->
        <section class="cc-stats">
            <div class="cc-stat">
                <div class="cc-stat__icon blue"><i class="fa-solid fa-list-check"></i></div>
                <div>
                    <span class="cc-stat__value"><%= stats.totalScrapes %></span>
                    <span class="cc-stat__label">Lần scrape</span>
                </div>
            </div>
            <div class="cc-stat">
                <div class="cc-stat__icon green"><i class="fa-solid fa-circle-check"></i></div>
                <div>
                    <span class="cc-stat__value"><%= stats.successScrapes %></span>
                    <span class="cc-stat__label">Thành công</span>
                </div>
            </div>
            <div class="cc-stat">
                <div class="cc-stat__icon amber"><i class="fa-solid fa-comments"></i></div>
                <div>
                    <span class="cc-stat__value"><%= stats.totalComments %></span>
                    <span class="cc-stat__label">Tổng comments</span>
                </div>
            </div>
            <div class="cc-stat">
                <div class="cc-stat__icon purple"><i class="fa-regular fa-clock"></i></div>
                <div>
                    <span class="cc-stat__value">
                        <% if (stats.lastScrapedAt) { %>
                            <%= new Date(stats.lastScrapedAt).toLocaleString('vi-VN') %>
                        <% } else { %>—<% } %>
                    </span>
                    <span class="cc-stat__label">Lần cuối</span>
                </div>
            </div>
        </section>

        <!-- Form -->
        <section class="cc-card">
            <div class="cc-card__header">
                <h3 class="cc-card__title">
                    <i class="fa-solid fa-rocket"></i>
                    Bắt đầu quét mới
                </h3>
                <span class="cc-card__hint">
                    <i class="fa-solid fa-info-circle"></i> Mặc định lấy cả main + reply
                </span>
            </div>
            <form id="scrapeForm">
                <div class="cc-form-grid">
                    <div class="cc-field">
                        <label class="cc-field__label" for="postUrl">
                            <i class="fa-solid fa-link"></i> Link bài viết Facebook
                        </label>
                        <textarea id="postUrl" name="postUrl" class="cc-textarea" required
                                  placeholder="https://www.facebook.com/PAGE/posts/..."></textarea>
                    </div>
                    <div class="cc-field">
                        <label class="cc-field__label" for="channelId">
                            <i class="fa-solid fa-user-shield"></i> Tài khoản FB dùng để scrape
                        </label>
                        <select id="channelId" name="channelId" class="cc-select" required>
                            <option value="">-- Chọn tài khoản FB --</option>
                            <% channels.forEach(function(ch) { %>
                                <option value="<%= ch._id %>">
                                    <%= ch.accountName %> (<%= ch.accountType %>)
                                </option>
                            <% }); %>
                        </select>
                        <% if (!channels || channels.length === 0) { %>
                            <p class="cc-field__warn">
                                <i class="fa-solid fa-triangle-exclamation"></i>
                                Chưa có tài khoản FB nào — vào
                                <a href="/channels?platform=FB">Kết Nối Tài Khoản</a> để thêm.
                            </p>
                        <% } %>
                    </div>
                </div>
                <div class="cc-form-actions">
                    <button type="submit" class="cc-btn cc-btn--primary" id="btnScrape" <%= !channels || channels.length === 0 ? 'disabled' : '' %>>
                        <i class="fa-solid fa-play"></i> Bắt đầu scrape
                    </button>
                    <span class="cc-form-hint">
                        <i class="fa-solid fa-shield-halved"></i> Job chạy nền, có thể đóng tab
                    </span>
                </div>
            </form>
        </section>

        <!-- History -->
        <section class="cc-card">
            <div class="cc-card__header">
                <h3 class="cc-card__title">
                    <i class="fa-solid fa-clock-rotate-left"></i>
                    Lịch sử scrape
                </h3>
                <span class="cc-card__hint">
                    <i class="fa-solid fa-database"></i> Tối đa 20 lần gần nhất
                </span>
            </div>
            <% if (!scrapes || scrapes.length === 0) { %>
                <div class="cc-empty">
                    <i class="fa-regular fa-folder-open"></i>
                    <p class="cc-empty__title">Chưa có lần scrape nào</p>
                    <p class="cc-empty__text">Dán link bài viết Facebook ở trên và bấm "Bắt đầu scrape" để bắt đầu.</p>
                </div>
            <% } else { %>
                <div class="cc-table-wrap">
                    <table class="cc-table">
                        <thead>
                            <tr>
                                <th>Trạng thái</th>
                                <th>Bài viết</th>
                                <th>Comments</th>
                                <th>Thời gian</th>
                                <th>Hành động</th>
                            </tr>
                        </thead>
                        <tbody id="scrapesTbody">
                            <% scrapes.forEach(function(s) { %>
                                <tr data-job-id="<%= s._id %>">
                                    <td>
                                        <span class="cc-badge cc-badge--<%= s.status %><%= s.status === 'running' ? '' : '' %>" data-job-status="<%= s._id %>">
                                            <% if (s.status === 'running') { %><span class="cc-badge__spinner"></span><% } %>
                                            <%= s.status %>
                                        </span>
                                    </td>
                                    <td>
                                        <a href="<%= s.postUrl %>" target="_blank" class="cc-table__post-link" title="<%= s.postUrl %>">
                                            <%= s.postTitle || s.postUrl.substring(0, 60) + '...' %>
                                        </a>
                                        <div class="cc-table__post-meta">
                                            <i class="fa-solid fa-user"></i> <%= s.accountName %>
                                        </div>
                                    </td>
                                    <td>
                                        <div class="cc-table__comments">
                                            <strong><%= s.stats?.totalComments || 0 %></strong>
                                            <small>(<%= s.stats?.mainComments || 0 %> main / <%= s.stats?.replies || 0 %> reply)</small>
                                        </div>
                                    </td>
                                    <td class="cc-table__time">
                                        <%= new Date(s.scrapedAt).toLocaleString('vi-VN') %>
                                    </td>
                                    <td>
                                        <div class="cc-table__actions">
                                            <button class="cc-btn cc-btn--ghost btn-view" data-id="<%= s._id %>" title="Xem chi tiết">
                                                <i class="fa-solid fa-eye"></i> Xem
                                            </button>
                                            <button class="cc-btn cc-btn--ghost btn-rescrape" data-id="<%= s._id %>" data-url="<%= s.postUrl %>" data-channel="<%= s.channelId %>" title="Quét lại bài viết này">
                                                <i class="fa-solid fa-rotate"></i>
                                            </button>
                                            <a class="cc-btn cc-btn--ghost" href="/tracking/comments/api/job/<%= s._id %>/export?format=json" title="Tải JSON">
                                                <i class="fa-solid fa-download"></i> JSON
                                            </a>
                                            <a class="cc-btn cc-btn--ghost" href="/tracking/comments/api/job/<%= s._id %>/export?format=csv" title="Tải CSV">
                                                <i class="fa-solid fa-file-csv"></i>
                                            </a>
                                            <button class="cc-btn cc-btn--ghost cc-btn--danger btn-delete" data-id="<%= s._id %>" title="Xóa">
                                                <i class="fa-solid fa-trash"></i>
                                            </button>
                                        </div>
                                    </td>
                                </tr>
                            <% }); %>
                        </tbody>
                    </table>
                </div>
            <% } %>
        </section>
    </main>
</div>

<!-- Floating widget (realtime) -->
<div id="crawlerWidget" class="cc-widget">
    <div class="cc-widget__row">
        <div class="cc-widget__icon" id="widgetIcon">
            <i class="fa-solid fa-spinner fa-spin" id="widgetSpinner"></i>
        </div>
        <div class="cc-widget__body">
            <div class="cc-widget__title" id="widgetTitle">Đang scrape...</div>
            <div class="cc-widget__sub" id="widgetSubtitle">Đang khởi tạo</div>
        </div>
        <i class="fa-solid fa-chevron-up cc-widget__chev"></i>
    </div>
    <div class="cc-widget__bar">
        <div id="widgetProgressFill" class="cc-widget__fill"></div>
    </div>
</div>

<!-- Notify modal (alert / confirm) -->
<div id="notifyModal" class="cc-modal-backdrop">
    <div class="cc-modal">
        <div class="cc-modal__header">
            <div id="notifyIcon" class="cc-modal__icon info">
                <i class="fa-solid fa-info"></i>
            </div>
            <div class="cc-modal__title" id="notifyTitle">Thông báo</div>
        </div>
        <div id="notifyMessage" class="cc-modal__body">Nội dung thông báo</div>
        <div class="cc-modal__footer">
            <button id="notifyCancel" class="cc-modal__btn cc-modal__btn--cancel">Huỷ</button>
            <button id="notifyOk" class="cc-modal__btn cc-modal__btn--confirm info">OK</button>
        </div>
    </div>
</div>

<!-- Detail modal -->
<div id="detailModal" class="cc-modal-backdrop">
    <div class="cc-modal cc-detail-modal">
        <div class="cc-detail-header">
            <h3 id="detailTitle">Chi tiết comments</h3>
            <button id="closeDetail" class="cc-detail-close" aria-label="Đóng">×</button>
        </div>
        <div id="detailStats" class="cc-detail-stats"></div>
        <div id="detailBody" class="cc-detail-body"></div>
    </div>
</div>

<script src="/js/base.js"></script>
<script>
(function() {
    'use strict';

    // ====== DOM refs ======
    const $ = (id) => document.getElementById(id);

    const form = $('scrapeForm');
    const btn = $('btnScrape');
    const widget = $('crawlerWidget');
    const widgetIcon = $('widgetIcon');
    const widgetSpinner = $('widgetSpinner');
    const widgetTitle = $('widgetTitle');
    const widgetSubtitle = $('widgetSubtitle');
    const widgetFill = $('widgetProgressFill');

    const notifyModal = $('notifyModal');
    const notifyIcon = $('notifyIcon');
    const notifyTitle = $('notifyTitle');
    const notifyMessage = $('notifyMessage');
    const notifyOk = $('notifyOk');
    const notifyCancel = $('notifyCancel');

    const detailModal = $('detailModal');
    const detailTitle = $('detailTitle');
    const detailStats = $('detailStats');
    const detailBody = $('detailBody');
    const closeDetail = $('closeDetail');

    // ====== Notify modal helpers ======
    const NOTIFY_STYLES = {
        info:    { icon: 'fa-info',          cls: 'info' },
        success: { icon: 'fa-check',         cls: 'success' },
        warning: { icon: 'fa-triangle-exclamation', cls: 'warning' },
        error:   { icon: 'fa-xmark',         cls: 'error' },
        danger:  { icon: 'fa-trash',         cls: 'danger' }
    };

    function showNotify({ type = 'info', title = 'Thông báo', message = '', okText = 'OK', cancelText = 'Huỷ', showCancel = false } = {}) {
        return new Promise((resolve) => {
            const s = NOTIFY_STYLES[type] || NOTIFY_STYLES.info;
            notifyIcon.className = 'cc-modal__icon ' + s.cls;
            notifyIcon.innerHTML = '<i class="fa-solid ' + s.icon + '"></i>';
            notifyTitle.textContent = title;
            notifyMessage.textContent = message;
            notifyOk.textContent = okText;
            notifyOk.className = 'cc-modal__btn cc-modal__btn--confirm ' + s.cls;
            notifyCancel.textContent = cancelText;
            notifyCancel.style.display = showCancel ? 'inline-block' : 'none';

            function close(result) {
                notifyModal.classList.remove('show');
                notifyOk.removeEventListener('click', onOk);
                notifyCancel.removeEventListener('click', onCancel);
                resolve(result);
            }
            function onOk() { close(true); }
            function onCancel() { close(false); }
            notifyOk.addEventListener('click', onOk);
            notifyCancel.addEventListener('click', onCancel);
            notifyModal.classList.add('show');
        });
    }
    window.appAlert = (m, t = 'Thông báo') => showNotify({ type: 'info', title: t, message: m });
    window.appConfirm = (m, t = 'Xác nhận') => showNotify({ type: 'warning', title: t, message: m, showCancel: true, okText: 'Đồng ý' });
    window.appError = (m, t = 'Lỗi') => showNotify({ type: 'error', title: t, message: m, okText: 'Đóng' });
    window.appSuccess = (m, t = 'Thành công') => showNotify({ type: 'success', title: t, message: m });
    window.appDanger = (m, t = 'Cảnh báo') => showNotify({ type: 'danger', title: t, message: m, showCancel: true, okText: 'Xóa' });

    // Click backdrop đóng modal
    notifyModal.addEventListener('click', (e) => { if (e.target === notifyModal) notifyModal.classList.remove('show'); });
    detailModal.addEventListener('click', (e) => { if (e.target === detailModal) detailModal.classList.remove('show'); });
    closeDetail.addEventListener('click', () => detailModal.classList.remove('show'));

    // ====== Widget helpers ======
    function showWidget() { widget.style.display = 'block'; }
    function hideWidget() { widget.style.display = 'none'; }
    function setWidgetState(state, title, subtitle) {
        widgetIcon.className = 'cc-widget__icon';
        if (state === 'success') {
            widgetIcon.classList.add('success');
            widgetSpinner.className = 'fa-solid fa-check';
        } else if (state === 'error') {
            widgetIcon.classList.add('error');
            widgetSpinner.className = 'fa-solid fa-xmark';
        } else {
            widgetSpinner.className = 'fa-solid fa-spinner fa-spin';
        }
        widgetTitle.textContent = title;
        widgetSubtitle.textContent = subtitle;
    }
    function resetButton() {
        if (btn) {
            btn.disabled = false;
            btn.innerHTML = '<i class="fa-solid fa-play"></i> Bắt đầu scrape';
        }
    }

    // Reset tất cả nút rescrape trong table (vì nút này không liên quan btn chính)
    function resetAllRescrapeButtons() {
        document.querySelectorAll('.btn-rescrape').forEach(function (b) {
            b.disabled = false;
            if (b.dataset.origHtml) {
                b.innerHTML = b.dataset.origHtml;
            } else {
                b.innerHTML = '<i class="fa-solid fa-rotate"></i>';
            }
        });
    }

    // ====== Row helpers ======
    function escapeHtml(s) {
        return String(s || '').replace(/[&<>"']/g, ch => ({'&':'&','<':'<','>':'>','"':'"',"'":'&#39;'}[ch]));
    }
    function escapeAttr(s) {
        return String(s || '').replace(/"/g, '"');
    }

    function updateRowStatus(jobId, status, stats) {
        const badge = document.querySelector(`.cc-badge[data-job-status="${jobId}"]`);
        if (!badge) return;
        badge.className = 'cc-badge cc-badge--' + status;
        if (status === 'running') {
            badge.innerHTML = '<span class="cc-badge__spinner"></span>running';
        } else {
            badge.textContent = status;
        }
        if (stats) {
            const row = badge.closest('tr');
            if (row) {
                const cell = row.querySelector('td:nth-child(3)');
                if (cell) {
                    const total = stats.totalComments != null ? stats.totalComments : 0;
                    const main = stats.mainComments != null ? stats.mainComments : 0;
                    const replies = stats.replies != null ? stats.replies : 0;
                    cell.innerHTML = `<div class="cc-table__comments"><strong>${total}</strong><small>(${main} main / ${replies} reply)</small></div>`;
                }
            }
        }
    }

    function buildRowHtml(s) {
        return `
            <td>
                <span class="cc-badge cc-badge--${s.status}" data-job-status="${s._id}">
                    ${s.status === 'running' ? '<span class="cc-badge__spinner"></span>' : ''}
                    ${s.status}
                </span>
            </td>
            <td>
                <a href="${escapeAttr(s.postUrl)}" target="_blank" class="cc-table__post-link" title="${escapeAttr(s.postUrl)}">
                    ${escapeHtml(s.postTitle || (s.postUrl || '').substring(0, 60) + '...')}
                </a>
                <div class="cc-table__post-meta">
                    <i class="fa-solid fa-user"></i> ${escapeHtml(s.accountName || '')}
                </div>
            </td>
            <td>
                <div class="cc-table__comments">
                    <strong>${s.stats?.totalComments || 0}</strong>
                    <small>(${s.stats?.mainComments || 0} main / ${s.stats?.replies || 0} reply)</small>
                </div>
            </td>
            <td class="cc-table__time">${new Date(s.scrapedAt || s.createdAt).toLocaleString('vi-VN')}</td>
            <td>
                <div class="cc-table__actions">
                    <button class="cc-btn cc-btn--ghost btn-view" data-id="${s._id}" title="Xem chi tiết">
                        <i class="fa-solid fa-eye"></i> Xem
                    </button>
                    <button class="cc-btn cc-btn--ghost btn-rescrape" data-id="${s._id}" data-url="${escapeAttr(s.postUrl)}" data-channel="${s.channelId || ''}" title="Quét lại">
                        <i class="fa-solid fa-rotate"></i>
                    </button>
                    <a class="cc-btn cc-btn--ghost" href="/tracking/comments/api/job/${s._id}/export?format=json" title="JSON">
                        <i class="fa-solid fa-download"></i> JSON
                    </a>
                    <a class="cc-btn cc-btn--ghost" href="/tracking/comments/api/job/${s._id}/export?format=csv" title="CSV">
                        <i class="fa-solid fa-file-csv"></i>
                    </a>
                    <button class="cc-btn cc-btn--ghost cc-btn--danger btn-delete" data-id="${s._id}" title="Xóa">
                        <i class="fa-solid fa-trash"></i>
                    </button>
                </div>
            </td>
        `;
    }

    function bindRowEvents(tr) {
        tr.querySelector('.btn-view')?.addEventListener('click', () => viewJobDetail(tr.dataset.jobId));
        const rescrapeBtn = tr.querySelector('.btn-rescrape');
        if (rescrapeBtn && !rescrapeBtn.dataset.origHtml) {
            rescrapeBtn.dataset.origHtml = rescrapeBtn.innerHTML;
        }
        rescrapeBtn?.addEventListener('click', () => rescrapeJob(tr));
        tr.querySelector('.btn-delete')?.addEventListener('click', () => deleteJob(tr));
    }

    async function viewJobDetail(jobId) {
        detailBody.innerHTML = '<div class="cc-detail-loading"><i class="fa-solid fa-spinner fa-spin"></i> Đang tải...</div>';
        detailModal.classList.add('show');
        try {
            const res = await fetch('/tracking/comments/api/job/' + jobId);
            const data = await res.json();
            if (!data.success) {
                detailBody.innerHTML = '<p style="color:#b91c1c;">Lỗi: ' + escapeHtml(data.message) + '</p>';
                return;
            }
            const job = data.job;
            detailTitle.textContent = job.postTitle || job.postUrl;
            const incomplete = job.stats?.hasIncompleteReplies;
            detailStats.innerHTML = `
                Tổng: <strong>${job.stats?.totalComments || 0}</strong>
                &nbsp;|&nbsp; Main: <strong>${job.stats?.mainComments || 0}</strong>
                &nbsp;|&nbsp; Reply: <strong>${job.stats?.replies || 0}</strong>
                &nbsp;|&nbsp; Max depth: <strong>${job.stats?.maxDepth || 0}</strong>
                &nbsp;|&nbsp; ${incomplete ? '<span style="color:#b45309;">⚠️ Còn reply chưa load</span>' : '<span style="color:#15803d;">✓ Đủ</span>'}
            `;
            detailBody.innerHTML = renderTree(job.tree || [], 0);
        } catch (err) {
            detailBody.innerHTML = '<p style="color:#b91c1c;">Lỗi: ' + escapeHtml(err.message) + '</p>';
        }
    }

    async function rescrapeJob(tr) {
        const btnEl = tr.querySelector('.btn-rescrape');
        const url = btnEl.dataset.url;
        const channelId = btnEl.dataset.channel;
        if (!url || !channelId) {
            appError('Không tìm thấy URL hoặc channel của lần scrape này.');
            return;
        }
        if (!await appConfirm('Quét lại bài viết này?\n\nURL: ' + url + '\n\nLần scrape cũ sẽ được cập nhật với dữ liệu mới nhất (dữ liệu cũ vẫn được giữ trong DB cho đến khi job mới hoàn tất).')) return;

        // Reset tất cả nút rescrape trước khi bắt đầu
        resetAllRescrapeButtons();
        btnEl.disabled = true;
        const origHtml = btnEl.dataset.origHtml || '<i class="fa-solid fa-rotate"></i>';
        btnEl.innerHTML = '<i class="fa-solid fa-spinner fa-spin"></i>';

        try {
            const res = await fetch('/tracking/comments/api/scrape', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ postUrl: url, channelId, maxComments: 0, includeReplies: true, skipPreviousUsers: false, visible: true })
            });
            const data = await res.json();
            if (!data.success) {
                appError(data.message || 'Lỗi không xác định');
                btnEl.innerHTML = origHtml;
                btnEl.disabled = false;
            } else {
                updateRowStatus(data.jobId, 'running');
                // Giữ spinner trên nút - sẽ được reset khi reload trang
            }
        } catch (err) {
            appError('Lỗi kết nối: ' + err.message);
            btnEl.innerHTML = origHtml;
            btnEl.disabled = false;
        }
    }

    async function deleteJob(tr) {
        if (!await appConfirm('Xoá lần scrape này?')) return;
        const id = tr.dataset.jobId;
        try {
            const res = await fetch('/tracking/comments/api/job/' + id, { method: 'DELETE' });
            if (res.ok) tr.remove();
            else appError('Lỗi khi xóa');
        } catch (err) {
            appError('Lỗi: ' + err.message);
        }
    }

    async function appendJobRow(jobId) {
        try {
            const res = await fetch('/tracking/comments/api/job/' + jobId);
            const data = await res.json();
            if (!data.success) return;
            const job = data.job;
            const tbody = $('scrapesTbody');
            if (!tbody) return;

            // Xóa empty state nếu còn
            const empty = document.querySelector('.cc-empty');
            if (empty) empty.remove();
            const tableWrap = document.querySelector('.cc-table-wrap');
            if (tableWrap && tableWrap.style.display === 'none') tableWrap.style.display = '';

            const tr = document.createElement('tr');
            tr.dataset.jobId = job._id;
            tr.innerHTML = buildRowHtml(job);

            const existing = tbody.querySelector(`tr[data-job-id="${job._id}"]`);
            if (existing) {
                existing.outerHTML = tr.outerHTML;
                const newRow = tbody.querySelector(`tr[data-job-id="${job._id}"]`);
                bindRowEvents(newRow);
                if (job.status === 'running') updateRowStatus(job._id, 'running');
                return;
            }

            tr.classList.add('fresh');
            tbody.insertBefore(tr, tbody.firstChild);
            while (tbody.children.length > 20) tbody.removeChild(tbody.lastChild);
            bindRowEvents(tr);
        } catch (e) {
            console.log('appendJobRow error:', e.message);
        }
    }

    // ====== Tree render ======
    function renderTree(nodes, depth) {
        if (!nodes || nodes.length === 0) return '<div class="cc-tree-empty">Không có comment.</div>';
        let html = '';
        nodes.forEach(c => {
            const hasReplies = c.replies && c.replies.length > 0;
            html += `
                <div class="cc-tree-comment depth-${depth % 5}">
                    <div>
                        <span class="cc-tree-comment__author">${escapeHtml(c.author || '[NO AUTHOR]')}</span>
                        <span class="cc-tree-comment__meta">${escapeHtml(c.timestamp || '')}</span>
                        ${c.likes ? '<span class="cc-tree-comment__likes">❤ ' + c.likes + '</span>' : ''}
                    </div>
                    <div class="cc-tree-comment__text">${escapeHtml(c.text || '')}</div>
                    ${hasReplies ? `<button class="cc-tree-comment__toggle" onclick="this.nextElementSibling.style.display=this.nextElementSibling.style.display==='none'?'block':'none'">▼ ${c.replies.length} reply</button>` : ''}
                    <div ${hasReplies ? 'style="display:none;"' : ''}>
                        ${hasReplies ? renderTree(c.replies, depth + 1) : ''}
                    </div>
                </div>
            `;
        });
        return html;
    }

    // ====== Socket.IO realtime ======
    if (window.io) {
        const socket = io();
        let reloadTimer = null;

        socket.on('comment-crawler:progress', (data) => {
            if (!data) return;

            const isFinal = data.phase === 'success' || data.phase === 'failed';

            if (data.jobId) {
                if (isFinal) {
                    updateRowStatus(data.jobId, data.phase === 'success' ? 'success' : 'failed', data.stats);
                } else {
                    updateRowStatus(data.jobId, 'running');
                }
            }

            if (!isFinal) return;

            // Phase cuối: reset nút + auto reload
            resetButton();
            resetAllRescrapeButtons();

            if (reloadTimer) clearTimeout(reloadTimer);
            reloadTimer = setTimeout(() => {
                console.log('[CommentCrawler] Auto-reload sau khi job hoàn tất');
                window.location.reload();
            }, 1500);
        });

        socket.on('disconnect', () => {
            console.warn('[CommentCrawler] Socket disconnected, resetting buttons');
            resetButton();
            resetAllRescrapeButtons();
            const hasRunning = document.querySelectorAll('.cc-badge.cc-badge--running').length > 0;
            if (hasRunning) {
                setTimeout(() => window.location.reload(), 3000);
            }
        });
        socket.on('reconnect', () => {
            console.log('[CommentCrawler] Socket reconnected');
        });
    }

    // ====== Form submit ======
    form.addEventListener('submit', async (e) => {
        e.preventDefault();
        const postUrl = $('postUrl').value.trim();
        const channelId = $('channelId').value;
        if (!postUrl || !channelId) return;

        const skipPreviousUsers = window.__skipPreviousUsersOnSubmit === true;
        if (window.__skipPreviousUsersOnSubmit) window.__skipPreviousUsersOnSubmit = false;

        const origHtml = btn.innerHTML;
        btn.disabled = true;
        btn.innerHTML = '<i class="fa-solid fa-spinner fa-spin"></i> Đang bắt đầu...';

        try {
            const res = await fetch('/tracking/comments/api/scrape', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ postUrl, channelId, maxComments: 0, includeReplies: true, skipPreviousUsers, visible: true })
            });
            const data = await res.json();
            if (!data.success) {
                appError(data.message || 'Lỗi không xác định');
                btn.innerHTML = origHtml;
                btn.disabled = false;
            } else if (data.jobId) {
                // Update row mới nhất sang running ngay
                updateRowStatus(data.jobId, 'running');
            }
        } catch (err) {
            appError('Lỗi kết nối: ' + err.message);
            btn.innerHTML = origHtml;
            btn.disabled = false;
        }
    });

    // ====== Initial bindings ======
    document.querySelectorAll('#scrapesTbody tr').forEach(tr => bindRowEvents(tr));

    // Khôi phục spin cho các job đang running
    document.querySelectorAll('.cc-badge.cc-badge--running').forEach(badge => {
        if (!badge.querySelector('.cc-badge__spinner')) {
            const text = badge.textContent.trim();
            badge.innerHTML = '<span class="cc-badge__spinner"></span>' + text;
        }
    });

    // Fallback: nếu có job running trong DB mà socket không emit final event
    // → tự động reset UI sau 15 phút (giả định backend bị kẹt)
    setTimeout(function() {
        const runningBadges = document.querySelectorAll('.cc-badge.cc-badge--running');
        if (runningBadges.length > 0 && btn && !btn.disabled) {
            console.warn('[CommentCrawler] Auto-clearing stuck running badges');
            runningBadges.forEach(function(badge) {
                badge.className = 'cc-badge cc-badge--failed';
                badge.innerHTML = '<i class="fa-solid fa-clock"></i> Timeout';
            });
        }
    }, 15 * 60 * 1000);
})();
</script>
</body>
</html>