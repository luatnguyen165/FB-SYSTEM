<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Theo Dõi Đối Thủ - ReelsFlow AI</title>
    <link rel="stylesheet" href="/css/base.css">
    <link rel="stylesheet" href="/css/style.css">
    <link rel="stylesheet" href="/css/competitors.css">
    <link rel="stylesheet" href="/css/toast.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
</head>
<body>
    <%- include('partials/sidebar', { currentPage: 'competitors' }) %>

    <div class="main-content">
        <%- include('partials/header') %>

        <div class="content-body">
            <!-- Hero Section -->
            <div class="page-hero">
                <div class="page-hero-content">
                    <div class="page-hero-left">
                        <div class="page-hero-title">
                            <div class="page-hero-icon"><i class="fa-solid fa-users-viewfinder"></i></div>
                            <h1>Theo Dõi Đối Thủ</h1>
                        </div>
                        <p class="page-hero-subtitle">
                            Giám sát hoạt động, phân tích chiến lược và theo dõi sự phát triển của đối thủ cạnh tranh trên mọi nền tảng Facebook, Instagram, TikTok, YouTube.
                        </p>
                    </div>
                    <div class="page-hero-actions">
                        <button class="btn-hero-primary" id="btnAddCompetitor">
                            <i class="fa-solid fa-plus"></i> Thêm đối thủ
                        </button>
                        <button class="btn-hero-secondary" id="btnCompare" disabled>
                            <i class="fa-solid fa-code-compare"></i> So sánh
                        </button>
                    </div>
                </div>
            </div>

            <!-- Stats -->
            <div class="page-stats">
                <div class="page-stat-card">
                    <div class="page-stat-icon" style="background: rgba(37,99,235,0.1); color: #2563eb;">
                        <i class="fa-solid fa-users-viewfinder"></i>
                    </div>
                    <div class="page-stat-info">
                        <span class="page-stat-value" id="statTotal"><%= stats.totalCompetitors %></span>
                        <span class="page-stat-label">Tổng đối thủ</span>
                    </div>
                </div>
                <div class="page-stat-card">
                    <div class="page-stat-icon" style="background: rgba(16,185,129,0.1); color: #10b981;">
                        <i class="fa-solid fa-eye"></i>
                    </div>
                    <div class="page-stat-info">
                        <span class="page-stat-value" id="statActive"><%= stats.activeCompetitors %></span>
                        <span class="page-stat-label">Đang theo dõi</span>
                    </div>
                </div>
                <div class="page-stat-card">
                    <div class="page-stat-icon" style="background: rgba(139,92,246,0.1); color: #8b5cf6;">
                        <i class="fa-solid fa-file-lines"></i>
                    </div>
                    <div class="page-stat-info">
                        <span class="page-stat-value" id="statPosts"><%= stats.postStats.reduce((sum, s) => sum + (s.postCount || 0), 0) %></span>
                        <span class="page-stat-label">Tổng bài viết</span>
                    </div>
                </div>
                <div class="page-stat-card">
                    <div class="page-stat-icon" style="background: rgba(245,158,11,0.1); color: #f59e0b;">
                        <i class="fa-solid fa-users"></i>
                    </div>
                    <div class="page-stat-info">
                        <span class="page-stat-value" id="statFollowers"><%= stats.platformStats.reduce((sum, s) => sum + (s.totalFollowers || 0), 0).toLocaleString() %></span>
                        <span class="page-stat-label">Tổng followers</span>
                    </div>
                </div>
            </div>

            <!-- Section Header -->
            <div class="list-section">
                <div class="list-section-header">
                    <div class="list-section-title">
                        <i class="fa-solid fa-list-check"></i>
                        <h2>Đối thủ đang theo dõi</h2>
                        <span class="list-section-count"><%= (competitors || []).length %> đối thủ</span>
                    </div>
                    <div class="list-section-actions">
                        <div class="search-box" style="position:relative;max-width:280px;">
                            <i class="fa-solid fa-magnifying-glass" style="position:absolute;left:12px;top:50%;transform:translateY(-50%);color:var(--text-light);font-size:0.8rem;"></i>
                            <input type="text" id="searchInput" placeholder="Tìm kiếm đối thủ..." style="padding-left:32px;width:100%;border:1.5px solid var(--border);border-radius:var(--radius-sm);background:var(--bg-card);color:var(--text-main);font-size:0.85rem;height:38px;outline:none;">
                        </div>
                    </div>
                </div>

                <!-- Platform Tabs -->
                <div class="platform-tabs">
                    <button class="platform-tab is-active" data-platform="">Tất cả</button>
                    <button class="platform-tab" data-platform="FB"><i class="fa-brands fa-facebook"></i> Facebook</button>
                    <button class="platform-tab" data-platform="IG"><i class="fa-brands fa-instagram"></i> Instagram</button>
                    <button class="platform-tab" data-platform="TT"><i class="fa-brands fa-tiktok"></i> TikTok</button>
                    <button class="platform-tab" data-platform="YT"><i class="fa-brands fa-youtube"></i> YouTube</button>
                </div>

                <!-- Competitors Grid -->
                <div class="competitors-grid" id="competitorsGrid">
                    <% if (competitors && competitors.length > 0) { %>
                        <% competitors.forEach(comp => { %>
                            <div class="competitor-card" data-id="<%= comp._id %>" data-platform="<%= comp.platform %>">
                                <div class="competitor-card__header">
                                    <div class="competitor-card__check">
                                        <input type="checkbox" class="competitor-check" data-id="<%= comp._id %>" aria-label="Chọn <%= comp.name %>">
                                        <div class="competitor-check-visual"><i class="fa-solid fa-check"></i></div>
                                    </div>
                                    <div class="competitor-card__avatar">
                                        <% if (comp.avatarUrl) { %>
                                            <img src="<%= comp.avatarUrl %>" alt="<%= comp.name %>">
                                        <% } else { %>
                                            <div class="avatar-placeholder" data-platform="<%= comp.platform %>">
                                                <%= comp.name.substring(0, 2).toUpperCase() %>
                                            </div>
                                        <% } %>
                                        <span class="platform-badge badge-<%= comp.platform.toLowerCase() %>">
                                            <i class="fa-brands fa-<%= comp.platform === 'FB' ? 'facebook' : comp.platform === 'IG' ? 'instagram' : comp.platform === 'TT' ? 'tiktok' : 'youtube' %>"></i>
                                        </span>
                                    </div>
                                    <div class="competitor-card__info">
                                        <h4><%= comp.name %></h4>
                                        <span class="comp-platform-label"><%= {FB:'Facebook',IG:'Instagram',TT:'TikTok',YT:'YouTube'}[comp.platform] %></span>
                                    </div>
                                    <div class="competitor-card__actions">
                                        <button class="card-action-btn competitor-scan-btn" data-act="scrape" data-id="<%= comp._id %>" title="Scrape bài viết">
                                            <i class="fa-solid fa-play"></i>
                                        </button>
                                        <button class="card-action-btn" data-act="edit" data-id="<%= comp._id %>" title="Sửa">
                                            <i class="fa-solid fa-pen-to-square"></i>
                                        </button>
                                        <button class="card-action-btn" data-act="toggle" data-id="<%= comp._id %>" title="<%= comp.isActive ? 'Tạm dừng' : 'Bật' %>">
                                            <i class="fa-solid fa-<%= comp.isActive ? 'pause' : 'play' %>" style="color:<%= comp.isActive ? '' : '#10b981' %>"></i>
                                        </button>
                                        <button class="card-action-btn" data-act="delete" data-id="<%= comp._id %>" title="Xóa">
                                            <i class="fa-solid fa-trash-can"></i>
                                        </button>
                                    </div>
                                </div>
                                <div class="competitor-card__body">
                                    <% if (comp.description) { %>
                                        <p class="comp-desc"><%= comp.description.substring(0, 120) %><%= comp.description.length > 120 ? '...' : '' %></p>
                                    <% } %>
                                    <div class="comp-stats-row">
                                        <div class="comp-stat-item">
                                            <span class="comp-stat-icon"><i class="fa-solid fa-users"></i></span>
                                            <span class="comp-stat-val"><%= (comp.followers || 0).toLocaleString() %></span>
                                            <span class="comp-stat-lbl">Followers</span>
                                        </div>
                                        <div class="comp-stat-item">
                                            <span class="comp-stat-icon"><i class="fa-solid fa-file-lines"></i></span>
                                            <span class="comp-stat-val"><%= comp.postsCount || 0 %></span>
                                            <span class="comp-stat-lbl">Bài viết</span>
                                        </div>
                                        <div class="comp-stat-item">
                                            <span class="comp-stat-icon"><i class="fa-solid fa-clock"></i></span>
                                            <span class="comp-stat-val"><%= comp.lastCheckedAt ? new Date(comp.lastCheckedAt).toLocaleDateString('en-GB') : '--' %></span>
                                            <span class="comp-stat-lbl">Lần cuối</span>
                                        </div>
                                    </div>
                                    <% if (comp.tags && comp.tags.length > 0) { %>
                                        <div class="comp-tags">
                                            <% comp.tags.forEach(tag => { %>
                                                <span class="comp-tag"><%= tag %></span>
                                            <% }) %>
                                        </div>
                                    <% } %>
                                </div>
                                <div class="competitor-card__footer">
                                    <button class="footer-action-btn" data-act="posts" data-id="<%= comp._id %>">
                                        <i class="fa-solid fa-list"></i> Bài viết
                                    </button>
                                    <button class="footer-action-btn" data-act="trend" data-id="<%= comp._id %>">
                                        <i class="fa-solid fa-chart-line"></i> Xu hướng
                                    </button>
                                    <a href="<%= comp.profileUrl %>" target="_blank" class="footer-action-btn">
                                        <i class="fa-solid fa-arrow-up-right-from-square"></i> Mở
                                    </a>
                                </div>
                                <% if (!comp.isActive) { %>
                                    <div class="competitor-card__overlay">
                                        <span><i class="fa-solid fa-pause"></i> Đã tạm dừng</span>
                                    </div>
                                <% } %>
                            </div>
                        <% }) %>
                    <% } else { %>
                        <div class="empty-state-card">
                            <div class="empty-state-icon"><i class="fa-solid fa-users-viewfinder"></i></div>
                            <h3>Chưa có đối thủ nào</h3>
                            <p>Bắt đầu theo dõi đối thủ cạnh tranh trên Facebook, Instagram, TikTok và YouTube.</p>
                            <button class="btn-hero-primary" id="btnFirstAdd" style="display:inline-flex;">
                                <i class="fa-solid fa-plus"></i> Thêm đối thủ đầu tiên
                            </button>
                        </div>
                    <% } %>
                </div>
            </div>

            <!-- Scraped Posts Data Table -->
            <div class="list-section" id="postsDataTableSection">
                <div class="list-section-header">
                    <div class="list-section-title">
                        <i class="fa-solid fa-table"></i>
                        <h2>Dữ Liệu Bài Viết Đã Scrape</h2>
                        <span class="list-section-count" id="allPostsCount">0 bài viết</span>
                    </div>
                    <div class="list-section-actions">
                        <select id="allPostsFilterCompetitor" style="padding:8px 12px;border:1.5px solid var(--border);border-radius:var(--radius-sm);background:var(--bg-card);color:var(--text-main);font-size:0.85rem;">
                            <option value="">Tất cả đối thủ</option>
                            <% (competitors || []).forEach(function(c) { %>
                            <option value="<%= c._id %>"><%= c.name %></option>
                            <% }); %>
                        </select>
                        <select id="allPostsFilterMedia" style="padding:8px 12px;border:1.5px solid var(--border);border-radius:var(--radius-sm);background:var(--bg-card);color:var(--text-main);font-size:0.85rem;">
                            <option value="">Tất cả loại</option>
                            <option value="image">Ảnh</option>
                            <option value="video">Video</option>
                            <option value="reel">Reel</option>
                            <option value="text">Text</option>
                            <option value="link">Link</option>
                        </select>
                    </div>
                </div>
                <div class="posts-table-wrap" id="allPostsTableWrap">
                    <table class="posts-data-table" id="allPostsTable">
                        <thead>
                            <tr>
                                <th class="pt-col-id">#</th>
                                <th class="pt-col-competitor">Đối thủ</th>
                                <th class="pt-col-postid">Post ID</th>
                                <th class="pt-col-content">Nội dung</th>
                                <th class="pt-col-media">Media</th>
                                <th class="pt-col-comments"><i class="fa-solid fa-comment"></i></th>
                                <th class="pt-col-likes"><i class="fa-solid fa-heart"></i></th>
                                <th class="pt-col-date">Ngày đăng</th>
                                <th class="pt-col-scraped">Ngày scrape</th>
                                <th class="pt-col-sentiment">Sentiment</th>
                                <th class="pt-col-actions"></th>
                            </tr>
                        </thead>
                        <tbody id="allPostsBody">
                            <tr><td colspan="11" style="text-align:center;padding:30px;color:var(--text-muted);">
                                <i class="fa-solid fa-spinner fa-spin" style="margin-right:8px;"></i> Đang tải dữ liệu...
                            </td></tr>
                        </tbody>
                    </table>
                </div>
                <div class="ai-scan-pagination" id="allPostsPagination"></div>
            </div>
        </div>
    </div>

    <!-- Add/Edit Modal -->
    <div class="modal-overlay" id="competitorModal" style="display:none;">
        <div class="modal-content modal-md">
            <div class="modal-header">
                <h3><i class="fa-solid fa-users-viewfinder"></i> <span id="modalTitle">Thêm Đối Thủ Mới</span></h3>
                <button class="modal-close" id="modalClose"><i class="fa-solid fa-xmark"></i></button>
            </div>
            <div class="modal-body">
                <form id="competitorForm">
                    <input type="hidden" id="formCompetitorId" value="">
                    <div class="form-group">
                        <label>Tên đối thủ <span class="required">*</span></label>
                        <input type="text" id="formName" placeholder="VD: Shop ABC" required>
                    </div>
                    <div class="form-row form-row-2">
                        <div class="form-group">
                            <label>Nền tảng <span class="required">*</span></label>
                            <select id="formPlatform" required>
                                <option value="FB">Facebook</option>
                                <option value="IG">Instagram</option>
                                <option value="TT">TikTok</option>
                                <option value="YT">YouTube</option>
                            </select>
                        </div>
                        <div class="form-group">
                            <label>Số bài cần quét</label>
                            <input type="number" id="formPostLimit" value="10" min="1" max="100">
                        </div>
                    </div>
                    <div class="form-group">
                        <label>Tài khoản Facebook để quét <span class="required">*</span></label>
                        <select id="formChannelId" required>
                            <option value="">-- Chọn tài khoản --</option>
                            <% facebookChannels.forEach(function(ch) { %>
                            <option value="<%= ch._id %>"><%= ch.accountName %> (<%= ch.accountType %>)</option>
                            <% }); %>
                        </select>
                    </div>
                    <div class="form-group">
                        <label>URL page/profile cần quét <span class="required">*</span></label>
                        <input type="url" id="formProfileUrl"
                               placeholder="https://facebook.com/..."
                               data-placeholder-fb="https://facebook.com/..."
                               data-placeholder-ig="https://instagram.com/..."
                               data-placeholder-tt="https://tiktok.com/@..."
                               data-placeholder-yt="https://youtube.com/@..."
                               data-pattern-fb="facebook\.com"
                               data-pattern-ig="instagram\.com"
                               data-pattern-tt="tiktok\.com"
                               data-pattern-yt="youtube\.com"
                               required>
                        <small class="form-hint" id="formProfileUrlHint"
                               data-hint-fb="Nhập URL Facebook page hoặc profile của đối thủ. Ví dụ: https://facebook.com/shopabc"
                               data-hint-ig="Nhập URL Instagram profile của đối thủ. Ví dụ: https://instagram.com/shopabc"
                               data-hint-tt="Nhập URL TikTok profile của đối thủ. Ví dụ: https://tiktok.com/@shopabc"
                               data-hint-yt="Nhập URL YouTube channel của đối thủ. Ví dụ: https://youtube.com/@shopabc">Nhập URL Facebook page hoặc profile của đối thủ. Ví dụ: https://facebook.com/shopabc</small>
                    </div>
                    <div class="form-group">
                        <label>Ảnh đại diện (URL)</label>
                        <input type="url" id="formAvatarUrl" placeholder="https://...">
                    </div>
                    <div class="form-group">
                        <label>Ghi chú</label>
                        <textarea id="formNotes" rows="2" placeholder="Ghi chú cá nhân..."></textarea>
                    </div>
                    <div class="form-actions">
                        <button type="button" class="btn btn-outline" id="formCancel">Hủy</button>
                        <button type="submit" class="btn btn-primary">
                            <i class="fa-solid fa-floppy-disk"></i> <span id="formSubmitText">Thêm mới</span>
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <!-- Posts Modal -->
    <div class="modal-overlay" id="postsModal" style="display:none;">
        <div class="modal-content modal-xl">
            <div class="modal-header">
                <h3><i class="fa-solid fa-file-lines"></i> <span id="postsModalTitle">Bài Viết Của Đối Thủ</span></h3>
                <button class="modal-close" id="postsModalClose"><i class="fa-solid fa-xmark"></i></button>
            </div>
            <div class="modal-body">
                <div class="form-row" style="justify-content:space-between;margin-bottom:16px;">
                    <select id="postsFilterType" style="padding:8px 12px;border:1.5px solid var(--border);border-radius:var(--radius-sm);background:var(--bg-card);color:var(--text-main);font-size:0.85rem;">
                        <option value="">Tất cả loại</option>
                        <option value="image">Ảnh</option>
                        <option value="video">Video</option>
                        <option value="reel">Reel</option>
                        <option value="text">Text</option>
                        <option value="link">Link</option>
                    </select>
                    <button class="btn btn-primary btn-sm" id="btnAddPost">
                        <i class="fa-solid fa-plus"></i> Thêm bài viết
                    </button>
                </div>
                <div class="posts-list" id="postsList">
                    <div class="empty-state" style="padding:30px 16px;">
                        <i class="fa-solid fa-file-lines" style="font-size:2rem;color:var(--text-light);"></i>
                        <p>Chưa có bài viết nào</p>
                    </div>
                </div>
                <div class="ai-scan-pagination" id="postsPagination" style="display:none;">
                    <div class="ai-scan-pagination__info" id="postsPaginationInfo"></div>
                    <div class="ai-scan-pagination__controls" id="postsPaginationControls"></div>
                </div>
            </div>
        </div>
    </div>

    <!-- Add Post Modal -->
    <div class="modal-overlay" id="addPostModal" style="display:none;">
        <div class="modal-content modal-md">
            <div class="modal-header">
                <h3><i class="fa-solid fa-plus"></i> Thêm Bài Viết</h3>
                <button class="modal-close" id="addPostModalClose"><i class="fa-solid fa-xmark"></i></button>
            </div>
            <div class="modal-body">
                <form id="addPostForm">
                    <input type="hidden" id="postFormCompetitorId" value="">
                    <div class="form-group">
                        <label>URL bài viết</label>
                        <input type="url" id="postFormUrl" placeholder="https://...">
                    </div>
                    <div class="form-group">
                        <label>Nội dung</label>
                        <textarea id="postFormContent" rows="3" placeholder="Nội dung bài viết..."></textarea>
                    </div>
                    <div class="form-row form-row-2">
                        <div class="form-group">
                            <label>Loại bài viết</label>
                            <select id="postFormMediaType">
                                <option value="unknown">Không xác định</option>
                                <option value="image">Ảnh</option>
                                <option value="video">Video</option>
                                <option value="reel">Reel</option>
                                <option value="text">Text</option>
                                <option value="link">Link</option>
                            </select>
                        </div>
                        <div class="form-group">
                            <label>Ngày đăng</label>
                            <input type="date" id="postFormDate">
                        </div>
                    </div>
                    <div class="form-row form-row-4">
                        <div class="form-group">
                            <label>Likes</label>
                            <input type="number" id="postFormLikes" placeholder="0" min="0">
                        </div>
                        <div class="form-group">
                            <label>Comments</label>
                            <input type="number" id="postFormComments" placeholder="0" min="0">
                        </div>
                        <div class="form-group">
                            <label>Shares</label>
                            <input type="number" id="postFormShares" placeholder="0" min="0">
                        </div>
                        <div class="form-group">
                            <label>Views</label>
                            <input type="number" id="postFormViews" placeholder="0" min="0">
                        </div>
                    </div>
                    <div class="form-row form-row-2">
                        <div class="form-group">
                            <label>Engagement Rate %</label>
                            <input type="number" id="postFormEngagement" placeholder="0" step="0.01" min="0">
                        </div>
                        <div class="form-group">
                            <label>Sentiment</label>
                            <select id="postFormSentiment">
                                <option value="">Không đánh giá</option>
                                <option value="positive">Tích cực 😊</option>
                                <option value="neutral">Trung tính 😐</option>
                                <option value="negative">Tiêu cực 😞</option>
                            </select>
                        </div>
                    </div>
                    <div class="form-actions">
                        <button type="button" class="btn btn-outline" id="addPostCancel">Hủy</button>
                        <button type="submit" class="btn btn-primary">
                            <i class="fa-solid fa-floppy-disk"></i> Thêm bài viết
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <!-- Edit Post Modal -->
    <div class="modal-overlay" id="editPostModal" style="display:none;">
        <div class="modal-content modal-md">
            <div class="modal-header">
                <h3><i class="fa-solid fa-pen"></i> Chỉnh Sửa Bài Viết</h3>
                <button class="modal-close" id="editPostModalClose"><i class="fa-solid fa-xmark"></i></button>
            </div>
            <div class="modal-body">
                <form id="editPostForm">
                    <input type="hidden" id="editPostId" value="">
                    <div class="form-group">
                        <label>Nội dung</label>
                        <textarea id="editPostContent" rows="3" placeholder="Nội dung bài viết..."></textarea>
                    </div>
                    <div class="form-group">
                        <label>URL bài viết</label>
                        <input type="url" id="editPostUrl" placeholder="https://...">
                    </div>
                    <div class="form-row form-row-2">
                        <div class="form-group">
                            <label>Loại bài viết</label>
                            <select id="editPostMediaType">
                                <option value="unknown">Không xác định</option>
                                <option value="image">Ảnh</option>
                                <option value="video">Video</option>
                                <option value="reel">Reel</option>
                                <option value="text">Text</option>
                                <option value="link">Link</option>
                            </select>
                        </div>
                        <div class="form-group">
                            <label>Sentiment</label>
                            <select id="editPostSentiment">
                                <option value="">Không đánh giá</option>
                                <option value="positive">Tích cực 😊</option>
                                <option value="neutral">Trung tính 😐</option>
                                <option value="negative">Tiêu cực 😞</option>
                            </select>
                        </div>
                    </div>
                    <div class="form-row form-row-3">
                        <div class="form-group">
                            <label>Likes</label>
                            <input type="number" id="editPostLikes" placeholder="0" min="0">
                        </div>
                        <div class="form-group">
                            <label>Comments</label>
                            <input type="number" id="editPostComments" placeholder="0" min="0">
                        </div>
                        <div class="form-group">
                            <label>Shares</label>
                            <input type="number" id="editPostShares" placeholder="0" min="0">
                        </div>
                    </div>
                    <div class="form-actions">
                        <button type="button" class="btn btn-outline" id="editPostCancel">Hủy</button>
                        <button type="submit" class="btn btn-primary">
                            <i class="fa-solid fa-floppy-disk"></i> Lưu thay đổi
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <!-- Image Preview Modal -->
    <div class="modal-overlay" id="previewModal" style="display:none;">
        <div class="modal-content" style="max-width:90vw;max-height:90vh;width:auto;background:transparent;box-shadow:none;transform:none;overflow:visible;">
            <button class="modal-close" id="previewModalClose" style="position:fixed;top:20px;right:20px;z-index:1001;background:rgba(0,0,0,0.5);color:white;border:none;border-radius:50%;width:40px;height:40px;font-size:1.2rem;cursor:pointer;"><i class="fa-solid fa-xmark"></i></button>
            <img id="previewImage" src="" alt="Preview" style="max-width:90vw;max-height:85vh;border-radius:12px;box-shadow:0 20px 60px rgba(0,0,0,0.3);display:block;margin:auto;">
        </div>
    </div>

    <!-- Trend Modal -->
    <div class="modal-overlay" id="trendModal" style="display:none;">
        <div class="modal-content modal-md">
            <div class="modal-header">
                <h3><i class="fa-solid fa-chart-line"></i> <span id="trendModalTitle">Xu Hướng Followers</span></h3>
                <button class="modal-close" id="trendModalClose"><i class="fa-solid fa-xmark"></i></button>
            </div>
            <div class="modal-body">
                <div class="trend-summary" id="trendSummary"></div>
                <div class="trend-chart" style="min-height:250px;background:var(--bg-hover);border-radius:var(--radius-md);padding:16px;">
                    <canvas id="trendCanvas"></canvas>
                </div>
            </div>
        </div>
    </div>

    <!-- Compare Modal -->
    <div class="modal-overlay" id="compareModal" style="display:none;">
        <div class="modal-content modal-lg">
            <div class="modal-header">
                <h3><i class="fa-solid fa-code-compare"></i> So Sánh Đối Thủ</h3>
                <button class="modal-close" id="compareModalClose"><i class="fa-solid fa-xmark"></i></button>
            </div>
            <div class="modal-body">
                <div class="compare-grid" id="compareGrid"></div>
            </div>
        </div>
    </div>

    <script>
        // Pass channels data to JS
        window.__FB_CHANNELS__ = <%- JSON.stringify(facebookChannels || []) %>;
    </script>
    <script src="/js/toast.js"></script>
    <script src="/js/base.js"></script>
    <script src="/js/utils.js"></script>
    <script src="/js/competitors.js"></script>
</body>
</html>