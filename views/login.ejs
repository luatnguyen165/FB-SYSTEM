<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Đăng Nhập - Reels Auto-Uploader</title>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.6.0/css/all.min.css">
    <link rel="stylesheet" href="/css/base.css">
    <link rel="stylesheet" href="/css/toast.css">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
    <style>
        :root {
            --bg-color: #f9fafb; /* Nền xám siêu nhẹ để form trắng nổi bật hơn */
            --form-bg: #ffffff; /* Nền form trắng tinh */
            --text-main: #111827; /* Chữ màu đen sậm */
            --text-muted: #6b7280; /* Chữ màu xám */
            --primary: #2563eb; /* Xanh dương điểm nhấn */
            --primary-hover: #1d4ed8;
            --border: #e5e7eb; /* Đường viền siêu mảnh */
            --input-focus-border: #93c5fd;
            --shadow-card: 0 10px 15px -3px rgba(0, 0, 0, 0.1), 0 4px 6px -2px rgba(0, 0, 0, 0.05);
        }

        * {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
            font-family: 'Inter', sans-serif;
        }

        body {
            background-color: var(--bg-color);
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 20px;
            color: var(--text-main);
        }

        .auth-card {
            width: 100%;
            max-width: 420px;
            background-color: var(--form-bg);
            border-radius: 16px;
            padding: 40px;
            box-shadow: var(--shadow-card);
            border: 1px solid var(--border);
        }

        .header {
            text-align: center;
            margin-bottom: 32px;
        }

        .logo {
            font-size: 2rem;
            color: var(--primary);
            margin-bottom: 12px;
            display: inline-block;
        }

        .title {
            font-size: 1.5rem;
            font-weight: 700;
            margin-bottom: 8px;
            letter-spacing: -0.5px;
        }

        .desc {
            font-size: 0.925rem;
            color: var(--text-muted);
        }

        .form-group {
            margin-bottom: 20px;
        }

        .label {
            display: block;
            font-size: 0.85rem;
            font-weight: 500;
            margin-bottom: 8px;
        }

        .input-wrapper {
            position: relative;
        }

        .input-icon {
            position: absolute;
            left: 14px;
            top: 50%;
            transform: translateY(-50%);
            color: var(--text-muted);
            font-size: 1rem;
        }

        .input {
            width: 100%;
            padding: 12px 14px 12px 42px;
            background-color: #fff;
            border: 1px solid var(--border);
            border-radius: 8px;
            font-size: 0.95rem;
            color: var(--text-main);
            transition: all 0.2s ease;
        }

        .input:focus {
            outline: none;
            border-color: var(--input-focus-border);
            box-shadow: 0 0 0 3px rgba(37, 99, 235, 0.1);
        }

        .form-options {
            display: flex;
            align-items: center;
            justify-content: space-between;
            font-size: 0.85rem;
            margin-bottom: 24px;
        }

        .remember-me {
            display: flex;
            align-items: center;
            gap: 8px;
            color: var(--text-muted);
            cursor: pointer;
        }

        .remember-me input {
            accent-color: var(--primary);
            width: 16px;
            height: 16px;
            border-radius: 4px;
        }

        .forgot-link {
            color: var(--primary);
            text-decoration: none;
            font-weight: 500;
        }

        .forgot-link:hover {
            text-decoration: underline;
        }

        .btn-submit {
            width: 100%;
            padding: 12px;
            background-color: var(--primary);
            color: white;
            border: none;
            border-radius: 8px;
            font-size: 0.95rem;
            font-weight: 600;
            cursor: pointer;
            transition: background-color 0.2s;
        }

        .btn-submit:hover {
            background-color: var(--primary-hover);
        }

        .footer {
            text-align: center;
            margin-top: 28px;
            font-size: 0.875rem;
            color: var(--text-muted);
        }

        .footer a {
            color: var(--primary);
            text-decoration: none;
            font-weight: 600;
        }

        .footer a:hover {
            text-decoration: underline;
        }

        /* Responsive */
        @media (max-width: 480px) {
            .auth-card {
                padding: 30px 20px;
                border: none;
                box-shadow: none;
                background: transparent;
            }
        }
    </style>
</head>
<body data-flash-message='<%- typeof flash !== "undefined" && flash ? JSON.stringify(flash.message) : "" %>' data-flash-type="<%= typeof flash !== 'undefined' && flash ? (flash.type === 'success' ? 'success' : flash.type === 'warning' ? 'warning' : 'error') : '' %>">

    <div class="auth-card">
        <div class="header">
            <div class="logo"><i class="fa-solid fa-cloud-arrow-up"></i></div>
            <h1 class="title">Đăng nhập tài khoản</h1>
            <p class="desc">Chào mừng bạn trở lại hệ thống ReelsAuto.</p>
        </div>
        <form method="POST" action="/auth/login">
            <div class="form-group">
                <label class="label">ĐỊA CHỈ EMAIL</label>
                <div class="input-wrapper">
                    <i class="fa-regular fa-envelope input-icon"></i>
                    <input type="email" name="email" class="input" placeholder="ten@email.com" required>
                </div>
            </div>

            <div class="form-group">
                <label class="label">MẬT KHẨU</label>
                <div class="input-wrapper">
                    <i class="fa-solid fa-lock input-icon"></i>
                    <input type="password" name="password" class="input" placeholder="••••••••" required>
                </div>
            </div>

            <div class="form-options">
                <label class="remember-me">
                    <input type="checkbox" name="remember"> Duy trì đăng nhập
                </label>
                <a href="/auth/forgot-password" class="forgot-link">Quên mật khẩu?</a>
            </div>

            <input type="hidden" name="deviceId" id="loginDeviceId" value="">
            <button type="submit" class="btn-submit">Vào Hệ Thống</button>
        </form>

        <div class="footer">
            Chưa có tài khoản? <a href="/auth/register">Đăng ký miễn phí</a>
        </div>
    </div>

    <script src="/js/toast.js"></script>
    <script>
    // Show flash message if present
    (function() {
        var message = document.body.dataset.flashMessage;
        var type = document.body.dataset.flashType;
        if (message) showToast(message, type || 'info');
    })();

    // Generate deviceId and fill hidden field before form submit
    document.querySelector('form').addEventListener('submit', async function(e) {
        var field = document.getElementById('loginDeviceId');
        if (field && !field.value) {
            try {
                var signals = [navigator.userAgent, navigator.platform, navigator.language,
                    screen.width + 'x' + screen.height + 'x' + screen.colorDepth,
                    String(new Date().getTimezoneOffset()), navigator.hardwareConcurrency, navigator.deviceMemory].join('|||');
                var data = new TextEncoder().encode(signals);
                var hash = await crypto.subtle.digest('SHA-256', data);
                field.value = Array.from(new Uint8Array(hash)).map(function(b){return b.toString(16).padStart(2,'0')}).join('');
            } catch(err) {
                field.value = 'fp_' + Math.abs(navigator.userAgent.length * 31).toString(16);
            }
        }
    });
    </script>
</body>
</html>
