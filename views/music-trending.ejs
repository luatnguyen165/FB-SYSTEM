<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Music Trending - ReelsFlow AI</title>
    <link rel="stylesheet" href="/css/base.css">
    <link rel="stylesheet" href="/css/style.css">
    <link rel="stylesheet" href="/css/music-trending.css">
    <link rel="stylesheet" href="/css/toast.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
</head>
<body>
<%- include('partials/sidebar', { currentPage: 'music-trending' }) %>

<div class="main-content">
    <%- include('partials/header') %>

    <div class="content-body">
        <!-- Hero -->
        <div class="music-hero">
            <div class="music-hero-content">
                <div class="music-hero-left">
                    <div class="music-hero-title">
                        <div class="music-hero-icon"><i class="fa-solid fa-music"></i></div>
                        <h1>Music Trending</h1>
                    </div>
                    <p class="music-hero-subtitle">Danh sách nhạc trending từ các nền tảng</p>
                </div>
                <div class="music-hero-actions">
                    <button class="btn-music-hero" onclick="openFetchModal()">
                        <i class="fa-solid fa-cloud-arrow-down"></i> Lấy nhạc mới
                    </button>
                </div>
            </div>
        </div>

        <div id="fetchStatus" class="fetch-status" style="display:none;"></div>

        <!-- Hidden audio element for playback on table -->
        <audio id="globalAudio" style="display:none;"></audio>

        <div class="table-responsive">
            <table class="table music-table">
                <thead>
                    <tr>
                        <th width="40"><input type="checkbox" id="selectAll"></th>
                        <th width="40">#</th>
                        <th width="80">Platform</th>
                        <th>Title</th>
                        <th>Artist</th>
                        <th width="80">Duration</th>
                        <th width="200">Source</th>
                        <th width="100">Play</th>
                        <th width="60">Delete</th>
                    </tr>
                </thead>
                <tbody id="musicTableBody">
                    <% if (musicList && musicList.length > 0) { %>
                        <% musicList.forEach(function(m, i) { %>
                        <tr data-id="<%= m._id %>" data-url="<%= m.url %>">
                            <td><input type="checkbox" class="row-checkbox"></td>
                            <td class="text-muted"><%= i + 1 %></td>
                            <td>
                                <span class="badge badge-<%= m.platform.toLowerCase() %>">
                                    <i class="fa-brands fa-<%= m.platform === 'TT' ? 'tiktok' : m.platform === 'YT' ? 'youtube' : m.platform === 'FB' ? 'facebook' : m.platform === 'IG' ? 'instagram' : m.platform === 'ZO' ? 'tiktok' : 'music' %>"></i>
                                    <%= m.platform %>
                                </span>
                            </td>
                            <td class="fw-600"><%= m.title || 'Untitled' %></td>
                            <td class="text-muted"><%= m.artist || 'Unknown' %></td>
                            <td><%= Math.floor((m.duration || 0) / 60) %>:<%= String((m.duration || 0) % 60).padStart(2, '0') %></td>
                            <td class="text-muted small"><%= m.accountName || '' %></td>
                            <td>
                                <button class="btn btn-sm btn-icon btn-soft-primary play-btn" onclick="togglePlay(this, '<%= m._id %>')" title="Play">
                                    <i class="fa-solid fa-play"></i>
                                </button>
                            </td>
                            <td>
                                <button class="btn btn-sm btn-icon btn-soft-danger" onclick="deleteMusic('<%= m._id %>')" title="Delete">
                                    <i class="fa-solid fa-trash-can"></i>
                                </button>
                            </td>
                        </tr>
                        <% }) %>
                    <% } else { %>
                        <tr>
                            <td colspan="9" class="text-center py-5 text-muted">
                                <i class="fa-solid fa-music fs-2 d-block mb-2"></i>
                                Chưa có nhạc nào. Nhấn "Lấy nhạc mới" để bắt đầu.
                            </td>
                        </tr>
                    <% } %>
                </tbody>
            </table>
        </div>
    </div>
</div>

<!-- ====== FETCH MODAL ====== -->
<div id="fetchModal" class="music-modal-overlay" style="display:none;">
    <div class="music-modal">
        <div class="music-modal-header">
            <h3><i class="fa-solid fa-cloud-arrow-down"></i> Lấy nhạc trending</h3>
            <button class="music-modal-close" onclick="closeFetchModal()"><i class="fa-solid fa-xmark"></i></button>
        </div>
        <div class="music-modal-body">
            <!-- Platform selector -->
            <div class="mfield">
                <label class="mfield-label">Chọn nền tảng</label>
                <div class="platform-options" id="platformOptions">
                    <button class="platform-option is-active" data-platform="TT" onclick="selectPlatform(this)">
                        <i class="fa-brands fa-tiktok"></i> TikTok
                    </button>
                    <button class="platform-option" data-platform="YT" onclick="selectPlatform(this)">
                        <i class="fa-brands fa-youtube"></i> YouTube
                    </button>
                    <button class="platform-option" data-platform="FB" onclick="selectPlatform(this)">
                        <i class="fa-brands fa-facebook"></i> Facebook
                    </button>
                    <button class="platform-option" data-platform="IG" onclick="selectPlatform(this)">
                        <i class="fa-brands fa-instagram"></i> Instagram
                    </button>
                </div>
            </div>

            <!-- Account selector -->
            <div class="mfield">
                <label class="mfield-label">Chọn tài khoản</label>
                <select id="accountSelect" class="mfield-select">
                    <option value="">-- Tất cả tài khoản --</option>
                    <% if (channels && channels.length > 0) { %>
                        <% channels.forEach(function(ch) { %>
                        <option value="<%= ch._id %>" data-platform="<%= ch.platform %>">
                            <%= ch.accountName %> (<%= ch.platform %>)
                        </option>
                        <% }) %>
                    <% } %>
                </select>
                <% if (!channels || channels.length === 0) { %>
                <p class="mfield-hint">Chưa có tài khoản. <a href="/channels">Thêm tài khoản</a></p>
                <% } %>
            </div>
        </div>
        <div class="music-modal-footer">
            <button class="btn btn-soft" onclick="closeFetchModal()">Huỷ</button>
            <button class="btn btn-primary" onclick="doFetch()">
                <i class="fa-solid fa-cloud-arrow-down"></i> Lấy nhạc
            </button>
        </div>
    </div>
</div>

<script>
const globalAudio = document.getElementById('globalAudio');
let selectedPlatform = 'TT';

// ---- Modal ----
function openFetchModal() {
    document.getElementById('fetchModal').style.display = 'flex';
    // Filter accounts by selected platform
    filterAccounts(selectedPlatform);
}

function closeFetchModal() {
    document.getElementById('fetchModal').style.display = 'none';
}

function selectPlatform(btn) {
    document.querySelectorAll('.platform-option').forEach(el => el.classList.remove('is-active'));
    btn.classList.add('is-active');
    selectedPlatform = btn.dataset.platform;
    filterAccounts(selectedPlatform);
}

function filterAccounts(platform) {
    const sel = document.getElementById('accountSelect');
    for (const opt of sel.options) {
        if (opt.value === '') continue; // placeholder
        const p = opt.dataset.platform;
        opt.style.display = p === platform ? '' : 'none';
    }
    // If current selection is hidden, reset
    if (sel.selectedOptions[0].style.display === 'none') {
        sel.value = '';
    }
}

// Close on overlay click
document.getElementById('fetchModal')?.addEventListener('click', function(e) {
    if (e.target === this) closeFetchModal();
});

// ---- Fetch ----
async function doFetch() {
    closeFetchModal();

    const btn = document.querySelector('.btn-music-hero');
    const status = document.getElementById('fetchStatus');
    btn.disabled = true;
    btn.innerHTML = '<i class="fa-solid fa-spinner fa-spin"></i> Loading...';
    status.style.display = 'none';

    try {
        const platform = selectedPlatform || 'TT';
        const accountId = document.getElementById('accountSelect').value;
        const url = `/music-trending/fetch?platform=${platform}` + (accountId ? `&accountId=${accountId}` : '');

        const res = await fetch(url);
        const data = await res.json();
        if (data.success) {
            status.className = 'fetch-status is-success';
            status.innerHTML = `<i class="fa-solid fa-check-circle"></i> ${data.message}`;
            status.style.display = 'flex';
            setTimeout(() => location.reload(), 1500);
        } else {
            status.className = 'fetch-status is-error';
            status.innerHTML = `<i class="fa-solid fa-exclamation-circle"></i> ${data.message}`;
            status.style.display = 'flex';
        }
    } catch (err) {
        status.className = 'fetch-status is-error';
        status.innerHTML = `<i class="fa-solid fa-exclamation-circle"></i> Network error`;
        status.style.display = 'flex';
    } finally {
        btn.disabled = false;
        btn.innerHTML = '<i class="fa-solid fa-cloud-arrow-down"></i> Lấy nhạc mới';
    }
}

// Reset all play buttons to play icon
function resetPlayButtons(excludeBtn) {
    document.querySelectorAll('.play-btn').forEach(b => {
        if (b !== excludeBtn) {
            b.innerHTML = '<i class="fa-solid fa-play"></i>';
            b.title = 'Play';
        }
    });
}

// Toggle play/pause on the table row
function togglePlay(btn, id) {
    const row = document.querySelector(`tr[data-id="${id}"]`);
    if (!row) return;

    const url = row.dataset.url;
    if (!url || url === '') {
        alert('No audio URL available.');
        return;
    }

    // If clicking the same track that is currently playing
    if (globalAudio.dataset.currentId === id && !globalAudio.paused) {
        globalAudio.pause();
        btn.innerHTML = '<i class="fa-solid fa-play"></i>';
        btn.title = 'Play';
        row.classList.remove('is-playing');
        return;
    }

    // Stop current and play new
    globalAudio.pause();
    resetPlayButtons(btn);
    document.querySelectorAll('tr.is-playing').forEach(r => r.classList.remove('is-playing'));

    globalAudio.src = url;
    globalAudio.dataset.currentId = id;
    globalAudio.load();
    globalAudio.play().then(() => {
        btn.innerHTML = '<i class="fa-solid fa-pause"></i>';
        btn.title = 'Pause';
        row.classList.add('is-playing');
    }).catch(() => {
        alert('Could not play audio.');
    });
}

// When audio ends, reset button
globalAudio.addEventListener('ended', () => {
    const id = globalAudio.dataset.currentId;
    const row = document.querySelector(`tr[data-id="${id}"]`);
    if (row) row.classList.remove('is-playing');
    const btn = document.querySelector(`tr[data-id="${id}"] .play-btn`);
    if (btn) {
        btn.innerHTML = '<i class="fa-solid fa-play"></i>';
        btn.title = 'Play';
    }
    globalAudio.dataset.currentId = '';
});

// When audio is paused by user
globalAudio.addEventListener('pause', () => {
    if (globalAudio.currentTime > 0 && !globalAudio.ended) {
        const id = globalAudio.dataset.currentId;
        const btn = document.querySelector(`tr[data-id="${id}"] .play-btn`);
        if (btn && document.querySelector(`tr[data-id="${id}"]`)) {
            btn.innerHTML = '<i class="fa-solid fa-play"></i>';
            btn.title = 'Play';
            document.querySelector(`tr[data-id="${id}"]`).classList.remove('is-playing');
        }
    }
});

// Delete track
async function deleteMusic(id) {
    if (!confirm('Delete this track?')) return;
    try {
        const res = await fetch(`/music-trending/delete/${id}`, { method: 'POST' });
        const data = await res.json();
        if (data.success) {
            if (globalAudio.dataset.currentId === id) {
                globalAudio.pause();
                globalAudio.dataset.currentId = '';
            }
            const row = document.querySelector(`tr[data-id="${id}"]`);
            if (row) row.remove();
            const tbody = document.getElementById('musicTableBody');
            if (tbody.querySelectorAll('tr').length === 0) {
                tbody.innerHTML = `<tr><td colspan="9" class="text-center py-5 text-muted">
                    <i class="fa-solid fa-music fs-2 d-block mb-2"></i>
                    Chưa có nhạc nào. Nhấn "Lấy nhạc mới" để bắt đầu.
                </td></tr>`;
            }
        } else {
            alert(data.message || 'Delete failed');
        }
    } catch (err) {
        alert('Error deleting track');
    }
}

// Select all checkbox
document.getElementById('selectAll')?.addEventListener('change', function() {
    document.querySelectorAll('.row-checkbox').forEach(cb => cb.checked = this.checked);
});
</script>
<script src="/js/base.js"></script>
<script src="/js/utils.js"></script>

<%- include('partials/footer') %>
</body>
</html>