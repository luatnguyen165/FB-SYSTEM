<nav class="top-nav" data-lang="<%= lang || 'vi' %>">
    <div class="nav-left">
        <button class="menu-toggle" id="menuToggle" aria-label="Mở menu"><i class="fa-solid fa-bars"></i></button>

        <div class="nav-brand">
            <div class="nav-brand-mark">
                <i class="fa-solid fa-bolt"></i>
            </div>
            <div class="nav-brand-text">
                <span class="nav-brand-label"><%= t('app.name') %></span>
                <span class="nav-brand-subtitle"><%= t('app.subtitle') %></span>
            </div>
        </div>

        <div class="nav-search">
            <i class="fa-solid fa-magnifying-glass"></i>
            <input type="text" placeholder="<%= t('common.search_placeholder') %>">
        </div>
    </div>

    <div class="nav-right">
        <!-- Notification Bell -->
        <div class="notif-bell-wrapper" id="notifBellWrapper" style="position:relative;">
            <button class="notif-bell-btn" id="notifBellBtn" type="button" aria-label="Thông báo" title="Thông báo">
                <i class="fa-solid fa-bell"></i>
                <span class="notif-badge" id="notifBadge" style="display:none;">0</span>
            </button>
            <div class="notif-dropdown" id="notifDropdown" style="display:none;">
                <div class="notif-dropdown-header">
                    <div>
                        <div style="font-size:14px; font-weight:600; color:#1c1e21;">Thông báo</div>
                        <div style="font-size:11px; color:#65676b; margin-top:2px;" id="notifHeaderSubtitle">Cập nhật realtime</div>
                    </div>
                    <button id="notifMarkAllRead" style="background:none; border:none; color:#1877f2; font-size:12px; cursor:pointer; font-weight:500;">Đánh dấu đã đọc</button>
                </div>
                <div class="notif-dropdown-body" id="notifList">
                    <div class="notif-empty" id="notifEmpty">
                        <i class="fa-regular fa-bell-slash"></i>
                        <div>Chưa có thông báo</div>
                    </div>
                </div>
                <div class="notif-dropdown-footer">
                    <a href="/tracking/comments" id="notifFooterLink">Xem tất cả scrape</a>
                </div>
            </div>
        </div>

        <!-- Theme Toggle (Light/Dark) -->
        <button class="theme-toggle" id="themeToggle" type="button" aria-label="Toggle theme" title="Toggle light/dark mode">
            <i class="fa-solid fa-sun theme-toggle__icon theme-toggle__sun" aria-hidden="true"></i>
            <i class="fa-solid fa-moon theme-toggle__icon theme-toggle__moon" aria-hidden="true"></i>
        </button>

        <!-- Language Switcher -->
        <div class="language-switcher" id="languageSwitcher">
            <button class="language-switcher__btn" id="languageSwitcherBtn" type="button" aria-label="<%= t('header.language') %>">
                <span class="language-flag" data-lang="<%= lang || 'vi' %>">
                    <% if ((lang || 'vi') === 'vi') { %>
                        <span class="flag flag-vn" title="Tiếng Việt"></span>
                    <% } else { %>
                        <span class="flag flag-us" title="English"></span>
                    <% } %>
                </span>
                <span class="language-code"><%= ((lang || 'vi') === 'vi') ? 'VI' : 'EN' %></span>
                <i class="fa-solid fa-chevron-down language-chevron"></i>
            </button>
            <div class="language-switcher__menu" id="languageMenu">
                <button class="language-option <%= (lang || 'vi') === 'vi' ? 'is-active' : '' %>" data-lang="vi" type="button">
                    <span class="flag flag-vn"></span>
                    <span class="language-option__info">
                        <strong>Tiếng Việt</strong>
                        <small>Vietnamese</small>
                    </span>
                    <% if ((lang || 'vi') === 'vi') { %><i class="fa-solid fa-check"></i><% } %>
                </button>
                <button class="language-option <%= lang === 'en' ? 'is-active' : '' %>" data-lang="en" type="button">
                    <span class="flag flag-us"></span>
                    <span class="language-option__info">
                        <strong>English</strong>
                        <small>Tiếng Anh</small>
                    </span>
                    <% if (lang === 'en') { %><i class="fa-solid fa-check"></i><% } %>
                </button>
            </div>
        </div>

        <div class="nav-profile">
            <div class="profile-dropdown-wrapper">
                <button class="avatar-btn" id="avatarBtn" aria-haspopup="true" aria-expanded="false">
                    <% if (typeof user !== 'undefined' && user && user.avatarUrl) { %>
                        <img src="<%= user.avatarUrl %>" alt="Avatar" class="avatar-img">
                    <% } else { %>
                        <span><%= typeof user !== 'undefined' && user ? user.username.substring(0,2).toUpperCase() : 'AD' %></span>
                    <% } %>
                </button>

                <div class="dropdown-menu" id="profileDropdown">
                    <div class="dropdown-user-info">
                        <div class="dropdown-user-avatar">
                            <% if (typeof user !== 'undefined' && user && user.avatarUrl) { %>
                                <img src="<%= user.avatarUrl %>" alt="Avatar">
                            <% } else { %>
                                <span><%= typeof user !== 'undefined' && user ? user.username.substring(0,2).toUpperCase() : 'AD' %></span>
                            <% } %>
                        </div>
                        <div class="dropdown-user-text">
                            <h4><%= typeof user !== 'undefined' && user ? user.username : 'Admin' %></h4>
                            <p><%= typeof user !== 'undefined' && user ? user.email : '' %></p>
                        </div>
                    </div>
                    <div class="dropdown-divider"></div>
                    <a href="/auth/profile" class="dropdown-item">
                        <i class="fa-solid fa-user-gear"></i>
                        <span>Tài khoản cá nhân</span>
                    </a>
                    <a href="/auth/change-password" class="dropdown-item">
                        <i class="fa-solid fa-key"></i>
                        <span>Đổi mật khẩu</span>
                    </a>
                    <div class="dropdown-divider"></div>
                    <a href="/auth/logout" class="dropdown-item dropdown-item--logout">
                        <i class="fa-solid fa-arrow-right-from-bracket"></i>
                        <span>Đăng xuất</span>
                    </a>
                </div>
            </div>
        </div>
    </div>
</nav>
<link rel="stylesheet" href="/css/toast.css">
<style>
    .notif-bell-btn {
        position: relative;
        width: 40px; height: 40px;
        border: none; background: transparent;
        border-radius: 10px; cursor: pointer;
        color: #4b5563; font-size: 17px;
        display: flex; align-items: center; justify-content: center;
        transition: background .15s, color .15s;
    }
    .notif-bell-btn:hover { background: #f0f2f5; color: #1877f2; }
    .notif-bell-btn.has-new { animation: bellShake 0.6s ease-in-out; color: #1877f2; }
    @keyframes bellShake { 0%,100%{transform:rotate(0)} 20%{transform:rotate(-15deg)} 40%{transform:rotate(12deg)} 60%{transform:rotate(-8deg)} 80%{transform:rotate(4deg)} }
    .notif-badge {
        position: absolute; top: 4px; right: 4px;
        min-width: 18px; height: 18px;
        background: #ef4444; color: #fff;
        border-radius: 999px;
        font-size: 10px; font-weight: 700;
        display: flex; align-items: center; justify-content: center;
        padding: 0 5px;
        border: 2px solid #fff;
        box-shadow: 0 1px 3px rgba(239,68,68,.4);
    }
    .notif-dropdown {
        position: absolute;
        top: calc(100% + 8px);
        right: 0;
        width: 360px;
        max-height: 480px;
        background: #fff;
        border-radius: 12px;
        box-shadow: 0 10px 40px rgba(0,0,0,.15);
        border: 1px solid #eef0f3;
        overflow: hidden;
        z-index: 9999;
        animation: dropIn .2s ease-out;
    }
    @keyframes dropIn { from {opacity:0;transform:translateY(-8px);} to {opacity:1;transform:translateY(0);} }
    .notif-dropdown-header {
        padding: 14px 16px;
        border-bottom: 1px solid #f0f2f5;
        display: flex; justify-content: space-between; align-items: center;
        background: linear-gradient(135deg, #f0f4ff, #f8f9fa);
    }
    .notif-dropdown-body {
        max-height: 340px;
        overflow-y: auto;
    }
    .notif-dropdown-footer {
        padding: 10px 16px;
        border-top: 1px solid #f0f2f5;
        background: #fafbfc;
        text-align: center;
    }
    .notif-dropdown-footer a {
        color: #1877f2;
        text-decoration: none;
        font-size: 12.5px;
        font-weight: 500;
    }
    .notif-dropdown-footer a:hover { text-decoration: underline; }
    .notif-item {
        display: flex;
        gap: 12px;
        padding: 12px 16px;
        border-bottom: 1px solid #f5f6f8;
        cursor: pointer;
        transition: background .15s;
        position: relative;
    }
    .notif-item:hover { background: #f8f9fa; }
    .notif-item.unread { background: #f0f4ff; }
    .notif-item.unread:hover { background: #e6edff; }
    .notif-item-icon {
        width: 36px; height: 36px;
        border-radius: 50%;
        display: flex; align-items: center; justify-content: center;
        flex-shrink: 0;
        font-size: 14px;
        color: #fff;
    }
    .notif-item-icon.success { background: linear-gradient(135deg,#16a34a,#4ade80); }
    .notif-item-icon.error   { background: linear-gradient(135deg,#b91c1c,#f87171); }
    .notif-item-icon.running { background: linear-gradient(135deg,#1877f2,#42a5f5); }
    .notif-item-icon.warning { background: linear-gradient(135deg,#f59e0b,#fbbf24); }
    .notif-item-content { flex: 1; min-width: 0; }
    .notif-item-title { font-size: 13px; font-weight: 600; color: #1c1e21; margin-bottom: 2px; }
    .notif-item-text { font-size: 12px; color: #4b5563; line-height: 1.4; word-break: break-word; }
    .notif-item-time { font-size: 11px; color: #9ca3af; margin-top: 4px; }
    .notif-item-unread-dot {
        position: absolute;
        top: 16px; right: 12px;
        width: 8px; height: 8px;
        background: #1877f2;
        border-radius: 50%;
    }
    .notif-empty {
        padding: 40px 20px;
        text-align: center;
        color: #9ca3af;
    }
    .notif-empty i { font-size: 36px; margin-bottom: 8px; }
</style>
<script src="/js/notification-bell.js"></script>
<!-- Device tracking -->
<script src="/js/device.js"></script>