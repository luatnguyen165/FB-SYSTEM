<%
    const feat = typeof features !== 'undefined' ? features : {};
    const isAdmin = typeof user !== 'undefined' && user && user.role === 'admin';
%>
<aside class="sidebar" id="sidebar">
    <div class="sidebar-brand">
        <i class="fa-solid fa-bolt"></i>
        <span>ReelsFlow AI</span>
        <button class="sidebar-close-btn" id="sidebarCloseBtn">
            <i class="fa-solid fa-xmark"></i>
        </button>
    </div>

    <ul class="sidebar-menu">
        <!-- 🏠 TỔNG QUAN -->
        <% if (feat.dashboard !== false) { %>
        <li class="menu-item <%= currentPage === 'dashboard' ? 'active' : '' %>">
            <a href="/dashboard"><i class="fa-solid fa-gauge-high"></i>Tổng Quan</a>
        </li>
        <% } %>

        <!-- 🔗 KẾT NỐI TÀI KHOẢN -->
        <% if (feat.channels !== false) { %>
        <%
            const chs = typeof channels !== 'undefined' ? channels : [];

            // Group channels by platform
            const platformOrder = ['FB', 'TT', 'IG', 'YT', 'PI', 'TH'];
            const platformLabels = { FB: 'Facebook', TT: 'TikTok', IG: 'Instagram', YT: 'YouTube', PI: 'Pinterest', TH: 'Threads' };
            const platformIcons = { FB: 'fa-facebook', TT: 'fa-tiktok', IG: 'fa-instagram', YT: 'fa-youtube', PI: 'fa-pinterest', TH: 'fa-threads' };
            const platformColors = { FB: 'var(--fb-color)', TT: 'var(--tt-color)', IG: 'var(--ig-color)', YT: 'var(--yt-color)', PI: 'var(--pi-color)', TH: 'var(--th-color)' };

            const chsByPlatform = {};
            chs.forEach(function(ch) {
                if (!chsByPlatform[ch.platform]) chsByPlatform[ch.platform] = [];
                chsByPlatform[ch.platform].push(ch);
            });
        %>
        <li class="sidebar-group accounts-group<%= currentPage === 'channels' ? ' is-open' : '' %>" data-sidebar-group-id="accounts">
            <button
                type="button"
                class="sidebar-group-toggle account-group-toggle"
                data-sidebar-group-toggle="accounts"
                aria-expanded="<%= currentPage === 'channels' ? 'true' : 'false' %>"
            >
                <span class="sidebar-group-toggle__label">
                    <i class="fa-solid fa-plug"></i>
                    Kết Nối Tài Khoản
                </span>
                <i class="fa-solid fa-chevron-down sidebar-group-chevron"></i>
            </button>
            <ul class="sidebar-submenu">
                <% platformOrder.forEach(function(pl) { %>
                <% var plChs = chsByPlatform[pl] || []; %>
                <li class="menu-item channel-item <%= currentPage === 'channels' && (typeof activePlatform !== 'undefined' && activePlatform === pl) ? 'active' : '' %>">
                    <a href="/channels?platform=<%= pl %>" class="channel-link platform-link">
                        <span class="platform-icon" style="color:<%= platformColors[pl] %>;">
                            <i class="fa-brands <%= platformIcons[pl] %>"></i>
                        </span>
                        <span class="channel-name"><%= platformLabels[pl] %></span>
                        <% if (plChs.length > 0) { %>
                            <span class="channel-count"><%= plChs.length %></span>
                        <% } %>
                    </a>
                </li>
                <% }); %>
            </ul>
        </li>
        <% } %>

        <!-- 📦 SẢN PHẨM -->
        <% if (feat.shopeeLink !== false) { %>
        <li class="menu-item <%= currentPage === 'shopeeLink' ? 'active' : '' %>">
            <a href="/shopee"><i class="fa-solid fa-bag-shopping"></i>Sản Phẩm & Link Aff</a>
        </li>
        <% } %>

        <!-- ✍️ AI VIẾT BÀI -->

        <!-- 📅 LÊN LỊCH ĐĂNG BÀI -->
        <li class="menu-section-title"><i class="fa-solid fa-calendar-check"></i>Lên Lịch & Đăng Bài</li>

        <% if (feat['schedule-manager'] !== false || feat['schedule-post'] !== false || feat['schedule-reels'] !== false || feat['schedule-archive'] !== false) { %>
        <%
            const schedulePages = ['schedule-manager', 'schedule-post', 'schedule-reels', 'schedule-archive'];
            const isScheduleOpen = schedulePages.includes(currentPage);
        %>
        <li class="sidebar-group<%= isScheduleOpen ? ' is-open' : '' %>" data-sidebar-group-id="schedule">
            <button
                type="button"
                class="sidebar-group-toggle"
                data-sidebar-group-toggle="schedule"
                aria-expanded="<%= isScheduleOpen ? 'true' : 'false' %>"
            >
                <span class="sidebar-group-toggle__label">
                    <i class="fa-solid fa-calendar-days"></i>
                    Quản Lý Lịch Đăng
                </span>
                <i class="fa-solid fa-chevron-down sidebar-group-chevron"></i>
            </button>
            <ul class="sidebar-submenu">
                <% if (feat['schedule-manager'] !== false) { %>
                <li class="menu-item <%= currentPage === 'schedule-manager' ? 'active' : '' %>">
                    <a href="/schedule/manager"><i class="fa-solid fa-list-check"></i>Tổng Quan Lịch</a>
                </li>
                <% } %>
                <% if (feat['schedule-post'] !== false) { %>
                <li class="menu-item <%= currentPage === 'schedule-post' ? 'active' : '' %>">
                    <a href="/schedule/post"><i class="fa-solid fa-image"></i>Đăng Bài Hình Ảnh</a>
                </li>
                <% } %>
                <% if (feat['schedule-reels'] !== false) { %>
                <li class="menu-item <%= currentPage === 'schedule-reels' ? 'active' : '' %>">
                    <a href="/schedule/reels"><i class="fa-solid fa-clapperboard"></i>Đăng Reels / Video</a>
                </li>
                <% } %>
                <% if (feat['schedule-archive'] !== false) { %>
                <li class="menu-item <%= currentPage === 'schedule-archive' ? 'active' : '' %>">
                    <a href="/schedule/archive"><i class="fa-solid fa-clock-rotate-left"></i>Lịch Sử Đăng</a>
                </li>
                <% } %>
            </ul>
        </li>
        <% } %>

        <!-- 🤖 AI MARKETING -->
        <li class="menu-section-title"><i class="fa-solid fa-robot"></i>AI Marketing Tự Động</li>

        <% if (feat['ai-scan'] !== false || feat['ai-comments'] !== false || feat['comment-play'] !== false || feat['schedule-groups'] !== false) { %>
        <%
            const aiMarketingPages = ['ai-scan', 'ai-comments', 'comment-play', 'schedule-groups'];
            const isAiMarketingOpen = aiMarketingPages.includes(currentPage);
        %>
        <li class="sidebar-group<%= isAiMarketingOpen ? ' is-open' : '' %>" data-sidebar-group-id="ai-marketing">
            <button
                type="button"
                class="sidebar-group-toggle"
                data-sidebar-group-toggle="ai-marketing"
                aria-expanded="<%= isAiMarketingOpen ? 'true' : 'false' %>"
            >
                <span class="sidebar-group-toggle__label">
                    <i class="fa-solid fa-bullseye"></i>
                    AI Tìm Khách & Tương Tác
                </span>
                <i class="fa-solid fa-chevron-down sidebar-group-chevron"></i>
            </button>
            <ul class="sidebar-submenu">
                <% if (feat['ai-scan'] !== false) { %>
                <li class="menu-item <%= currentPage === 'ai-scan' ? 'active' : '' %>">
                    <a href="/schedule/ai-scan"><i class="fa-solid fa-magnifying-glass-plus"></i>Quét Khách Có Nhu Cầu</a>
                </li>
                <% } %>
                <% if (feat['ai-comments'] !== false) { %>
                <li class="menu-item <%= currentPage === 'ai-comments' ? 'active' : '' %>">
                    <a href="/schedule/ai-comments"><i class="fa-solid fa-comments"></i>Thư Viện Bình Luận</a>
                </li>
                <% } %>
                <% if (feat['comment-play'] !== false) { %>
                <li class="menu-item <%= currentPage === 'comment-play' ? 'active' : '' %>">
                    <a href="/schedule/ai-comment/play"><i class="fa-solid fa-bolt"></i>Lịch Trình Comment Tự Động</a>
                </li>
                <% } %>
                <% if (feat['schedule-groups'] !== false) { %>
                <li class="menu-item <%= currentPage === 'schedule-groups' ? 'active' : '' %>">
                    <a href="/schedule/groups"><i class="fa-solid fa-users-rectangle"></i>Tìm Nhóm FB Tiềm Năng</a>
                </li>
                <% } %>
            </ul>
        </li>
        <% } %>

        <!-- 🎯 NGHIÊN CỨU ĐỐI THỦ -->
        <% if (feat.tracking !== false) { %>
        <%
            const trackingPages = ['tracking-profile', 'tracking-page', 'tracking-group'];
            const isTrackingOpen = trackingPages.includes(currentPage);
        %>
        <li class="sidebar-group<%= isTrackingOpen ? ' is-open' : '' %>" data-sidebar-group-id="tracking">
            <button
                type="button"
                class="sidebar-group-toggle"
                data-sidebar-group-toggle="tracking"
                aria-expanded="<%= isTrackingOpen ? 'true' : 'false' %>"
            >
                <span class="sidebar-group-toggle__label">
                    <i class="fa-solid fa-binoculars"></i>
                    Theo Dõi Đối Thủ
                </span>
                <i class="fa-solid fa-chevron-down sidebar-group-chevron"></i>
            </button>
            <ul class="sidebar-submenu">
                <li class="menu-item <%= currentPage === 'tracking-profile' ? 'active' : '' %>">
                    <a href="/tracking?type=profile"><i class="fa-solid fa-user"></i>Theo Dõi Cá Nhân</a>
                </li>
                <li class="menu-item <%= currentPage === 'tracking-page' ? 'active' : '' %>">
                    <a href="/tracking?type=page"><i class="fa-solid fa-flag"></i>Theo Dõi Fanpage</a>
                </li>
                <li class="menu-item <%= currentPage === 'tracking-group' ? 'active' : '' %>">
                    <a href="/tracking?type=group"><i class="fa-solid fa-users"></i>Theo Dõi Nhóm</a>
                </li>
            </ul>
        </li>
        <% } %>

        <!-- 📊 THU THẬP DỮ LIỆU -->
        <% if (feat['comment-crawler'] !== false) { %>
        <%
            const dataCollectionPages = ['comment-crawler', 'tiktok-tracker', 'douyin-tracker'];
            const isDataCollectionOpen = dataCollectionPages.includes(currentPage);
        %>
        <li class="sidebar-group<%= isDataCollectionOpen ? ' is-open' : '' %>" data-sidebar-group-id="data-collection">
            <button
                type="button"
                class="sidebar-group-toggle"
                data-sidebar-group-toggle="data-collection"
                aria-expanded="<%= isDataCollectionOpen ? 'true' : 'false' %>"
            >
                <span class="sidebar-group-toggle__label">
                    <i class="fa-solid fa-database"></i>
                    Thu Thập Dữ Liệu
                </span>
                <i class="fa-solid fa-chevron-down sidebar-group-chevron"></i>
            </button>
            <ul class="sidebar-submenu">
                <li class="menu-item <%= currentPage === 'comment-crawler' ? 'active' : '' %>">
                    <a href="/tracking/comments"><i class="fa-brands fa-facebook-messenger"></i>FB Comment Crawler</a>
                </li>
                <li class="menu-item <%= currentPage === 'tiktok-tracker' ? 'active' : '' %>">
                    <a href="/tiktok-tracker"><i class="fa-brands fa-tiktok"></i>TikTok Tracker</a>
                </li>
                <li class="menu-item <%= currentPage === 'douyin-tracker' ? 'active' : '' %>">
                    <a href="/douyin-tracker"><i class="fa-solid fa-music"></i>Douyin Tracker</a>
                </li>
            </ul>
        </li>
        <% } %>

        <!-- 🎬 VIDEO DUBBING -->
        <% if (feat['video-dubbing'] !== false) { %>
        <li class="menu-item <%= currentPage === 'video-dubbing' ? 'active' : '' %>">
            <a href="/video-dubbing"><i class="fa-solid fa-language"></i>Video Dubbing</a>
        </li>
        <% } %>

        <!-- 🐛 VIDEO BUGGING -->
        <li class="menu-item <%= currentPage === 'video-bugs' ? 'active' : '' %>">
            <a href="/video-bugs"><i class="fa-solid fa-bug"></i>Video Bugging</a>
        </li>

        <!-- 🛡️ BYPASS REPORT -->
        <li class="menu-item <%= currentPage === 'bypass-report' ? 'active' : '' %>">
            <a href="/bypass-report"><i class="fa-solid fa-shield-halved"></i>Bypass Report</a>
        </li>

        <!-- 💬 HỖ TRỢ -->
        <% if (feat.feedback !== false) { %>
        <li class="menu-item <%= currentPage === 'feedback' ? 'active' : '' %>">
            <a href="/feedback"><i class="fa-solid fa-comments"></i>Góp Ý & Yêu Cầu</a>
        </li>
        <% } %>

        <!-- ⚙️ HỆ THỐNG -->
        <li class="menu-section-title"><i class="fa-solid fa-gear"></i>Hệ Thống</li>
        <% if (feat.settings !== false) { %>
        <li class="menu-item <%= currentPage === 'settings' ? 'active' : '' %>">
            <a href="/settings"><i class="fa-solid fa-sliders"></i>Cài Đặt Chung</a>
        </li>
        <% } %>

        <% if (isAdmin) { %>
        <li class="menu-item <%= currentPage === 'feature-visibility' ? 'active' : '' %>">
            <a href="/features"><i class="fa-solid fa-toggle-on"></i>Quản Lý Tính Năng</a>
        </li>
        <% } %>
    </ul>
</aside>
