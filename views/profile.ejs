<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="UTF-8">
    <title>Tài Khoản Cá Nhân - ReelsFlow AI</title>
    <link rel="stylesheet" href="/css/base.css">
    <link rel="stylesheet" href="/css/style.css">
    <link rel="stylesheet" href="/css/profile.css">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <!-- Biểu tượng và Phông chữ chuẩn -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.6.0/css/all.min.css">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
</head>
<body data-flash-message='<%- typeof flash !== "undefined" && flash ? JSON.stringify(flash.message) : "" %>' data-flash-type="<%= typeof flash !== 'undefined' && flash ? (flash.type === 'success' ? 'success' : flash.type === 'warning' ? 'warning' : 'error') : '' %>">
    <%- include('partials/sidebar', { currentPage: 'profile' }) %>
    <div class="main-content">
        <%- include('partials/header') %>
        <div class="content-body">
            <div class="container">
                <%- include('partials/welcome-section', {
                    eyebrow: 'Tài khoản cá nhân',
                    title: 'Thông tin cá nhân',
                    description: 'Cập nhật họ tên, số điện thoại và thông tin liên hệ để hệ thống gửi thông báo chính xác.'
                }) %>
                <div class="page-layout">
                    <nav class="settings-nav">
                        <a href="/auth/profile" class="nav-item active">
                            <i class="fa-regular fa-user"></i> Hồ sơ cá nhân
                        </a>
                        <a href="/auth/change-password" class="nav-item">
                            <i class="fa-solid fa-key"></i> Đổi mật khẩu
                        </a>
                    </nav>
                    <div class="card-form">
                        <h2 class="section-title">Thông tin cá nhân</h2>
                        <p class="section-desc">Cập nhật thông tin cơ bản của bạn để tiện trao đổi thông báo hệ thống.</p>
                        <form method="post" action="/auth/profile" enctype="multipart/form-data">
                            <div class="avatar-upload-card">
                                <div class="avatar-preview-wrapper">
                                    <% if (user.avatarUrl) { %>
                                        <img src="<%= user.avatarUrl %>" alt="Avatar" id="avatarPreview" class="avatar-preview-img">
                                    <% } else { %>
                                        <div class="avatar-preview-fallback" id="avatarPreview"> <%= user.username ? user.username.substring(0,2).toUpperCase() : 'AD' %> </div>
                                    <% } %>
                                </div>
                                <div class="avatar-upload-copy">
                                    <h3>Ảnh đại diện</h3>
                                    <p>Tải lên ảnh JPG, PNG hoặc WEBP để cá nhân hoá tài khoản của bạn.</p>
                                    <label class="avatar-upload-btn" for="avatarInput">
                                        <i class="fa-regular fa-image"></i> Chọn ảnh mới
                                    </label>
                                    <input type="file" id="avatarInput" name="avatar" accept="image/*" hidden>
                                </div>
                            </div>
                            <div class="form-row">
                                <div class="form-group">
                                    <label>HỌ VÀ TÊN</label>
<input type="text" class="input" name="username" value="<%= user.username %>">
                                </div>
                                <div class="form-group">
                                    <label>SỐ ĐIỆN THOẠI</label>
<input type="text" class="input" name="phoneNumber" value="<%= user.phoneNumber %>" placeholder="Nhập số điện thoại">
                                </div>
                            </div>
                            <div class="form-group">
                                <label>ĐỊA CHỈ EMAIL (KHÔNG THỂ THAY ĐỔI)</label>
<input type="email" class="input" name="email" value="<%= user.email %>" disabled>
                            </div>
                            <div class="form-group">
                                <label>LOẠI TÀI KHOẢN VIP</label>
                                <input type="text" class="input" value="Premium - Hạn dùng: Vô thời hạn" disabled>
                            </div>
                            <button type="submit" class="btn-save">Lưu thay đổi</button>
                        </form>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <script src="/js/toast.js"></script>
    <script src="/js/base.js"></script>
    <script src="/js/utils.js"></script>
    <script>
        (function () {
            const message = document.body.dataset.flashMessage;
            const type = document.body.dataset.flashType;
            if (message) showToast(message, type || 'info');
        })();

        (function () {
            const avatarInput = document.getElementById('avatarInput');
            const avatarWrapper = document.querySelector('.avatar-preview-wrapper');
            if (!avatarInput || !avatarWrapper) return;

            avatarInput.addEventListener('change', () => {
                const file = avatarInput.files?.[0];
                if (!file) return;

                const url = URL.createObjectURL(file);
                avatarWrapper.innerHTML = `<img src="${url}" alt="Avatar preview" class="avatar-preview-img" id="avatarPreview">`;
            });
        })();
    </script>
</body>
</html>    <link rel="stylesheet" href="/css/toast.css">
