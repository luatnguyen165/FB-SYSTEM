<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Lịch Reels - ReelsFlow AI</title>
    <link rel="stylesheet" href="/css/base.css">
    <link rel="stylesheet" href="/css/style.css">
    <link rel="stylesheet" href="/css/schedule-post.css">
    <link rel="stylesheet" href="/css/schedule-post-platform-picker.css">
    <link rel="stylesheet" href="/css/schedule-post-account-picker.css">
    <link rel="stylesheet" href="/css/reels.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.6.0/css/all.min.css">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
    <script src="/js/socket.io.min.js"></script>
</head>
<body>
    <%- include('partials/sidebar', { currentPage: 'schedule-reels' }) %>

    <div class="main-content">
        <%- include('partials/header') %>

        <div class="content-body">
            <%- include('partials/welcome-section', {
                eyebrow: 'Lịch Reels',
                title: 'Lập kế hoạch nội dung Reels',
                description: 'Sắp xếp lịch đăng Reels theo tháng và theo dõi chiến dịch đa kền dễ dàng hơn.',
                actionHtml: '<button class="btn-create-reels-hero" id="btnCreatePost"><i class="fa-solid fa-plus"></i> Tạo bài Reels mới</button>'
            }) %>

            <div class="schedule-overview-stats" id="scheduleOverviewStats">
                <div class="schedule-stat-card">
                    <span class="schedule-stat-card__label">Tổng lịch trong tháng</span>
                    <strong class="schedule-stat-card__value" id="statMonthlyTotal">0</strong>
                    <small class="schedule-stat-card__hint" id="statMonthlyVisible">0 lịch</small>
                </div>
                <div class="schedule-stat-card schedule-stat-card--warning">
                    <span class="schedule-stat-card__label">Chờ đăng</span>
                    <strong class="schedule-stat-card__value" id="statMonthlyPending">0</strong>
                    <small class="schedule-stat-card__hint">Lịch chưa chạy</small>
                </div>
                <div class="schedule-stat-card schedule-stat-card--success">
                    <span class="schedule-stat-card__label">Đã đăng</span>
                    <strong class="schedule-stat-card__value" id="statMonthlyPosted">0</strong>
                    <small class="schedule-stat-card__hint">Hoàn tất thành công</small>
                </div>
                <div class="schedule-stat-card schedule-stat-card--danger">
                    <span class="schedule-stat-card__label">Thất bại</span>
                    <strong class="schedule-stat-card__value" id="statMonthlyFailed">0</strong>
                    <small class="schedule-stat-card__hint">Cần kiểm tra lại</small>
                </div>
            </div>

            <div class="calendar-toolbar">
                <div class="calendar-filters">
                    <div class="filter-field">
                        <label for="scheduleStatusFilter">
                            <i class="fa-solid fa-filter"></i> Trạng thái
                        </label>
                        <select class="filter-select" id="scheduleStatusFilter">
                            <option value="all">Tất cả</option>
                            <option value="pending">Chưa đăng</option>
                            <option value="posted">Đã đăng</option>
                            <option value="failed">Thất bại</option>
                        </select>
                    </div>
                    <div class="filter-field">
                        <label for="schedulePlatformFilter">
                            <i class="fa-brands fa-meta"></i> Nền tảng
                        </label>
                        <select class="filter-select" id="schedulePlatformFilter">
                            <option value="all">Tất cả</option>
                            <option value="FR">Facebook Reels</option>
                            <option value="YS">YouTube Short</option>
                            <option value="IG">Instagram</option>
                            <option value="TT">TikTok Video</option>
                            <option value="TH">Threads Reels</option>
                            <option value="PI">Pinterest Idea Pin</option>
                        </select>
                    </div>
                    <div class="filter-field filter-field--wide">
                        <label for="scheduleKeywordFilter">
                            <i class="fa-solid fa-magnifying-glass"></i> Từ khóa caption
                        </label>
                        <input class="filter-input" id="scheduleKeywordFilter" type="search" placeholder="Nhập từ khóa để lọc caption...">
                    </div>
                    <div class="filter-field">
                        <label for="scheduleDateFilter">
                            <i class="fa-solid fa-calendar"></i> Ngày đăng
                        </label>
                        <input class="filter-input" id="scheduleDateFilter" type="date">
                    </div>
                </div>
                <button type="button" class="btn-clear-filters" id="btnClearCalendarFilters">
                    <i class="fa-solid fa-eraser"></i> Xóa lọc
                </button>
            </div>

            <div class="calendar-wrapper">
                <div class="calendar-header">
                    <div class="month-nav">
                        <button class="btn-nav" id="btnPrevMonth"><i class="fa-solid fa-chevron-left"></i></button>
                        <div class="current-month" id="currentMonthDisplay"></div>
                        <button class="btn-nav" id="btnNextMonth"><i class="fa-solid fa-chevron-right"></i></button>
                    </div>
                    <button class="btn-today" id="btnTodayReels">
                        <i class="fa-solid fa-calendar-day"></i> Hôm nay
                    </button>
                </div>

                <div class="calendar-grid" id="calendarGrid">
                    <div class="weekday-label">Thứ 2</div><div class="weekday-label">Thứ 3</div><div class="weekday-label">Thứ 4</div><div class="weekday-label">Thứ 5</div><div class="weekday-label">Thứ 6</div><div class="weekday-label">Thứ 7</div><div class="weekday-label">CN</div>
                </div>
            </div>

            <!-- Popover đặt ngoài calendar-wrapper để dùng position:fixed đúng -->
            <div class="schedule-popover" id="reelsQuickPreviewPopover" aria-hidden="true">
                <div class="schedule-popover__arrow"></div>
                <div class="schedule-popover__header">
                    <div>
                        <p class="schedule-popover__eyebrow" id="reelsPopoverEyebrow">Xem nhanh</p>
                        <h3 class="schedule-popover__title" id="reelsPopoverTitle">Chi tiết Reels</h3>
                    </div>
                    <button type="button" class="schedule-popover__close" id="btnCloseReelsPopover" aria-label="Đóng popover">
                        <i class="fa-solid fa-xmark"></i>
                    </button>
                </div>
                <div class="schedule-popover__body" id="reelsPopoverBody"></div>
            </div>
        </div>
    </div>

    <!-- Modal Tạo Reels -->
    <div class="post-modal reels-modal" id="createPostModal">
        <div class="post-modal-container">
            <!-- Form Side -->
            <div class="modal-form-side">
                <div class="form-header">
                    <div class="form-header__left">
                        <div class="form-header__icon">
                            <i class="fa-solid fa-film"></i>
                        </div>
                        <div class="form-header__text">
                            <h2 id="modalFormTitle">Tạo bài Reels mới</h2>
                            <p id="modalFormSubtitle">Đăng video Reels lên các nền tảng</p>
                        </div>
                    </div>
                    <button type="button" class="form-header__close" id="btnCloseReelsModal" aria-label="Đóng">
                        <i class="fa-solid fa-xmark"></i>
                    </button>
                </div>

                <div class="form-fields-scrollable">
                    <!-- Tiêu đề video (chỉ hiện khi chọn Pinterest Idea Pin hoặc YouTube Shorts) -->
                    <div class="form-section" id="reelsTitleSection" style="display:none;">
                        <div class="form-section__header">
                            <i class="fa-solid fa-heading"></i>
                            <span>Tiêu đề video</span>
                            <span class="form-section__required">*</span>
                        </div>
                        <input type="text" class="input-text" id="modalVideoTitleInput" maxlength="100" placeholder="VD: Sản phẩm hot tháng 6 - Giảm 50%">
                        <div class="form-section__hint">
                            <i class="fa-solid fa-info-circle"></i>
                            <strong>Bắt buộc cho Pinterest Idea Pin & YouTube Shorts.</strong> Hiển thị làm tiêu đề chính của video trên các nền tảng này.
                        </div>
                    </div>

                    <!-- Nguồn video -->
                    <div class="form-section">
                        <div class="form-section__header">
                            <i class="fa-solid fa-video"></i>
                            <span>Nguồn tệp video</span>
                        </div>
                        <div class="video-source-buttons">
                            <button type="button" class="btn-source-action active" id="btnUploadLocal">
                                <i class="fa-solid fa-laptop"></i> Chọn video từ máy tính
                            </button>
                        </div>
                        <input type="file" id="modalVideoFileSelector" accept="video/*" style="display:none">
                        <div class="selected-file-badge" id="filePickedBadge">
                            <div>
                                <i class="fa-solid fa-video" style="color:var(--primary); margin-right:6px;"></i>
                                <span id="filePickedName">Chưa chọn video</span>
                            </div>
                            <span class="file-size-text" id="filePickedSize"></span>
                        </div>
                    </div>

                    <!-- Caption -->
                    <div class="form-section">
                        <div class="form-section__header">
                            <i class="fa-solid fa-pencil"></i>
                            <span>Mô tả & hashtag</span>
                        </div>
                        <div class="caption-editor-wrap">
                            <div class="caption-editor-toolbar">
                                <button type="button" data-cmd="bold" title="Bold"><b>B</b></button>
                                <button type="button" data-cmd="italic" title="Italic"><i>I</i></button>
                                <button type="button" data-cmd="underline" title="Underline"><u>U</u></button>
                                <button type="button" data-cmd="strike" title="Strike"><s>S</s></button>
                                <span class="toolbar-sep"></span>
                                <button type="button" data-cmd="insertUnorderedList" title="Bullet list"><i class="fa-solid fa-list-ul"></i></button>
                                <button type="button" data-cmd="insertOrderedList" title="Number list"><i class="fa-solid fa-list-ol"></i></button>
                                <span class="toolbar-sep"></span>
                                <button type="button" data-cmd="createLink" title="Link"><i class="fa-solid fa-link"></i></button>
                                <button type="button" data-cmd="removeFormat" title="Xóa格式"><i class="fa-solid fa-eraser"></i></button>
                            </div>
                            <div id="modalCaptionEditor" class="caption-editor" contenteditable="true" data-placeholder="Nhập mô tả bài viết..."></div>
                        </div>
                        <input type="hidden" id="modalCaptionInput" value="">
                        <div class="form-section__hint" style="display:flex;justify-content:space-between;align-items:center;">
                            <span><i class="fa-solid fa-info-circle"></i> Mô tả cho Reels.</span>
                            <span id="captionCharCount" style="font-size:12px;color:#9ca3af;">0/1000</span>
                        </div>
                    </div>

                    <!-- Thời gian -->
                    <div class="form-section">
                        <div class="form-section__header">
                            <i class="fa-solid fa-clock"></i>
                            <span>Hẹn giờ đăng bài</span>
                        </div>
                        <div class="datetime-split">
                            <div class="datetime-field">
                                <label>Ngày</label>
                                <input type="text" class="input-text" id="modalDateInput" inputmode="numeric" autocomplete="off" placeholder="dd/mm/yyyy">
                            </div>
                            <div class="datetime-field">
                                <label>Giờ</label>
                                <input type="time" class="input-text" id="modalClockInput" step="60" value="09:00">
                            </div>
                        </div>
                        <input type="hidden" id="modalTimeInput">
                        <div class="form-section__hint">
                            <i class="fa-solid fa-info-circle"></i>
                            Định dạng: ngày/tháng/năm - giờ:phút
                        </div>
                    </div>

                    <!-- Nền tảng (Redesign 2026-06-21: card grid giống schedule-post) -->
                    <div class="form-section">
                        <div class="form-section__header">
                            <i class="fa-solid fa-share-nodes"></i>
                            <span>Nền tảng đăng tải</span>
                            <span class="platform-picker-counter" id="reelsPlatformCounter" style="display:none;">0/0 đã chọn</span>
                        </div>
                        <div class="platform-picker-grid" id="reelsPlatformPickerGrid">
                            <label class="platform-picker-card" data-platform="FR" style="--p-color: #1877F2">
                                <input type="checkbox" class="platform-check" value="FR" checked>
                                <div class="platform-picker-card__icon"><i class="fa-brands fa-facebook"></i></div>
                                <div class="platform-picker-card__body">
                                    <div class="platform-picker-card__name">Facebook Reels</div>
                                    <div class="platform-picker-card__desc">Đăng Reels lên Facebook</div>
                                </div>
                                <div class="platform-picker-card__check"><i class="fa-solid fa-check"></i></div>
                            </label>
                            <label class="platform-picker-card" data-platform="YS" style="--p-color: #FF0000">
                                <input type="checkbox" class="platform-check" value="YS">
                                <div class="platform-picker-card__icon"><i class="fa-brands fa-youtube"></i></div>
                                <div class="platform-picker-card__body">
                                    <div class="platform-picker-card__name">YouTube Short</div>
                                    <div class="platform-picker-card__desc">Đăng video Short lên kênh</div>
                                </div>
                                <div class="platform-picker-card__check"><i class="fa-solid fa-check"></i></div>
                            </label>
                            <label class="platform-picker-card" data-platform="IG" style="--p-color: #E4405F">
                                <input type="checkbox" class="platform-check" value="IG">
                                <div class="platform-picker-card__icon"><i class="fa-brands fa-instagram"></i></div>
                                <div class="platform-picker-card__body">
                                    <div class="platform-picker-card__name">Instagram</div>
                                    <div class="platform-picker-card__desc">Đăng Reels lên Instagram</div>
                                </div>
                                <div class="platform-picker-card__check"><i class="fa-solid fa-check"></i></div>
                            </label>
                            <label class="platform-picker-card" data-platform="TT" style="--p-color: #000000">
                                <input type="checkbox" class="platform-check" value="TT">
                                <div class="platform-picker-card__icon"><i class="fa-brands fa-tiktok"></i></div>
                                <div class="platform-picker-card__body">
                                    <div class="platform-picker-card__name">TikTok Video</div>
                                    <div class="platform-picker-card__desc">Đăng video lên TikTok</div>
                                </div>
                                <div class="platform-picker-card__check"><i class="fa-solid fa-check"></i></div>
                            </label>
                            <label class="platform-picker-card" data-platform="TH" style="--p-color: #000000">
                                <input type="checkbox" class="platform-check" value="TH">
                                <div class="platform-picker-card__icon"><i class="fa-brands fa-threads"></i></div>
                                <div class="platform-picker-card__body">
                                    <div class="platform-picker-card__name">Threads</div>
                                    <div class="platform-picker-card__desc">Đăng video Reels lên Threads</div>
                                </div>
                                <div class="platform-picker-card__check"><i class="fa-solid fa-check"></i></div>
                            </label>
                            <label class="platform-picker-card" data-platform="PI" style="--p-color: #E60023">
                                <input type="checkbox" class="platform-check" value="PI">
                                <div class="platform-picker-card__icon"><i class="fa-brands fa-pinterest"></i></div>
                                <div class="platform-picker-card__body">
                                    <div class="platform-picker-card__name">Pinterest</div>
                                    <div class="platform-picker-card__desc">Đăng video Idea Pin lên Board</div>
                                </div>
                                <div class="platform-picker-card__check"><i class="fa-solid fa-check"></i></div>
                            </label>
                        </div>
                    </div>

                    <!-- Tài khoản (Redesign 2026-06-21: card có avatar giống schedule-post) -->
                    <div class="form-section" id="accountPickerSection" style="display: none;">
                        <div class="form-section__header account-picker-header">
                            <i class="fa-solid fa-users"></i>
                            <span>Tài khoản đăng</span>
                            <span class="account-picker-counter" id="accountPickerCounter" style="display:none;">0/0 đã chọn</span>
                        </div>

                        <div class="account-picker-toolbar" id="accountPickerToolbar" style="display:none;">
                            <div class="account-picker-search">
                                <i class="fa-solid fa-magnifying-glass"></i>
                                <input type="text" id="accountPickerSearch" placeholder="Tìm tên tài khoản..." />
                                <button type="button" class="account-picker-search-clear" id="accountPickerSearchClear" style="display:none;">
                                    <i class="fa-solid fa-xmark"></i>
                                </button>
                            </div>
                            <button type="button" class="account-picker-action-btn" id="accountPickerSelectAll" title="Chọn tất cả">
                                <i class="fa-solid fa-check-double"></i>
                                <span>Chọn tất cả</span>
                            </button>
                        </div>

                        <div class="account-picker-empty" id="accountPickerEmpty" style="display:none;">
                            <i class="fa-solid fa-plug"></i>
                            <p>Chưa có tài khoản nào được kết nối</p>
                            <a href="/channels" class="account-picker-empty-cta">
                                <i class="fa-solid fa-plus"></i> Thêm tài khoản ngay
                            </a>
                        </div>

                        <div class="account-picker" id="dynamicAccountBox">
                            <div class="empty-state">
                                <i class="fa-solid fa-spinner fa-spin"></i>
                                <span>Đang tải tài khoản...</span>
                            </div>
                        </div>
                    </div>

                    <!-- Affiliate Links -->
                    <div class="form-section">
                        <div class="form-section__header">
                            <i class="fa-solid fa-link"></i>
                            <span>Link Affiliate</span>
                            <span class="form-section__badge form-section__badge--shopee" id="shopeeSelectedBadge">0 đã chọn</span>
                        </div>
                        <div class="affiliate-list" id="dynamicShopeeLinkBox">
                            <div class="empty-state">
                                <i class="fa-solid fa-spinner fa-spin"></i>
                                <span>Đang tải link affiliate...</span>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="action-btns-group">
                    <button type="button" class="btn-action-secondary" id="btnCancelReels">
                        <i class="fa-solid fa-ban"></i> Hủy bỏ
                    </button>
                    <button type="button" class="btn-action-danger" id="btnDeleteReels" style="display:none;">
                        <i class="fa-solid fa-trash"></i> Xóa lịch
                    </button>
                    <button class="btn-action-primary" type="button" id="btnSubmitReelsSchedule">
                        <i class="fa-solid fa-calendar-check"></i>
                        <span>Xác nhận lên lịch</span>
                    </button>
                </div>
            </div>

            <!-- Preview Side -->
            <div class="modal-preview-side reels-modal-preview">
                <div class="preview-label">
                    <i class="fa-solid fa-mobile-screen-button"></i>
                    Xem trước Reels
                </div>

                <div class="phone-stage">
                    <div class="phone-stage__glow"></div>
                    <div class="phone-mockup phone-mockup--reels reels-mode" id="phoneMockupContainer">
                        <div class="phone-frame">
                            <div class="phone-island">
                                <span class="phone-island__dot"></span>
                            </div>
                            <div class="phone-statusbar">
                                <span class="phone-statusbar__time" id="phoneStatusTime">9:41</span>
                                <span class="phone-statusbar__icons">
                                    <i class="fa-solid fa-signal"></i>
                                    <i class="fa-solid fa-wifi"></i>
                                    <i class="fa-solid fa-battery-three-quarters"></i>
                                </span>
                            </div>
                        </div>

                        <div class="phone-reels-bg" id="phoneReelsBg"></div>

                        <div class="phone-play-center-btn" id="phoneCenterPlayIcon">
                            <i class="fa-solid fa-play"></i>
                        </div>
                        <img class="phone-video-poster" id="phoneMockupPosterTag" alt="Video preview">
                        <video class="phone-video-player" id="phoneMockupVideoTag" loop playsinline preload="auto" poster=""></video>

                        <div class="phone-reels-top">
                            <div class="phone-reels-top__tabs">
                                <span>Following</span>
                                <span class="is-active">For You</span>
                            </div>
                            <span class="phone-reels-search"><i class="fa-solid fa-magnifying-glass"></i></span>
                        </div>

                        <div class="phone-reels-right">
                            <div class="phone-reels-action">
                                <span class="phone-reels-action__icon"><i class="fa-solid fa-heart"></i></span>
                                <strong>24.5K</strong>
                            </div>
                            <div class="phone-reels-action">
                                <span class="phone-reels-action__icon"><i class="fa-solid fa-comment-dots"></i></span>
                                <strong>1,208</strong>
                            </div>
                            <div class="phone-reels-action">
                                <span class="phone-reels-action__icon"><i class="fa-solid fa-paper-plane"></i></span>
                                <strong>342</strong>
                            </div>
                            <div class="phone-reels-action">
                                <span class="phone-reels-action__icon"><i class="fa-solid fa-bookmark"></i></span>
                            </div>
                            <div class="phone-reels-disc">
                                <span class="phone-reels-disc__ring"></span>
                                <span class="phone-reels-disc__core"></span>
                            </div>
                        </div>

                        <div class="phone-reels-bottom">
                            <div class="phone-reels-user">
                                <span class="phone-reels-user__avatar" id="phonePreviewPlatformAvatar">
                                    <i class="fa-brands fa-facebook"></i>
                                </span>
                                <div class="phone-reels-user__info">
                                    <strong id="phonePreviewPlatformName">Xem trước Reels</strong>
                                    <span><i class="fa-solid fa-music"></i> Âm thanh gốc • ReelsFlow AI</span>
                                </div>
                                <button type="button" class="phone-reels-follow">Follow</button>
                            </div>
                            <div class="phone-reels-caption" id="livePreviewCaption">Nội dung Reels sẽ hiển thị tại đây.</div>
                            <div class="phone-reels-progress">
                                <span></span>
                            </div>
                        </div>

                        <div class="phone-video-controls" id="phoneVideoControls">
                            <button class="phone-control-btn" id="phonePlayPauseBtn" type="button" title="Play/Pause">
                                <i class="fa-solid fa-play"></i>
                            </button>
                            <div class="phone-video-info">
                                <span id="phoneVideoTitle">Video Preview</span>
                                <span class="phone-video-duration" id="phoneVideoDuration">0:00</span>
                            </div>
                        </div>
                    </div>

                    <div class="phone-stage__platforms" id="reelsPreviewPlatformChips">
                        <span class="phone-platform-chip is-active" data-code="FR"><i class="fa-brands fa-facebook"></i></span>
                        <span class="phone-platform-chip" data-code="IG"><i class="fa-brands fa-instagram"></i></span>
                        <span class="phone-platform-chip" data-code="YS"><i class="fa-brands fa-youtube"></i></span>
                        <span class="phone-platform-chip" data-code="TT"><i class="fa-brands fa-tiktok"></i></span>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <script src="/js/toast.js"></script>
    <script>
        window.__CURRENT_USER_ID = '<%= user._id %>';
        (function() {
            function initCaptionEditor() {
                const editor = document.getElementById('modalCaptionEditor');
                const hidden = document.getElementById('modalCaptionInput');
                if (!editor || editor._initialized) return;
                editor._initialized = true;

                editor.closest('.caption-editor-wrap')?.querySelectorAll('[data-cmd]').forEach(btn => {
                    btn.addEventListener('mousedown', (e) => {
                        e.preventDefault();
                        const cmd = btn.dataset.cmd;
                        if (cmd === 'createLink') {
                            const url = prompt('Nhập URL:', 'https://');
                            if (url) document.execCommand(cmd, false, url);
                        } else {
                            document.execCommand(cmd, false, null);
                        }
                        syncEditorToHidden();
                    });
                });

                function syncEditorToHidden() {
                    const text = editor.innerText.trim();
                    if (hidden) hidden.value = text;
                    const counter = document.getElementById('captionCharCount');
                    if (counter) {
                        counter.textContent = text.length + '/1000';
                        counter.style.color = text.length > 1000 ? '#dc2626' : text.length > 900 ? '#f59e0b' : '#9ca3af';
                    }
                }

                editor.addEventListener('input', syncEditorToHidden);
                editor.addEventListener('keyup', syncEditorToHidden);
                editor.addEventListener('focus', () => { if (editor.innerText.trim() === '') editor.innerHTML = ''; });
                editor.addEventListener('blur', () => { if (editor.innerText.trim() === '') editor.innerHTML = ''; syncEditorToHidden(); });

                window.captionEditorAPI = {
                    getText: () => editor.innerText.trim(),
                    setText: (txt) => { editor.innerText = txt || ''; syncEditorToHidden(); },
                    getHTML: () => editor.innerHTML,
                    focus: () => editor.focus(),
                };
            }
            window.initCaptionEditor = initCaptionEditor;
            if (document.getElementById('modalCaptionEditor')) initCaptionEditor();
        })();
    </script>
