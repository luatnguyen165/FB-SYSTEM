<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Đăng Ký Tài Khoản - Reels Auto-Uploader</title>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
    <style>
        :root { --bg-color: #f9fafb; --form-bg: #ffffff; --text-main: #111827; --text-muted: #6b7280; --primary: #2563eb; --primary-hover: #1d4ed8; --border: #e5e7eb; --input-focus-border: #93c5fd; --shadow-card: 0 10px 15px -3px rgba(0, 0, 0, 0.1), 0 4px 6px -2px rgba(0, 0, 0, 0.05); }
        * { box-sizing: border-box; margin: 0; padding: 0; font-family: 'Inter', sans-serif; }
        body { background-color: var(--bg-color); min-height: 100vh; display: flex; align-items: center; justify-content: center; padding: 20px; color: var(--text-main); }
        .auth-card { width: 100%; max-width: 440px; background-color: var(--form-bg); border-radius: 16px; padding: 40px; box-shadow: var(--shadow-card); border: 1px solid var(--border); }
        .header { text-align: center; margin-bottom: 28px; }
        .logo { font-size: 2rem; color: var(--primary); margin-bottom: 12px; display: inline-block; }
        .title { font-size: 1.5rem; font-weight: 700; margin-bottom: 8px; letter-spacing: -0.5px; }
        .desc { font-size: 0.925rem; color: var(--text-muted); }
        .form-group { margin-bottom: 18px; }
        .label { display: block; font-size: 0.85rem; font-weight: 500; margin-bottom: 8px; }
        .input-wrapper { position: relative; }
        .input-icon { position: absolute; left: 14px; top: 50%; transform: translateY(-50%); color: var(--text-muted); font-size: 1rem; }
        .input { width: 100%; padding: 12px 14px 12px 42px; background-color: #fff; border: 1px solid var(--border); border-radius: 8px; font-size: 0.95rem; color: var(--text-main); transition: all 0.2s ease; }
        .input:focus { outline: none; border-color: var(--input-focus-border); box-shadow: 0 0 0 3px rgba(37, 99, 235, 0.1); }
        .policy { display: flex; align-items: flex-start; gap: 10px; font-size: 0.85rem; color: var(--text-muted); margin: 20px 0; cursor: pointer; line-height: 1.4; }
        .policy input { accent-color: var(--primary); width: 16px; height: 16px; margin-top: 2px; }
        .policy a { color: var(--primary); text-decoration: none; }
        .btn-submit { width: 100%; padding: 12px; background-color: var(--primary); color: white; border: none; border-radius: 8px; font-size: 0.95rem; font-weight: 600; cursor: pointer; transition: background-color 0.2s; }
        .btn-submit:hover { background-color: var(--primary-hover); }
        .footer { text-align: center; margin-top: 28px; font-size: 0.875rem; color: var(--text-muted); }
        .footer a { color: var(--primary); text-decoration: none; font-weight: 600; }
        @media (max-width: 480px) { .auth-card { padding: 30px 20px; border: none; box-shadow: none; background: transparent; } }
        
   </style>
</head>
<body data-flash-message='<%- typeof flash !== "undefined" && flash ? JSON.stringify(flash.message) : "" %>' data-flash-type="<%= typeof flash !== 'undefined' && flash ? (flash.type === 'success' ? 'success' : flash.type === 'warning' ? 'warning' : 'error') : '' %>">

    <div class="auth-card">
        <div class="header">
            <div class="logo"><i class="fa-solid fa-user-plus"></i></div>
            <h1 class="title">Bắt đầu trải nghiệm</h1>
            <p class="desc">Tạo tài khoản và tối ưu hóa việc đăng Reels.</p>
        </div>
        <form method="POST" action="/auth/register">
            <div class="form-group">
                <label class="label">HỌ VÀ TÊN</label>
                <div class="input-wrapper">
                    <i class="fa-regular fa-user input-icon"></i>
                    <input type="text" name="username" class="input" placeholder="Nguyễn Văn A" required>
                </div>
            </div>

            <div class="form-group">
                <label class="label">ĐỊA CHỈ EMAIL</label>
                <div class="input-wrapper">
                    <i class="fa-regular fa-envelope input-icon"></i>
                    <input type="email" name="email" class="input" placeholder="ten@email.com" required>
                </div>
            </div>

            <div class="form-group">
                <label class="label">MẬT KHẨU</label>
                <div class="input-wrapper">
                    <i class="fa-solid fa-lock input-icon"></i>
                    <input type="password" name="password" class="input" placeholder="Ít nhất 8 ký tự" minlength="8" required>
                </div>
            </div>

            <div class="form-group">
                <label class="label">LICENSE KEY <span style="color:#dc3545;">*</span></label>
                <div class="input-wrapper">
                    <i class="fa-solid fa-key input-icon"></i>
                    <input type="text" name="licenseKey" class="input" placeholder="FB-XXXX-XXXX-XXXX" required>
                </div>
                <small style="color: var(--text-muted); display: block; margin-top: 4px;">
                    Nhập license key được cung cấp bởi admin. Nếu chưa có, <a href="#" onclick="alert('Vui lòng liên hệ admin để mua license key!'); return false;">liên hệ admin</a>.
                </small>
            </div>

            <label class="policy">
                <input type="checkbox" required>
                <span>Tôi đồng ý với <a href="#">Điều khoản dịch vụ</a> và xác nhận tuân thủ <a href="#">Chính sách bảo mật</a> dữ liệu.</span>
            </label>

            <button type="submit" class="btn-submit" id="registerBtn">Đăng Ký Tài Khoản</button>
        </form>

        <div class="footer">
            Đã có tài khoản? <a href="/auth/login">Đăng nhập ngay</a>
        </div>
    </div>

    <script>
    // Auto-uppercase license key input
    document.querySelector('input[name="licenseKey"]').addEventListener('input', function() {
        this.value = this.value.toUpperCase();
    });
    </script>
    <script src="/js/toast.js"></script>
</body>
</html>    <link rel="stylesheet" href="/css/toast.css">
