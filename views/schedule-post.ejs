<!DOCTYPE html>
<html lang="vi">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Lịch Post ảnh - ReelsFlow AI</title>
    <link rel="stylesheet" href="/css/base.css">
    <link rel="stylesheet" href="/css/style.css">
    <link rel="stylesheet" href="/css/schedule-post.css">
    <link rel="stylesheet" href="/css/ai-scan.css?v=20260703">
    <link rel="stylesheet" href="/css/schedule-post-target-tabs.css">
    <link rel="stylesheet" href="/css/schedule-post-modal.css">
    <link rel="stylesheet" href="/css/ai-content-base.css">
    <link rel="stylesheet" href="/css/ai-content-cards.css">
    <link rel="stylesheet" href="/css/ai-content-modal.css">
    <link rel="stylesheet" href="/css/ai-content-schedule.css">
    <link rel="stylesheet" href="/css/ai-content-responsive.css">
    <link rel="stylesheet" href="/css/toast.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.6.0/css/all.min.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/Swiper/11.0.5/swiper-bundle.min.css">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
    <script src="/js/socket.io.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/fuse.js@7.0.0"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/Swiper/11.0.5/swiper-bundle.min.js"></script>
</head>

<body>
<%- include('partials/sidebar', { currentPage: 'schedule-post' }) %>

<div class="main-content">
    <%- include('partials/header') %>

    <div class="content-body">
        <%- include('partials/welcome-section', {
            eyebrow: 'Lịch Post ảnh',
            title: 'Lập kế hoạch bài đăng hình ảnh',
            description: 'Quản lý lịch đăng album ảnh, caption và nền tảng phân phối trong một giao diện trực quan.',
            actionHtml: '<button class="btn-create-post-hero" id="btnCreatePost"><i class="fa-solid fa-plus"></i> Tạo bài Post mới</button>'
        }) %>

        <div class="schedule-overview-stats" id="scheduleOverviewStats">
            <div class="schedule-stat-card">
                <div class="schedule-stat-card__icon">
                    <i class="fa-solid fa-calendar-days"></i>
                </div>
                <div class="schedule-stat-card__content">
                    <span class="schedule-stat-card__label">Tổng lịch tháng</span>
                    <strong class="schedule-stat-card__value" id="statMonthlyTotal">0</strong>
                </div>
                <small class="schedule-stat-card__hint" id="statMonthlyVisible">0 lịch</small>
            </div>
            <div class="schedule-stat-card schedule-stat-card--pending">
                <div class="schedule-stat-card__icon">
                    <i class="fa-solid fa-clock"></i>
                </div>
                <div class="schedule-stat-card__content">
                    <span class="schedule-stat-card__label">Chờ đăng</span>
                    <strong class="schedule-stat-card__value" id="statMonthlyPending">0</strong>
                </div>
                <small class="schedule-stat-card__hint">Sẵn sàng</small>
            </div>
            <div class="schedule-stat-card schedule-stat-card--success">
                <div class="schedule-stat-card__icon">
                    <i class="fa-solid fa-check-circle"></i>
                </div>
                <div class="schedule-stat-card__content">
                    <span class="schedule-stat-card__label">Đã đăng</span>
                    <strong class="schedule-stat-card__value" id="statMonthlyPosted">0</strong>
                </div>
                <small class="schedule-stat-card__hint">Thành công</small>
            </div>
            <div class="schedule-stat-card schedule-stat-card--danger">
                <div class="schedule-stat-card__icon">
                    <i class="fa-solid fa-circle-exclamation"></i>
                </div>
                <div class="schedule-stat-card__content">
                    <span class="schedule-stat-card__label">Thất bại</span>
                    <strong class="schedule-stat-card__value" id="statMonthlyFailed">0</strong>
                </div>
                <small class="schedule-stat-card__hint">Cần kiểm tra</small>
            </div>
        </div>

        <div class="calendar-toolbar">
            <div class="calendar-filters">
                <div class="filter-field">
                    <label for="scheduleStatusFilter">
                        <i class="fa-solid fa-filter"></i> Trạng thái
                    </label>
                    <select class="filter-select" id="scheduleStatusFilter">
                        <option value="all">Tất cả</option>
                        <option value="pending">Chưa đăng</option>
                        <option value="posted">Đã đăng</option>
                        <option value="failed">Thất bại</option>
                    </select>
                </div>
                <div class="filter-field">
                    <label for="schedulePlatformFilter">
                        <i class="fa-brands fa-meta"></i> Nền tảng
                    </label>
                    <select class="filter-select" id="schedulePlatformFilter">
                        <option value="all">Tất cả</option>
                        <option value="FB">Facebook</option>
                        <option value="IG">Instagram</option>
                        <option value="YT">YouTube</option>
                    </select>
                </div>
                <div class="filter-field filter-field--wide">
                    <label for="scheduleKeywordFilter">
                        <i class="fa-solid fa-magnifying-glass"></i> Từ khóa
                    </label>
                    <input class="filter-input" id="scheduleKeywordFilter" type="search" placeholder="Tìm caption...">
                </div>
                <div class="filter-field">
                    <label for="scheduleDateFilter">
                        <i class="fa-solid fa-calendar"></i> Ngày
                    </label>
                    <input class="filter-input" id="scheduleDateFilter" type="date">
                </div>
            </div>
            <button type="button" class="btn-clear-filters" id="btnClearCalendarFilters">
                <i class="fa-solid fa-rotate-left"></i> Xóa lọc
            </button>
        </div>

        <div class="calendar-wrapper">
            <div class="calendar-header">
                <div class="month-nav">
                    <button class="btn-month-nav" id="btnPrevMonth">
                        <i class="fa-solid fa-chevron-left"></i>
                    </button>
                    <div class="current-month" id="currentMonthDisplay"></div>
                    <button class="btn-month-nav" id="btnNextMonth">
                        <i class="fa-solid fa-chevron-right"></i>
                    </button>
                </div>
                <button class="btn-today" id="btnCalendarToday">
                    <i class="fa-solid fa-calendar-day"></i> Hôm nay
                </button>
            </div>

            <div class="calendar-grid" id="calendarGrid">
                <div class="weekday-label"><span>Thứ 2</span></div>
                <div class="weekday-label"><span>Thứ 3</span></div>
                <div class="weekday-label"><span>Thứ 4</span></div>
                <div class="weekday-label"><span>Thứ 5</span></div>
                <div class="weekday-label"><span>Thứ 6</span></div>
                <div class="weekday-label"><span>Thứ 7</span></div>
                <div class="weekday-label"><span>CN</span></div>
            </div>

            <!-- Popover đặt ngoài calendar-wrapper để dùng position:fixed đúng -->
            <div class="schedule-popover" id="scheduleQuickPreviewPopover" aria-hidden="true">
                <div class="schedule-popover__arrow"></div>
                <div class="schedule-popover__header">
                    <div class="schedule-popover__header-content">
                        <p class="schedule-popover__eyebrow" id="schedulePopoverEyebrow">Chi tiết lịch</p>
                        <h3 class="schedule-popover__title" id="schedulePopoverTitle">-</h3>
                    </div>
                    <button type="button" class="schedule-popover__close" id="btnCloseSchedulePopover">
                        <i class="fa-solid fa-xmark"></i>
                    </button>
                </div>
                <div class="schedule-popover__body" id="schedulePopoverBody"></div>
            </div>
        </div>
    </div>

    <!-- Modal Tạo/Sửa Post -->
    <div class="post-modal" id="createPostModal">
        <div class="post-modal-container">
            <!-- Form Side -->
            <div class="modal-form-side">
                <div class="form-header">
                    <div class="form-header__left">
                        <div class="form-header__icon">
                            <i class="fa-solid fa-pen-to-square"></i>
                        </div>
                        <div class="form-header__text">
                            <h2 id="modalFormTitle">Tạo bài viết mới</h2>
                            <p id="modalFormSubtitle">Đăng album ảnh lên các nhóm Facebook</p>
                        </div>
                    </div>
                    <button type="button" class="form-header__close" id="btnClosePostModal" aria-label="Đóng">
                        <i class="fa-solid fa-xmark"></i>
                    </button>
                </div>

                <div class="form-fields-scrollable" id="formFieldsScrollable">
                    <!-- Section: Tiêu đề (chỉ hiện khi chọn Pinterest) -->
                    <div class="form-section" id="postTitleSection" style="display:none;">
                        <div class="form-section__header">
                            <i class="fa-solid fa-heading"></i>
                            <span>Tiêu đề bài viết</span>
                            <span class="form-section__required">*</span>
                        </div>
                        <input type="text" class="input-text" id="modalPostTitleInput" maxlength="100" placeholder="VD: BST áo thu đông 2024 - Ưu đãi 30%">
                        <div class="form-section__hint" id="postTitleHint">
                            <i class="fa-solid fa-info-circle"></i>
                            <span id="postTitleHintText">Bắt buộc cho Pinterest - sẽ làm tiêu đề Pin. Bỏ trống sẽ tự lấy tên file ảnh.</span>
                        </div>
                    </div>

                    <!-- Section: Album Ảnh -->
                    <div class="form-section">
                        <div class="form-section__header">
                            <i class="fa-solid fa-images"></i>
                            <span>Album hình ảnh</span>
                        </div>
                        <div class="upload-zone" id="uploadZone">
                            <div class="upload-zone__content">
                                <i class="fa-solid fa-cloud-arrow-up"></i>
                                <span class="upload-zone__title">Kéo thả ảnh vào đây</span>
                                <span class="upload-zone__subtitle">hoặc click để chọn từ máy</span>
                                <span class="upload-zone__hint">JPG, PNG • Tối đa 10 ảnh</span>
                            </div>
                        </div>
                        <input type="file" id="actualImageInput" accept="image/*" multiple style="display:none;">
                        <div class="image-preview-list-wrapper" id="miniThumbGridContainer"></div>
                    </div>

                    <!-- Section: Nội dung -->
                    <div class="form-section">
                        <div class="form-section__header">
                            <i class="fa-solid fa-pencil"></i>
                            <span>Mô tả bài đăng</span>
                        </div>
                        <textarea class="input-text" id="modalCaptionInput" rows="4"
                            placeholder="Viết mô tả chi tiết cho bài viết..."></textarea>
                        <div class="form-section__hint">
                            <i class="fa-solid fa-info-circle"></i>
                            Mô tả sẽ hiển thị kèm ảnh. Có thể thêm hashtag để tăng tương tác.
                        </div>
                    </div>

                    <!-- Section: Thời gian -->
                    <div class="form-section">
                        <div class="form-section__header">
                            <i class="fa-solid fa-clock"></i>
                            <span>Hẹn giờ đăng</span>
                        </div>
                        <div class="datetime-split">
                            <div class="datetime-field">
                                <label>Ngày</label>
                                <input type="text" class="input-text" id="modalDateInput" inputmode="numeric" 
                                    autocomplete="off" placeholder="dd/mm/yyyy">
                            </div>
                            <div class="datetime-field">
                                <label>Giờ</label>
                                <input type="time" class="input-text" id="modalClockInput" step="60" value="09:00">
                            </div>
                        </div>
                        <input type="hidden" id="modalTimeInput">
                    </div>

                    <!-- Section: Nền tảng (Redesign 2026-06-21: card grid) -->
                    <div class="form-section">
                        <div class="form-section__header">
                            <i class="fa-solid fa-share-nodes"></i>
                            <span>Nền tảng đăng tải</span>
                            <span class="platform-picker-counter" id="platformPickerCounter" style="display:none;">0/0 đã chọn</span>
                        </div>
                        <div class="platform-picker-grid" id="platformPickerGrid">
                            <% const availablePlatforms = new Set((channels || []).map(ch => ch.platform)); %>
                            <%
                                // Ẩn YouTube (YT) và TikTok (TT) ở form đăng bài viết (hình ảnh)
                                // 2 nền tảng này chỉ dùng cho Reels/Video
                                const PLATFORM_CARDS = [
                                    { code: 'FB', name: 'Facebook', desc: 'Đăng lên nhóm & trang cá nhân', icon: 'fa-brands fa-facebook', color: '#1877F2' },
                                    { code: 'IG', name: 'Instagram', desc: 'Đăng lên Feed & Story', icon: 'fa-brands fa-instagram', color: '#E4405F' },
                                    { code: 'TH', name: 'Threads', desc: 'Đăng text + ảnh lên feed', icon: 'fa-brands fa-threads', color: '#000000' },
                                    { code: 'PI', name: 'Pinterest', desc: 'Đăng ảnh lên Board', icon: 'fa-brands fa-pinterest', color: '#E60023' }
                                ];
                            %>
                            <% PLATFORM_CARDS.forEach(function(p) { %>
                            <label class="platform-picker-card"
                                   data-platform="<%= p.code %>"
                                   style="--p-color: <%= p.color %>">
                                <input type="checkbox" class="platform-check" value="<%= p.code %>">
                                <div class="platform-picker-card__icon"><i class="<%= p.icon %>"></i></div>
                                <div class="platform-picker-card__body">
                                    <div class="platform-picker-card__name"><%= p.name %></div>
                                    <div class="platform-picker-card__desc"><%= p.desc %></div>
                                </div>
                                <div class="platform-picker-card__check"><i class="fa-solid fa-check"></i></div>
                            </label>
                            <% }); %>
                        </div>
                    </div>

                    <!-- Section: Tài khoản đăng (Redesign 2026-06-21) -->
                    <div class="form-section" id="accountPickerSection" style="display: none;">
                        <div class="form-section__header account-picker-header">
                            <i class="fa-solid fa-users"></i>
                            <span>Tài khoản đăng</span>
                            <span class="account-picker-counter" id="accountPickerCounter" style="display:none;">0/0 đã chọn</span>
                        </div>

                        <!-- Toolbar: search + select all (select all ẩn - chỉ chọn 1 account/platform) -->
                        <div class="account-picker-toolbar" id="accountPickerToolbar" style="display:none;">
                            <div class="account-picker-search">
                                <i class="fa-solid fa-magnifying-glass"></i>
                                <input type="text" id="accountPickerSearch" placeholder="Tìm tên tài khoản..." />
                                <button type="button" class="account-picker-search-clear" id="accountPickerSearchClear" style="display:none;">
                                    <i class="fa-solid fa-xmark"></i>
                                </button>
                            </div>
                            <!-- Nút "Chọn tất cả" đã ẩn: mỗi platform chỉ chọn 1 account để load groups
                            <button type="button" class="account-picker-action-btn" id="accountPickerSelectAll">
                                <i class="fa-solid fa-check-double"></i>
                                <span>Chọn tất cả</span>
                            </button>
                            -->
                        </div>

                        <!-- Empty state khi chưa có account -->
                        <div class="account-picker-empty" id="accountPickerEmpty" style="display:none;">
                            <i class="fa-solid fa-plug"></i>
                            <p>Chưa có tài khoản nào được kết nối</p>
                            <a href="/channels" class="account-picker-empty-cta">
                                <i class="fa-solid fa-plus"></i> Thêm tài khoản ngay
                            </a>
                        </div>

                        <!-- Container chính để JS render card list -->
                        <div class="account-picker" id="dynamicAccountBox">
                            <div class="empty-state">
                                <i class="fa-solid fa-spinner fa-spin"></i>
                                <span>Đang tải tài khoản...</span>
                            </div>
                        </div>
                    </div>

                    <!-- Section: Nơi đăng (tabs ngang) -->
                    <div class="form-section" id="targetTabsSection" style="display: none;">
                        <div class="form-section__header">
                            <i class="fa-solid fa-location-dot"></i>
                            <span>Nơi đăng</span>
                        </div>

                        <div class="target-tabs-wrapper" id="targetTabsWrapper" style="display:none;">
                            <div class="target-tabs-hint">
                                <i class="fa-solid fa-lightbulb"></i>
                                Chọn nơi đăng cho từng nền tảng đã tick ở trên
                            </div>
                            <div class="target-tabs-nav" id="targetTabsNav"></div>
                            <div class="target-tabs-content" id="targetTabsContent"></div>
                        </div>
                    </div>

                </div>

                <div class="action-btns-group">
                    <button type="button" class="btn-action-secondary" id="btnCancelPostSchedule">
                        <i class="fa-solid fa-ban"></i> Hủy bỏ
                    </button>
                    <button type="button" class="btn-action-danger" id="btnDeleteSchedule" style="display:none;">
                        <i class="fa-solid fa-trash"></i> Xóa lịch
                    </button>
                    <button class="btn-action-primary" type="button" id="btnSubmitPostSchedule">
                        <i class="fa-solid fa-calendar-check"></i>
                        <span>Xác nhận lên lịch</span>
                    </button>
                </div>
            </div>

            <!-- Preview Side -->
            <div class="modal-preview-side">
                <div class="preview-label">
                    <i class="fa-solid fa-mobile-screen-button"></i>
                    Xem trước trên điện thoại
                </div>

                <div class="phone-stage">
                    <div class="phone-stage__glow"></div>
                    <div class="phone-mockup phone-mockup--feed">
                        <div class="phone-frame">
                            <div class="phone-island">
                                <span class="phone-island__dot"></span>
                            </div>
                            <div class="phone-statusbar">
                                <span class="phone-statusbar__time">9:41</span>
                                <span class="phone-statusbar__icons">
                                    <i class="fa-solid fa-signal"></i>
                                    <i class="fa-solid fa-wifi"></i>
                                    <i class="fa-solid fa-battery-three-quarters"></i>
                                </span>
                            </div>
                        </div>

                        <div class="feed-header">
                            <div class="feed-avatar">
                                <i class="fa-solid fa-user"></i>
                            </div>
                            <div class="feed-user-info">
                                <h5 id="previewUsername">Tài khoản của bạn</h5>
                                <span><i class="fa-solid fa-earth-americas"></i> Vừa xong • <i class="fa-solid fa-user-group"></i> Công khai</span>
                            </div>
                            <span class="feed-header__more"><i class="fa-solid fa-ellipsis"></i></span>
                        </div>

                        <div class="feed-caption" id="liveFeedTextPreview">
                            Nội dung bài viết sẽ hiển thị tại đây. Bạn có thể viết caption dài để mô tả sản phẩm...
                        </div>

                        <div class="feed-image-container">
                            <div class="feed-carousel-counter" id="phoneCarouselCounterBadge">
                                <i class="fa-solid fa-images"></i> 1/1
                            </div>

                            <div class="feed-image-placeholder" id="feedImagePlaceholder">
                                <i class="fa-regular fa-images"></i>
                                <span>Chưa có ảnh</span>
                            </div>

                            <div class="swiper mySwiper">
                                <div class="swiper-wrapper" id="swiperWrapperTarget"></div>
                            </div>
                        </div>

                        <div class="feed-carousel-dots swiper-pagination" id="phoneCarouselDotsContainer"></div>

                        <div class="feed-react-bar">
                            <div class="feed-react-summary">
                                <span class="feed-react-bubble"><i class="fa-solid fa-thumbs-up"></i><i class="fa-solid fa-heart"></i></span>
                                <strong>2.4K</strong>
                            </div>
                            <div class="feed-react-counts">
                                <span><strong>186</strong> bình luận</span>
                                <span><strong>54</strong> chia sẻ</span>
                            </div>
                        </div>

                        <div class="feed-actions-bar">
                            <div class="feed-action-btn-mock"><i class="fa-regular fa-thumbs-up"></i><span>Thích</span></div>
                            <div class="feed-action-btn-mock"><i class="fa-regular fa-comment"></i><span>Bình luận</span></div>
                            <div class="feed-action-btn-mock"><i class="fa-regular fa-share-from-square"></i><span>Chia sẻ</span></div>
                            <div class="feed-action-btn-mock"><i class="fa-regular fa-bookmark"></i><span>Lưu</span></div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <script src="/js/toast.js"></script>
    <script>
        window.__CURRENT_USER_ID = '<%= user._id %>';
    </script>
    <script src="/js/base.js"></script>
    <script src="/js/utils.js"></script>
    <script src="/js/schedule-post/helpers.js"></script>
    <script src="/js/schedule-post/image.js"></script>
    <script src="/js/schedule-post/calendar.js"></script>
    <script src="/js/schedule-post/groups.js"></script>
    <script src="/js/schedule-post/instagram.js"></script>
    <script src="/js/schedule-post/tiktok.js"></script>
    <script src="/js/schedule-post/threads.js"></script>
    <script src="/js/schedule-post/pinterest.js"></script>
    <script src="/js/schedule-post/platform-target.js"></script>
    <script src="/js/schedule-post/modal.js"></script>
    <script src="/js/schedule-post/realtime.js"></script>
    <script src="/js/schedule-post.js"></script>
</body>

</html>
