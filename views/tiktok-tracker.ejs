// ===== EDIT TRACKING =====
let ttEditData = null;
const ttEditPlatformMap = { FR: 'FB', IG: 'IG', TH: 'TH', PI: 'PI', TT: 'TT', YT: 'YT' };

function ttEditUpdateAccounts() {
    const activePlatforms = [...document.querySelectorAll('#ttEditPlatforms .tt-chip.active')].map(c => c.dataset.val);
    const matchPlatforms = activePlatforms.map(p => ttEditPlatformMap[p]).filter(Boolean);
    const accountSection = document.getElementById('ttEditAccountSection');
    const hint = document.getElementById('ttEditAccountHint');
    const noAccount = document.getElementById('ttEditNoAccount');

    if (!activePlatforms.length) {
        accountSection.classList.add('tt-hidden');
        document.querySelectorAll('#ttEditAccounts .tt-account-cb').forEach(cb => { cb.checked = false; });
        document.querySelectorAll('#ttEditAccounts .tt-account-item').forEach(item => { item.style.display = 'none'; });
        return;
    }
    accountSection.classList.remove('tt-hidden');
    hint.textContent = '(' + activePlatforms.join(', ') + ')';
    let hasVisible = false;
    document.querySelectorAll('#ttEditAccounts .tt-account-item').forEach(item => {
        const show = matchPlatforms.includes(item.dataset.platform);
        item.style.display = show ? '' : 'none';
        if (show) hasVisible = true;
        if (!show) item.querySelector('input').checked = false;
    });
    noAccount.style.display = hasVisible ? 'none' : '';
}

function editTracking(json) {
    ttEditData = typeof json === 'string' ? JSON.parse(json) : json;
    // Set interval
    document.getElementById('ttEditInterval').value = ttEditData.checkIntervalMinutes || 15;
    // Set cookies
    document.getElementById('ttEditCookiesPath').value = ttEditData.cookiesPath || '';
    document.getElementById('ttEditCookiesFileName').textContent = ttEditData.cookiesPath ? ttEditData.cookiesPath.split(/[/\\]/).pop() : 'Chưa có file';
    // Set telegram
    document.getElementById('ttEditTelegramReview').checked = !!ttEditData.telegramReview;
    // Set platforms
    document.querySelectorAll('#ttEditPlatforms .tt-chip').forEach(c => {
        c.classList.toggle('active', (ttEditData.crossPostPlatforms || []).includes(c.dataset.val));
    });
    // Reset all account checkboxes first
    document.querySelectorAll('#ttEditAccounts .tt-account-cb').forEach(cb => { cb.checked = false; });
    // Run filter then check matching accounts
    ttEditUpdateAccounts();
    document.querySelectorAll('#ttEditAccounts .tt-account-item').forEach(item => {
        if (item.style.display !== 'none' && (ttEditData.crossPostAccounts || []).includes(item.querySelector('input').value)) {
            item.querySelector('input').checked = true;
        }
    });
    document.getElementById('ttEditModal').style.display = 'flex';
}

document.addEventListener('DOMContentLoaded', function () {
    // Platform chips toggle + account filter
    document.querySelectorAll('#ttEditPlatforms .tt-chip').forEach(chip => {
        chip.addEventListener('click', () => { chip.classList.toggle('active'); ttEditUpdateAccounts(); });
    });
    // Close
    document.getElementById('ttEditClose').addEventListener('click', () => {
        document.getElementById('ttEditModal').style.display = 'none';
    });
    document.getElementById('ttEditModal').addEventListener('click', function (e) {
        if (e.target === this) this.style.display = 'none';
    });
    // Save
    document.getElementById('ttEditSave').addEventListener('click', async () => {
        if (!ttEditData) return;
        const platforms = [...document.querySelectorAll('#ttEditPlatforms .tt-chip.active')].map(c => c.dataset.val);
        const accounts = [...document.querySelectorAll('#ttEditAccounts .tt-account-cb:checked')].map(cb => cb.value);
        const interval = parseInt(document.getElementById('ttEditInterval').value) || 15;
        const cookiesPath = document.getElementById('ttEditCookiesPath').value;
        const telegramReview = document.getElementById('ttEditTelegramReview').checked;
        if (!platforms.length) { ttNotify('Chọn ít nhất 1 nền tảng', 'warning'); return; }
        if (!accounts.length) { ttNotify('Chọn ít nhất 1 tài khoản', 'warning'); return; }
        const btn = document.getElementById('ttEditSave');
        btn.disabled = true;
        try {
            await api('/tiktok-tracker/api/trackings/' + ttEditData.id, {
                method: 'PUT',
                body: JSON.stringify({ crossPostPlatforms: platforms, crossPostAccounts: accounts, checkIntervalMinutes: interval, cookiesPath, telegramReview }),
            });
            location.reload();
        } catch (e) { ttNotify('Lỗi: ' + e.message, 'error'); }
        finally { btn.disabled = false; }
    });
    // Upload cookies
    document.getElementById('ttEditCookiesFile').addEventListener('change', async function () {
        const file = this.files[0]; if (!file) return;
        const nameEl = document.getElementById('ttEditCookiesFileName');
        const pathEl = document.getElementById('ttEditCookiesPath');
        nameEl.textContent = 'Đang tải...';
        try {
            const fd = new FormData(); fd.append('cookiesFile', file);
            const res = await fetch('/tiktok-tracker/api/upload-cookies', { method: 'POST', body: fd, credentials: 'same-origin' });
            const data = await res.json();
            if (data.success) {
                pathEl.value = data.cookiesPath;
                nameEl.textContent = file.name;
                nameEl.style.color = 'var(--success)';
            } else { nameEl.textContent = 'Lỗi: ' + (data.error || 'Upload failed'); nameEl.style.color = 'var(--danger)'; }
        } catch (e) { nameEl.textContent = 'Lỗi: ' + e.message; nameEl.style.color = 'var(--danger)'; }
    });
});

// ===== VIDEO PREVIEW =====
function previewVideo(id) {
    const modal = document.getElementById('ttPreviewModal');
    const player = document.getElementById('ttPreviewPlayer');
    player.src = '/tiktok-tracker/api/videos/' + id + '/preview';
    modal.style.display = 'flex';
    player.play();
}
document.addEventListener('DOMContentLoaded', function () {
    document.getElementById('ttPreviewClose').addEventListener('click', function () {
        const modal = document.getElementById('ttPreviewModal');
        const player = document.getElementById('ttPreviewPlayer');
        player.pause();
        player.src = '';
        modal.style.display = 'none';
    });
    document.getElementById('ttPreviewModal').addEventListener('click', function (e) {
        if (e.target === this) document.getElementById('ttPreviewClose').click();
    });
});
</script>

<!-- Edit Tracking Modal -->
<div id="ttEditModal" style="display:none;position:fixed;inset:0;z-index:9998;background:rgba(0,0,0,0.6);justify-content:center;align-items:center;">
<div style="background:var(--bg-card);border-radius:var(--radius);padding:28px;max-width:540px;width:92vw;max-height:88vh;overflow-y:auto;box-shadow:0 8px 32px rgba(0,0,0,0.3);position:relative;">
    <button id="ttEditClose" style="position:absolute;top:14px;right:14px;background:none;border:none;font-size:20px;cursor:pointer;color:var(--text-light);"><i class="fa-solid fa-xmark"></i></button>
    <h3 style="margin:0 0 20px;font-size:16px;color:var(--text-main);"><i class="fa-solid fa-pen"></i> Chỉnh sửa tracking</h3>

    <!-- Cross-post platforms -->
    <div style="margin-bottom:18px;">
        <label style="font-size:11px;font-weight:700;color:var(--text-muted);text-transform:uppercase;letter-spacing:0.8px;margin-bottom:6px;display:block;">Cross-post sang:</label>
        <div class="tt-chips" id="ttEditPlatforms">
            <span class="tt-chip" data-val="FR"><i class="fa-brands fa-facebook"></i> Facebook Reels</span>
            <span class="tt-chip" data-val="IG"><i class="fa-brands fa-instagram"></i> Instagram</span>
            <span class="tt-chip" data-val="TH"><i class="fa-brands fa-threads"></i> Threads</span>
            <span class="tt-chip" data-val="PI"><i class="fa-brands fa-pinterest"></i> Pinterest</span>
            <span class="tt-chip" data-val="YT"><i class="fa-brands fa-youtube"></i> YouTube Shorts</span>
        </div>
    </div>

    <!-- Accounts (filtered by platform) -->
    <div style="margin-bottom:18px;" id="ttEditAccountSection" class="tt-hidden">
        <label style="font-size:11px;font-weight:700;color:var(--text-muted);text-transform:uppercase;letter-spacing:0.8px;margin-bottom:6px;display:block;">
            Tài khoản đăng bài: <span id="ttEditAccountHint" style="font-weight:400;text-transform:none;letter-spacing:0;"></span>
        </label>
        <div class="tt-account-grid" id="ttEditAccounts">
            <% if (channels.length > 0) { %>
                <% channels.forEach(function(ch) { %>
                <label class="tt-account-item" data-platform="<%= ch.platform %>" style="display:none;">
                    <input type="checkbox" value="<%= ch._id %>" class="tt-account-cb" data-platform="<%= ch.platform %>">
                    <i class="fa-brands <%= platformIcons[ch.platform] || 'fa-globe' %>" style="color:<%= platformColors[ch.platform] || '#666' %>;font-size:12px;"></i>
                    <span><%= (ch.accountName || ch.username || 'Account').substring(0, 18) %></span>
                </label>
                <% }); %>
            <% } %>
            <div id="ttEditNoAccount" style="display:none;width:100%;font-size:12px;color:var(--text-light);padding:6px 0;">
                Không có tài khoản nào cho nền tảng này. <a href="/channels" style="color:var(--primary);">Kết nối thêm</a>
            </div>
        </div>
    </div>

    <!-- Check interval -->
    <div style="margin-bottom:18px;">
        <label style="font-size:11px;font-weight:700;color:var(--text-muted);text-transform:uppercase;letter-spacing:0.8px;margin-bottom:6px;display:block;">Kiểm tra mỗi:</label>
        <select id="ttEditInterval" class="tt-select">
            <option value="5">5 phút</option><option value="10">10 phút</option><option value="15">15 phút</option>
            <option value="30">30 phút</option><option value="60">1 giờ</option><option value="360">6 giờ</option><option value="1440">24 giờ</option>
        </select>
    </div>

    <!-- Cookies -->
    <div style="margin-bottom:18px;">
        <label style="font-size:11px;font-weight:700;color:var(--text-muted);text-transform:uppercase;letter-spacing:0.8px;margin-bottom:6px;display:block;">Cookies TikTok:</label>
        <div style="display:flex;align-items:center;gap:8px;">
            <label class="tt-btn tt-btn-sm tt-btn-outline" style="cursor:pointer;white-space:nowrap;">
                <i class="fa-solid fa-upload"></i> Chọn file
                <input type="file" id="ttEditCookiesFile" accept=".txt,.cookie,.cookies,.json" style="display:none;">
            </label>
            <span id="ttEditCookiesFileName" style="font-size:12px;color:var(--text-light);">Chưa có file</span>
            <input type="hidden" id="ttEditCookiesPath" value="">
        </div>
    </div>

    <!-- Telegram -->
    <div style="margin-bottom:20px;padding:12px;border:1px dashed var(--border);border-radius:var(--radius-sm);">
        <label style="display:flex;align-items:center;gap:8px;cursor:pointer;font-size:13px;font-weight:600;color:var(--text-muted);">
            <input type="checkbox" id="ttEditTelegramReview" style="width:16px;height:16px;">
            <i class="fa-brands fa-telegram" style="color:#0088cc;"></i> Duyệt qua Telegram trước khi đăng
        </label>
    </div>

    <button id="ttEditSave" class="tt-btn tt-btn-primary" style="width:100%;"><i class="fa-solid fa-check"></i> Lưu thay đổi</button>
</div>
</div>

<!-- Preview Modal -->
<div id="ttPreviewModal" style="display:none;position:fixed;inset:0;z-index:9998;background:rgba(0,0,0,0.85);justify-content:center;align-items:center;">
    <button id="ttPreviewClose" style="position:absolute;top:16px;right:16px;background:none;border:none;color:#fff;font-size:28px;cursor:pointer;z-index:9999;"><i class="fa-solid fa-xmark"></i></button>
    <video id="ttPreviewPlayer" controls style="max-width:90vw;max-height:85vh;border-radius:8px;"></video>
</div>
</body>
</html>
