// ===== CROSS-POST VIDEO =====
async function crossPostVideo(id) {
    const btn = event.currentTarget;
    btn.disabled = true;
    btn.innerHTML = '<i class="fa-solid fa-spinner fa-spin"></i>';
    try {
        const result = await api(`/tiktok-tracker/api/videos/${id}/crosspost`, { method: 'POST' });
        ttNotify(result.message || 'Đã tạo lịch đăng!', 'success');
        location.reload();
    } catch (e) { ttNotify('Lỗi: ' + e.message, 'error'); }
    finally { btn.disabled = false; btn.innerHTML = '<i class="fa-solid fa-share-nodes"></i> Cross-post'; }
}

