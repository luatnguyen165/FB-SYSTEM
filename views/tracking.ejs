    // Lưu schedule
    async function saveSchedule(id) {
        const scrapeLimit = parseInt(document.getElementById('scrapeLimitInput')?.value) || 10;
        const scheduleEnabled = document.getElementById('scheduleEnabled')?.checked || false;
        const intervalMinutes = parseInt(document.getElementById('intervalMinutes')?.value) || 60;

        try {
            const res = await fetch(`/tracking/api/schedule/${id}`, {
                method: 'PUT',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ scrapeLimit, scheduleEnabled, intervalMinutes })
            });
            const data = await res.json();
            if (data.success) {
                showToast('success', data.message);
                document.querySelector('.edit-post-modal')?.remove();
                setTimeout(() => location.reload(), 1000);
            } else {
                showToast('error', data.message);
            }
        } catch (e) { showToast('error', 'Lỗi: ' + e.message); }
    }

    // Load settings khi load trang
    async function loadTrackingSettings() {
        document.querySelectorAll('.tracking-card').forEach(async (card) => {
            const id = card.dataset.id;
            try {
                const res = await fetch(`/tracking/api/schedule/${id}`);
                const data = await res.json();
                if (data.success) trackingSettings[id] = data.data;
            } catch (e) {}
        });
    }
    loadTrackingSettings();

    // Xem bài viết
    async function viewPosts(trackingId) {
        currentTrackingId = trackingId;
        document.getElementById('postsSection').style.display = 'block';
        document.getElementById('postsSection').scrollIntoView({ behavior: 'smooth' });
        await loadPosts(trackingId, 1);
    }

    function closePosts() {
        document.getElementById('postsSection').style.display = 'none';
    }

    async function loadPosts(trackingId, page) {
        const container = document.getElementById('postsTableContainer');
        container.innerHTML = '<div style="text-align:center;padding:40px;color:var(--text-muted);"><i class="fa-solid fa-spinner fa-spin"></i> Đang tải...</div>';
        try {
            const res = await fetch(`/tracking/api/posts/${trackingId}?page=${page}&limit=20`);
            const data = await res.json();
            if (!data.success || !data.posts.length) {
                container.innerHTML = '<div style="text-align:center;padding:60px;color:var(--text-muted);"><i class="fa-solid fa-inbox" style="font-size:48px;opacity:.3;display:block;margin-bottom:16px"></i>Chưa có bài viết nào<br><br>Nhấn nút <i class="fa-solid fa-download"></i> <strong>Scrape</strong> để lấy bài viết</div>';
                return;
            }
            const currentType = document.getElementById('trackingType')?.value || 'profile';
            const showTime = currentType !== 'group';
            let html = `
            <table class="posts-table">
                <thead>
                    <tr>
                        <th class="col-media">Ảnh/Video</th>
                        <th class="col-content">Nội dung</th>
                        ${showTime ? '<th class="col-time">Thời gian</th>' : ''}
                        <th class="col-actions">Hành động</th>
                    </tr>
                </thead>
                <tbody>`;
            for (const p of data.posts) {
                const images = p.images || [];
                const videos = fixVideoPaths(p.videos);
                const text = (p.text || '').substring(0, 100) + ((p.text || '').length > 100 ? '...' : '');
                const publishTime = p.publishedAtText || (p.publishedAt ? new Date(p.publishedAt).toLocaleString('vi-VN') : '');

                // Hiển thị ảnh nhỏ trong table
                let mediaHtml = '';
                if (images.length > 0) {
                    mediaHtml = `<div class="table-media-cell">${images.slice(0, 2).map(img =>
                        `<img src="${img}" class="table-thumb" onclick="previewImage('${img}')" loading="lazy">`
                    ).join('')}${images.length > 2 ? `<span class="table-more-badge">+${images.length - 2}</span>` : ''}</div>`;
                } else if (videos.length > 0) {
                    mediaHtml = `<div class="table-media-cell"><video src="${videos[0]}" class="table-thumb-video" preload="metadata" muted onclick="previewVideo('${videos[0]}')"></video>${videos.length > 1 ? `<span class="table-more-badge">+${videos.length - 1}</span>` : ''}</div>`;
                } else {
                    mediaHtml = '<span class="table-no-media">Không có</span>';
                }

                html += `
                    <tr>
                        <td>${mediaHtml}</td>
                        <td>
                            <div class="table-post-text">${text || '<em style="color:var(--text-light)">Không có nội dung</em>'}</div>
                            <div class="table-post-meta">
                                ${p.permalink ? `<a href="${p.permalink}" target="_blank"><i class="fa-solid fa-external-link"></i> Facebook</a>` : ''}
                                <span><i class="fa-solid fa-comment"></i> ${p.commentCount || 0}</span>
                            </div>
                        </td>
                        ${showTime ? `<td><span class="table-time">${publishTime || new Date(p.scrapedAt).toLocaleString('vi-VN')}</span>${renderRepostStatus(p.repostResults)}</td>` : `<td>${renderRepostStatus(p.repostResults)}</td>`}
                        <td>
                            <div class="table-actions">
                                <button class="btn-icon btn-icon--sm" title="Chỉnh sửa" onclick="editPost('${p._id}')"><i class="fa-solid fa-pen"></i></button>
                                <button class="btn-icon btn-icon--sm btn-icon--danger" title="Xóa" onclick="deletePost('${p._id}')"><i class="fa-solid fa-trash-can"></i></button>
                            </div>
                        </td>
                    </tr>`;
            }
            html += '</tbody></table>';
            // Pagination (chuẩn hóa dùng partials/pagination.ejs)
            if (data.totalPages > 1) {
                html += '<div class="pagination-wrapper" data-pagination>';
                html += '<div class="pagination-controls">';
                html += `<button class="pagination-btn pagination-btn--nav" onclick="loadPosts('${trackingId}',${data.page - 1})" ${data.page <= 1 ? 'disabled' : ''} title="Trang trước"><i class="fa-solid fa-chevron-left"></i></button>`;
                const maxBtn = 7;
                const half = Math.floor(maxBtn / 2);
                let start = Math.max(1, data.page - half);
                let end = Math.min(data.totalPages, start + maxBtn - 1);
                if (end - start + 1 < maxBtn) start = Math.max(1, end - maxBtn + 1);
                if (start > 1) {
                    html += `<button class="pagination-btn pagination-btn--page" onclick="loadPosts('${trackingId}',1)">1</button>`;
                    if (start > 2) html += '<span class="pagination-ellipsis">…</span>';
                }
                for (let i = start; i <= end; i++) {
                    html += `<button class="pagination-btn pagination-btn--page ${i === data.page ? 'is-active' : ''}" onclick="loadPosts('${trackingId}',${i})">${i}</button>`;
                }
                if (end < data.totalPages) {
                    if (end < data.totalPages - 1) html += '<span class="pagination-ellipsis">…</span>';
                    html += `<button class="pagination-btn pagination-btn--page" onclick="loadPosts('${trackingId}',${data.totalPages})">${data.totalPages}</button>`;
                }
                html += `<button class="pagination-btn pagination-btn--nav" onclick="loadPosts('${trackingId}',${data.page + 1})" ${data.page >= data.totalPages ? 'disabled' : ''} title="Trang sau"><i class="fa-solid fa-chevron-right"></i></button>`;
                html += '</div></div>';
            }
            container.innerHTML = html;
        } catch (e) {
            container.innerHTML = `<div style="text-align:center;padding:40px;color:var(--danger);"><i class="fa-solid fa-circle-exclamation"></i> Lỗi: ${e.message}</div>`;
        }
    }

