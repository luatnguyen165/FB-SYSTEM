                        <div class="action-btns-group">
                            <button class="btn-action-secondary" onclick="closeEditModal()">Hủy</button>
                            <button class="btn-action-primary" onclick="savePost('${id}')"><i class="fa-solid fa-check"></i> Lưu thay đổi</button>
                        </div>
                    </div>
                </div>`;
            overlay.addEventListener('click', (e) => { if (e.target === overlay) closeEditModal(); });
            document.body.appendChild(overlay);
        } catch (e) { showToast('error', 'Lỗi: ' + e.message); }
    }

    function closeEditModal() {
        document.querySelector('.edit-post-modal')?.remove();
    }

    async function savePost(id) {
        const text = document.getElementById('editPostText')?.value;
        if (text === undefined) return;
        try {
            const res = await fetch(`/tracking/api/posts/${id}`, {
                method: 'PUT',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ text })
            });
            const data = await res.json();
            if (data.success) {
                showToast('success', 'Đã lưu thay đổi');
                closeEditModal();
                loadPosts(currentTrackingId, 1);
            }
        } catch (e) { showToast('error', 'Lỗi: ' + e.message); }
    }

    async function deletePost(id) {
        if (!confirm('Xóa bài viết này?')) return;
        try {
            const res = await fetch(`/tracking/api/posts/${id}`, { method: 'DELETE' });
            const data = await res.json();
            if (data.success) {
                showToast('success', 'Đã xóa');
                loadPosts(currentTrackingId, 1);
            }
        } catch (e) { showToast('error', 'Lỗi: ' + e.message); }
    }

    // ===== Video Preview (from table thumbnail) =====
    function previewVideo(url) {
        const overlay = document.createElement('div');
        overlay.className = 'video-fullscreen-overlay';
        overlay.innerHTML = `
            <button class="btn-close-fullscreen" onclick="closeVideoFullscreen(this)"><i class="fa-solid fa-xmark"></i></button>
            <video src="${url}" controls autoplay playsinline style="max-width:95vw;max-height:90vh;border-radius:var(--radius-md);background:#000;"></video>
        `;
        overlay.addEventListener('click', (e) => {
            if (e.target === overlay) closeVideoFullscreen(overlay.querySelector('.btn-close-fullscreen'));
        });
        document.body.appendChild(overlay);
        const escHandler = (e) => {
            if (e.key === 'Escape') {
                closeVideoFullscreen(overlay.querySelector('.btn-close-fullscreen'));
                document.removeEventListener('keydown', escHandler);
            }
        };
        document.addEventListener('keydown', escHandler);
    }

    // ===== Video Player Controls =====
    function toggleVideoPlay(vidId, overlayEl) {
        const video = document.getElementById(vidId);
        if (!video) return;

        const icon = document.getElementById(vidId + '-icon');
        const overlay = overlayEl || video.parentElement.querySelector('.video-play-overlay');

        if (video.paused) {
            // Pause all other videos first
            document.querySelectorAll('.edit-post-video-item video').forEach(v => {
                if (v.id !== vidId && !v.paused) {
                    v.pause();
                    const vIcon = document.getElementById(v.id + '-icon');
                    if (vIcon) { vIcon.classList.remove('fa-pause'); vIcon.classList.add('fa-play'); }
                    const vOverlay = v.parentElement.querySelector('.video-play-overlay');
                    if (vOverlay) vOverlay.style.display = 'flex';
                }
            });

            video.play();
            if (icon) { icon.classList.remove('fa-play'); icon.classList.add('fa-pause'); }
            if (overlay) overlay.style.display = 'none';

            // Start progress tracking
            trackVideoProgress(vidId);
        } else {
            video.pause();
            if (icon) { icon.classList.remove('fa-pause'); icon.classList.add('fa-play'); }
            if (overlay) overlay.style.display = 'flex';
        }
    }

    function trackVideoProgress(vidId) {
        const video = document.getElementById(vidId);
        const progressFill = document.getElementById(vidId + '-progress');
        const timeLabel = document.getElementById(vidId + '-time');
        if (!video) return;

        const update = () => {
            if (video.duration) {
                const pct = (video.currentTime / video.duration) * 100;
                if (progressFill) progressFill.style.width = pct + '%';
                if (timeLabel) timeLabel.textContent = formatVideoTime(video.currentTime);
            }
            if (!video.paused && !video.ended) {
                requestAnimationFrame(update);
            }
        };
        requestAnimationFrame(update);

        // When video ends, reset
        video.onended = () => {
            const icon = document.getElementById(vidId + '-icon');
            if (icon) { icon.classList.remove('fa-pause'); icon.classList.add('fa-play'); }
            const overlay = video.parentElement.querySelector('.video-play-overlay');
            if (overlay) overlay.style.display = 'flex';
            if (progressFill) progressFill.style.width = '0%';
        };
    }

    function seekVideo(event, vidId) {
        const video = document.getElementById(vidId);
        if (!video || !video.duration) return;
        const bar = event.currentTarget;
        const rect = bar.getBoundingClientRect();
        const pct = Math.max(0, Math.min(1, (event.clientX - rect.left) / rect.width));
        video.currentTime = pct * video.duration;

        const progressFill = document.getElementById(vidId + '-progress');
        if (progressFill) progressFill.style.width = (pct * 100) + '%';
    }

    function toggleMuteVideo(vidId) {
        const video = document.getElementById(vidId);
        if (!video) return;
        video.muted = !video.muted;
        const volIcon = document.getElementById(vidId + '-vol');
        if (volIcon) {
            volIcon.classList.toggle('fa-volume-high', !video.muted);
            volIcon.classList.toggle('fa-volume-xmark', video.muted);
        }
    }

    function openVideoFullscreen(vidId) {
        const video = document.getElementById(vidId);
        if (!video) return;

        const overlay = document.createElement('div');
        overlay.className = 'video-fullscreen-overlay';
        overlay.innerHTML = `
            <button class="btn-close-fullscreen" onclick="closeVideoFullscreen(this)"><i class="fa-solid fa-xmark"></i></button>
        `;

        // Clone video into fullscreen
        const clonedVideo = video.cloneNode(true);
        clonedVideo.id = vidId + '-fullscreen';
        clonedVideo.controls = true;
        clonedVideo.style.cssText = 'max-width:95vw;max-height:90vh;border-radius:var(--radius-md);';
        clonedVideo.currentTime = video.currentTime;
        overlay.appendChild(clonedVideo);

        // Pause original, play cloned
        video.pause();
        const icon = document.getElementById(vidId + '-icon');
        if (icon) { icon.classList.remove('fa-pause'); icon.classList.add('fa-play'); }
        const playOverlay = video.parentElement.querySelector('.video-play-overlay');
        if (playOverlay) playOverlay.style.display = 'flex';

        overlay.addEventListener('click', (e) => {
            if (e.target === overlay) closeVideoFullscreen(overlay.querySelector('.btn-close-fullscreen'));
        });

        document.body.appendChild(overlay);
        clonedVideo.play();

        // ESC to close
        const escHandler = (e) => {
            if (e.key === 'Escape') {
                closeVideoFullscreen(overlay.querySelector('.btn-close-fullscreen'));
                document.removeEventListener('keydown', escHandler);
            }
        };
        document.addEventListener('keydown', escHandler);
    }

    function closeVideoFullscreen(btn) {
        const overlay = btn.closest('.video-fullscreen-overlay');
        if (overlay) {
            const vid = overlay.querySelector('video');
            if (vid) vid.pause();
            overlay.remove();
        }
    }

    function formatVideoTime(seconds) {
        const m = Math.floor(seconds / 60);
        const s = Math.floor(seconds % 60);
        return m + ':' + (s < 10 ? '0' : '') + s;
    }

    // Auto-init videos when edit modal opens (set duration on metadata load)
    function initVideoPlayers() {
        document.querySelectorAll('.edit-post-video-item video').forEach(video => {
            video.addEventListener('loadedmetadata', () => {
                const timeLabel = document.getElementById(video.id + '-time');
                if (timeLabel) timeLabel.textContent = formatVideoTime(video.duration);
            });
            // Click on video itself to toggle play
            video.addEventListener('click', () => toggleVideoPlay(video.id));
        });
    }

    // Observer to auto-init when edit modal content changes
    const videoObserver = new MutationObserver(() => {
        initVideoPlayers();
    });
    videoObserver.observe(document.body, { childList: true, subtree: true });
    </script>
</body>
</html>