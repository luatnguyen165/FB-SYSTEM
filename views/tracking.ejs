<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Theo Dõi - ReelsFlow AI</title>
    <link rel="stylesheet" href="/css/base.css">
    <link rel="stylesheet" href="/css/style.css">
    <link rel="stylesheet" href="/css/tracking.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.6.0/css/all.min.css">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
</head>
<body>
    <%- include('partials/sidebar', { currentPage: typeof currentPage !== 'undefined' ? currentPage : 'tracking-profile' }) %>

    <div class="main-content">
        <%- include('partials/header') %>

        <main class="content-body tracking-page">
            <!-- Hero Section -->
            <%
                const tType = typeof trackingType !== 'undefined' ? trackingType : 'profile';
                const typeLabels = { profile: 'Profile', page: 'Page', group: 'Group' };
                const typeIcons = { profile: 'fa-user', page: 'fa-flag', group: 'fa-users' };
                const typeLabel = typeLabels[tType] || 'Profile';
                const typeIcon = typeIcons[tType] || 'fa-user';
            %>
            <div class="tracking-hero">
                <div class="tracking-hero-content">
                    <div class="tracking-hero-left">
                        <div class="tracking-hero-title">
                            <div class="tracking-hero-icon"><i class="fa-solid <%= typeIcon %>"></i></div>
                            <h1>Theo Dõi <%= typeLabel %></h1>
                        </div>
                        <p class="tracking-hero-subtitle">
                            <% if (tType === 'profile') { %>
                                Theo dõi bài viết mới từ Profile đối thủ, KOL trên <strong>Facebook</strong>.
                            <% } else if (tType === 'page') { %>
                                Theo dõi bài viết mới từ <strong>Facebook Page</strong>.
                            <% } else { %>
                                Theo dõi bài viết mới từ <strong>Facebook Group</strong>.
                            <% } %>
                            Tự động phát hiện nội dung mới.
                        </p>
                    </div>
                    <div class="tracking-hero-actions">
                        <button class="btn-tracking-hero" id="btnAddTracking" data-type="<%= tType %>">
                            <i class="fa-solid fa-plus"></i> Thêm <%= typeLabel %>
                        </button>
                    </div>
                </div>
            </div>

            <!-- Stats Overview -->
            <div class="tracking-stats">
                <div class="tracking-stat-card">
                    <div class="stat-icon" style="background: rgba(37, 99, 235, 0.1); color: #2563eb;">
                        <i class="fa-solid fa-crosshairs"></i>
                    </div>
                    <div class="stat-info">
                        <span class="stat-value"><%= stats.total %></span>
                        <span class="stat-label">Tổng đối tượng</span>
                    </div>
                </div>
                <div class="tracking-stat-card">
                    <div class="stat-icon" style="background: rgba(24, 119, 242, 0.1); color: #1877f2;">
                        <i class="fa-brands fa-facebook"></i>
                    </div>
                    <div class="stat-info">
                        <span class="stat-value"><%= stats.facebook %></span>
                        <span class="stat-label">Facebook</span>
                    </div>
                </div>
                <div class="tracking-stat-card">
                    <div class="stat-icon" style="background: rgba(16, 185, 129, 0.1); color: #10b981;">
                        <i class="fa-solid fa-play"></i>
                    </div>
                    <div class="stat-info">
                        <span class="stat-value"><%= stats.active %></span>
                        <span class="stat-label">Đang theo dõi</span>
                    </div>
                </div>
            </div>

            <!-- Platform Tabs -->
            <div class="tracking-tabs">
                <button class="tracking-tab <%= activePlatform === 'all' ? 'active' : '' %>" data-platform="all">
                    <i class="fa-solid fa-layer-group"></i> Tất Cả
                </button>
                <button class="tracking-tab <%= activePlatform === 'facebook' ? 'active' : '' %>" data-platform="facebook">
                    <i class="fa-brands fa-facebook"></i> Facebook
                </button>
            </div>

            <!-- Tracking List -->
            <div class="tracking-list" id="trackingList">
                <% if (trackings.length === 0) { %>
                <div class="tracking-empty">
                    <div class="empty-icon"><i class="fa-solid fa-crosshairs"></i></div>
                    <h3>Chưa có đối tượng theo dõi</h3>
                    <p>Thêm đối tượng Facebook để bắt đầu theo dõi.</p>
                    <button class="btn-tracking-hero" id="btnAddTrackingEmpty">
                        <i class="fa-solid fa-plus"></i> Thêm Đối Tượng
                    </button>
                </div>
                <% } else { %>
                <% trackings.forEach(function(t) { %>
                <div class="tracking-card" data-id="<%= t._id %>" data-platform="<%= t.sourcePlatform %>">
                    <div class="tracking-card-main">
                        <div class="tracking-card-icon icon-fb">
                            <i class="fa-brands fa-facebook"></i>
                        </div>
                        <div class="tracking-card-info">
                            <h3 class="tracking-card-name"><%= t.name %></h3>
                            <a href="<%= t.url %>" target="_blank" class="tracking-card-url"><%= t.url %></a>
                            <div class="tracking-card-meta">
                                <% if (t.sourceAccountId) { %>
                                <span class="meta-badge">
                                    <i class="fa-solid fa-user"></i> <%= t.sourceAccountId.accountName %>
                                </span>
                                <% } %>
                                <% /* TẠM ẨN targetPlatforms
                                if (t.targetPlatforms && t.targetPlatforms.length > 0) { %>
                                <span class="meta-badge">
                                    <i class="fa-solid fa-share-nodes"></i> Đăng lên:
                                    <% t.targetPlatforms.forEach(function(tp, idx) { %>
                                        <%= tp.platform %><%= idx < t.targetPlatforms.length - 1 ? ', ' : '' %>
                                    <% }); %>
                                </span>
                                <% } */ %>
                                <span class="meta-badge <%= t.isActive ? 'badge-active' : 'badge-paused' %>">
                                    <i class="fa-solid <%= t.isActive ? 'fa-play' : 'fa-pause' %>"></i>
                                    <%= t.isActive ? 'Đang theo dõi' : 'Tạm dừng' %>
                                </span>
                            </div>
                        </div>
                        <div class="tracking-card-stats">
                            <div class="stat-item">
                                <span class="stat-num"><%= t.stats?.totalPosts || 0 %></span>
                                <span class="stat-lbl">Bài viết</span>
                            </div>
                            <div class="stat-item">
                                <span class="stat-num"><%= t.stats?.totalReposted || 0 %></span>
                                <span class="stat-lbl">Đã đăng lại</span>
                            </div>
                        </div>
                        <div class="tracking-card-actions">
                            <button class="btn-icon-card btn-icon-success" title="Scrape bài viết" onclick="scrapeTracking('<%= t._id %>')">
                                <i class="fa-solid fa-download"></i>
                            </button>
                            <button class="btn-icon-card" title="Xem bài viết" onclick="viewPosts('<%= t._id %>')">
                                <i class="fa-solid fa-list"></i>
                            </button>
                            <button class="btn-icon-card" title="Bật/Tắt" onclick="toggleTracking('<%= t._id %>')">
                                <i class="fa-solid <%= t.isActive ? 'fa-pause' : 'fa-play' %>"></i>
                            </button>
                            <button class="btn-icon-card" title="Sửa" onclick="editTracking('<%= t._id %>')">
                                <i class="fa-solid fa-pen"></i>
                            </button>
                            <button class="btn-icon-card btn-icon-danger" title="Xóa" onclick="deleteTracking('<%= t._id %>')">
                                <i class="fa-solid fa-trash-can"></i>
                            </button>
                        </div>
                    </div>
                </div>
                <% }); %>
                <% } %>
            </div>

            <!-- Posts Table -->
            <div id="postsSection" style="display:none; margin-top:24px;">
                <div class="tracking-hero" style="padding:20px 24px;">
                    <div style="display:flex; justify-content:space-between; align-items:center;">
                        <h2 style="margin:0; font-size:18px;"><i class="fa-solid fa-list"></i> Bài viết đã scrape</h2>
                        <button class="btn btn-ghost" onclick="closePosts()"><i class="fa-solid fa-xmark"></i> Đóng</button>
                    </div>
                </div>
                <div id="postsTableContainer" style="margin-top:16px;">
                    <div style="text-align:center; padding:40px; color:var(--text-muted);">Đang tải...</div>
                </div>
            </div>
        </main>
    </div>

    <!-- Modal: Thêm / Sửa đối tượng theo dõi -->
    <div class="modal-overlay" id="trackingModal" style="display: none;">
        <div class="modal-container modal-md">
            <div class="modal-header">
                <h3 class="modal-title" id="modalTitle">Thêm Đối Tượng Theo Dõi</h3>
                <button class="modal-close" onclick="closeModal()"><i class="fa-solid fa-xmark"></i></button>
            </div>
            <form id="trackingForm">
                <input type="hidden" id="trackingId" value="">
                <input type="hidden" id="trackingType" value="<%= typeof tType !== 'undefined' ? tType : 'profile' %>">
                <div class="modal-body">
                    <!-- Tên đối tượng -->
                    <div class="form-group">
                        <label class="form-label">Tên đối tượng <span class="required">*</span></label>
                        <input type="text" class="form-input" id="trackingName" placeholder="VD: KOL Nguyễn Văn A, Group B..." required>
                    </div>

                    <!-- URL đối tượng -->
                    <div class="form-group">
                        <label class="form-label">URL đối tượng <span class="required">*</span></label>
                        <input type="url" class="form-input" id="trackingUrl" placeholder="https://facebook.com/..." required>
                    </div>

                    <!-- Nền tảng gốc -->
                    <div class="form-group">
                        <label class="form-label">Nền tảng theo dõi <span class="required">*</span></label>
                        <div class="platform-selector">
                            <label class="platform-option" data-platform="facebook">
                                <input type="radio" name="sourcePlatform" value="facebook" checked>
                                <span class="platform-label"><i class="fa-brands fa-facebook"></i> Facebook</span>
                            </label>
                        </div>
                    </div>

                    <!-- Tài khoản lấy dữ liệu -->
                    <div class="form-group">
                        <label class="form-label">Tài khoản lấy dữ liệu</label>
                        <select class="form-input" id="sourceAccountId">
                            <option value="">-- Chọn tài khoản --</option>
                            <% channels.forEach(function(ch) { %>
                            <option value="<%= ch._id %>" data-platform="<%= ch.platform %>">
                                <%= ch.accountName %> (<%= ch.platform %> - <%= ch.accountType || '' %>)
                            </option>
                            <% }); %>
                        </select>
                    </div>

                    <!-- Nền tảng đăng — TẠM ẨN
                    <div class="form-group">
                        <label class="form-label">Nền tảng đăng (chọn nhiều)</label>
                        <div class="target-platforms-selector" id="targetPlatformsContainer">
                            ...
                        </div>
                    </div>
                    -->

                    <!-- Upload cookies — TẠM ẨN (chỉ cho TikTok) -->
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-ghost" onclick="closeModal()">Hủy</button>
                    <button type="submit" class="btn btn-primary" id="modalSubmitBtn">
                        <i class="fa-solid fa-plus"></i> Thêm
                    </button>
                </div>
            </form>
        </div>
    </div>

    <script src="/js/tracking.js"></script>
    <script>
    // Scrape bài viết
    async function scrapeTracking(id) {
        if (!confirm('Scrape bài viết mới từ đối tượng này?')) return;
        try {
            showToast('info', 'Đang scrape bài viết...');
            const res = await fetch(`/tracking/api/scrape/${id}`, {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ limit: 10 })
            });
            const data = await res.json();
            if (data.success) {
                showToast('success', data.message);
                setTimeout(() => location.reload(), 1500);
            } else {
                showToast('error', data.message);
            }
        } catch (e) { showToast('error', 'Lỗi: ' + e.message); }
    }

    // Xem bài viết
    let currentTrackingId = null;
    async function viewPosts(trackingId) {
        currentTrackingId = trackingId;
        document.getElementById('postsSection').style.display = 'block';
        document.getElementById('postsSection').scrollIntoView({ behavior: 'smooth' });
        await loadPosts(trackingId, 1);
    }

    function closePosts() {
        document.getElementById('postsSection').style.display = 'none';
    }

    async function loadPosts(trackingId, page) {
        const container = document.getElementById('postsTableContainer');
        container.innerHTML = '<div style="text-align:center;padding:40px;color:var(--text-muted);">Đang tải...</div>';
        try {
            const res = await fetch(`/tracking/api/posts/${trackingId}?page=${page}&limit=20`);
            const data = await res.json();
            if (!data.success || !data.posts.length) {
                container.innerHTML = '<div style="text-align:center;padding:40px;color:var(--text-muted);">Chưa có bài viết nào. Nhấn nút <i class="fa-solid fa-download"></i> để scrape.</div>';
                return;
            }
            let html = `<table class="data-table" style="width:100%">
                <thead><tr>
                    <th style="width:60px">Ảnh</th>
                    <th>Nội dung</th>
                    <th style="width:80px">Bình luận</th>
                    <th style="width:140px">Thời gian</th>
                    <th style="width:60px">Thao tác</th>
                </tr></thead><tbody>`;
            for (const p of data.posts) {
                const imgHtml = p.images && p.images.length > 0
                    ? `<img src="${p.images[0]}" style="width:50px;height:50px;object-fit:cover;border-radius:6px;cursor:pointer" onclick="window.open('${p.images[0]}','_blank')">`
                    : '<span style="color:var(--text-light)">—</span>';
                const text = (p.text || '').substring(0, 120) + ((p.text || '').length > 120 ? '...' : '');
                const link = p.permalink ? `<a href="${p.permalink}" target="_blank" style="color:var(--primary);font-size:11px"><i class="fa-solid fa-external-link"></i></a>` : '';
                html += `<tr>
                    <td>${imgHtml}</td>
                    <td>${text} ${link}</td>
                    <td>${p.commentCount || 0}</td>
                    <td>${new Date(p.scrapedAt).toLocaleString('vi-VN')}</td>
                    <td><button class="btn-sm btn-delete" onclick="deletePost('${p._id}')"><i class="fa-solid fa-trash"></i></button></td>
                </tr>`;
            }
            html += '</tbody></table>';
            // Pagination
            if (data.totalPages > 1) {
                html += '<div style="display:flex;gap:8px;justify-content:center;margin-top:16px">';
                for (let i = 1; i <= data.totalPages; i++) {
                    html += `<button class="btn-sm ${i === data.page ? 'btn-analyze' : 'btn-view'}" onclick="loadPosts('${trackingId}',${i})">${i}</button>`;
                }
                html += '</div>';
            }
            container.innerHTML = html;
        } catch (e) {
            container.innerHTML = `<div style="text-align:center;padding:40px;color:var(--danger);">Lỗi: ${e.message}</div>`;
        }
    }

    async function deletePost(id) {
        if (!confirm('Xóa bài viết này?')) return;
        try {
            const res = await fetch(`/tracking/api/posts/${id}`, { method: 'DELETE' });
            const data = await res.json();
            if (data.success) {
                showToast('success', 'Đã xóa');
                loadPosts(currentTrackingId, 1);
            }
        } catch (e) { showToast('error', 'Lỗi: ' + e.message); }
    }
    </script>
</body>
</html>