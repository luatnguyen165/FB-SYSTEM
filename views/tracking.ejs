<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Theo Dõi - ReelsFlow AI</title>
    <link rel="stylesheet" href="/css/base.css">
    <link rel="stylesheet" href="/css/style.css">
    <link rel="stylesheet" href="/css/tracking.css">
    <link rel="stylesheet" href="/css/schedule-post-modal.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.6.0/css/all.min.css">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
</head>
<body>
    <%- include('partials/sidebar', { currentPage: typeof currentPage !== 'undefined' ? currentPage : 'tracking-profile' }) %>

    <div class="main-content">
        <%- include('partials/header') %>

        <main class="content-body tracking-page">
            <!-- Welcome Section -->
            <%
                const tType = typeof trackingType !== 'undefined' ? trackingType : 'profile';
                const typeLabels = { profile: 'Profile', page: 'Page', group: 'Group' };
                const typeIcons = { profile: 'fa-user', page: 'fa-flag', group: 'fa-users' };
                const typeLabel = typeLabels[tType] || 'Profile';
                const typeIcon = typeIcons[tType] || 'fa-user';
                const trackingDescriptions = {
                    profile: 'Theo dõi bài viết mới từ Profile đối thủ, KOL trên Facebook. Tự động phát hiện nội dung mới.',
                    page: 'Theo dõi bài viết mới từ Facebook Page. Tự động phát hiện nội dung mới.',
                    group: 'Theo dõi bài viết mới từ Facebook Group. Tự động phát hiện nội dung mới.'
                };
            %>
            <%- include('partials/welcome-section', {
                eyebrow: 'Theo dõi đối thủ',
                title: 'Theo Dõi ' + typeLabel,
                description: trackingDescriptions[tType] || trackingDescriptions.profile,
                actionHtml: '<button class="btn-tracking-hero" id="btnAddTracking" data-type="' + tType + '"><i class="fa-solid fa-plus"></i> Thêm ' + typeLabel + '</button>'
            }) %>

            <!-- Stats Overview -->
            <div class="tracking-stats">
                <div class="tracking-stat-card">
                    <div class="stat-icon" style="background: rgba(37, 99, 235, 0.1); color: #2563eb;">
                        <i class="fa-solid fa-crosshairs"></i>
                    </div>
                    <div class="stat-info">
                        <span class="stat-value"><%= stats.total %></span>
                        <span class="stat-label">Tổng đối tượng</span>
                    </div>
                </div>
                <div class="tracking-stat-card">
                    <div class="stat-icon" style="background: rgba(24, 119, 242, 0.1); color: #1877f2;">
                        <i class="fa-brands fa-facebook"></i>
                    </div>
                    <div class="stat-info">
                        <span class="stat-value"><%= stats.facebook %></span>
                        <span class="stat-label">Facebook</span>
                    </div>
                </div>
                <div class="tracking-stat-card">
                    <div class="stat-icon" style="background: rgba(16, 185, 129, 0.1); color: #10b981;">
                        <i class="fa-solid fa-play"></i>
                    </div>
                    <div class="stat-info">
                        <span class="stat-value"><%= stats.active %></span>
                        <span class="stat-label">Đang theo dõi</span>
                    </div>
                </div>
            </div>

            <!-- Type Tabs -->
            <div class="tracking-tabs">
                <button class="tracking-tab <%= trackingType === 'profile' ? 'active' : '' %>" onclick="location.href='/tracking?type=profile'">
                    <i class="fa-solid fa-user"></i> Profile
                </button>
                <button class="tracking-tab <%= trackingType === 'page' ? 'active' : '' %>" onclick="location.href='/tracking?type=page'">
                    <i class="fa-solid fa-flag"></i> Page
                </button>
                <button class="tracking-tab <%= trackingType === 'group' ? 'active' : '' %>" onclick="location.href='/tracking?type=group'">
                    <i class="fa-solid fa-users"></i> Group
                </button>
            </div>

            <!-- Tracking List -->
            <div class="tracking-list" id="trackingList">
                <% if (trackings.length === 0) { %>
                <div class="tracking-empty">
                    <div class="empty-icon"><i class="fa-solid fa-crosshairs"></i></div>
                    <h3>Chưa có đối tượng theo dõi</h3>
                    <p>Thêm đối tượng Facebook để bắt đầu theo dõi.</p>
                    <button class="btn-tracking-hero" id="btnAddTrackingEmpty">
                        <i class="fa-solid fa-plus"></i> Thêm Đối Tượng
                    </button>
                </div>
                <% } else { %>
                <% trackings.forEach(function(t) { %>
                <div class="tracking-card" data-id="<%= t._id %>" data-platform="<%= t.sourcePlatform %>">
                    <div class="tracking-card-main">
                        <div class="tracking-card-icon icon-fb">
                            <% if (t.type === 'group') { %>
                                <i class="fa-solid fa-users"></i>
                            <% } else if (t.type === 'page') { %>
                                <i class="fa-solid fa-flag"></i>
                            <% } else { %>
                                <i class="fa-solid fa-user"></i>
                            <% } %>
                        </div>
                        <div class="tracking-card-info">
                            <h3 class="tracking-card-name"><%= t.name %></h3>
                            <a href="<%= t.url %>" target="_blank" class="tracking-card-url"><%= t.url %></a>
                            <div class="tracking-card-meta">
                                <% if (t.sourceAccountId) { %>
                                <span class="meta-badge">
                                    <i class="fa-solid fa-user"></i> <%= t.sourceAccountId.accountName %>
                                </span>
                                <% } %>
                                <% /* targetPlatforms */
                                if (t.targetPlatforms && t.targetPlatforms.length > 0) { %>
                                <span class="meta-badge">
                                    <i class="fa-solid fa-share-nodes"></i> Đăng lên:
                                    <% t.targetPlatforms.forEach(function(tp, idx) {
                                        var codeMap = {facebook:'FB', tiktok:'TT', instagram:'IG', youtube:'YT', pinterest:'PI', threads:'TH'};
                                        var code = codeMap[tp.platform] || tp.platform; %>
                                        <%= code %><%= idx < t.targetPlatforms.length - 1 ? ', ' : '' %>
                                    <% }); %>
                                </span>
                                <% } %>
                                <% if (t.repostPaused) { %>
                                <span class="meta-badge badge-paused">
                                    <i class="fa-solid fa-hand"></i> Tạm dừng repost
                                </span>
                                <% } %>
                                <span class="meta-badge <%= t.isActive ? 'badge-active' : 'badge-paused' %>">
                                    <i class="fa-solid <%= t.isActive ? 'fa-play' : 'fa-pause' %>"></i>
                                    <%= t.isActive ? 'Đang theo dõi' : 'Tạm dừng' %>
                                </span>
                                <% if (t.schedule?.enabled) { %>
                                <span class="meta-badge badge-schedule">
                                    <i class="fa-solid fa-clock"></i> Mỗi <%= t.schedule.intervalMinutes %>p
                                </span>
                                <% } %>
                                <span class="meta-badge badge-limit">
                                    <i class="fa-solid fa-list-ol"></i> <%= t.scrapeSettings?.limit || 10 %> bài
                                </span>
                            </div>
                        </div>
                        <div class="tracking-card-stats">
                            <div class="stat-item">
                                <span class="stat-num"><%= t.stats?.totalPosts || 0 %></span>
                                <span class="stat-lbl">Bài viết</span>
                            </div>
                            <div class="stat-item">
                                <span class="stat-num"><%= t.stats?.totalReposted || 0 %></span>
                                <span class="stat-lbl">Đã đăng lại</span>
                            </div>
                        </div>
                        <div class="tracking-card-actions">
                            <button class="btn-icon-card btn-icon-success" title="Scrape bài viết" onclick="scrapeTracking('<%= t._id %>')">
                                <i class="fa-solid fa-download"></i>
                            </button>
                            <button class="btn-icon-card" title="Xem bài viết" onclick="viewPosts('<%= t._id %>')">
                                <i class="fa-solid fa-list"></i>
                            </button>
                            <button class="btn-icon-card <%= t.repostPaused ? 'btn-icon-warning' : '' %>" title="<%= t.repostPaused ? 'Bật lại auto-repost' : 'Tạm dừng auto-repost' %>" data-repost-paused="<%= t.repostPaused ? '1' : '0' %>" onclick="toggleRepostPause('<%= t._id %>', this.dataset.repostPaused === '1')">
                                <i class="fa-solid <%= t.repostPaused ? 'fa-hand' : 'fa-share-from-square' %>"></i>
                            </button>
                            <button class="btn-icon-card" title="Bật/Tắt" onclick="toggleTracking('<%= t._id %>')">
                                <i class="fa-solid <%= t.isActive ? 'fa-pause' : 'fa-play' %>"></i>
                            </button>
                            <button class="btn-icon-card" title="Cài đặt" onclick="openScheduleModal('<%= t._id %>')">
                                <i class="fa-solid fa-gear"></i>
                            </button>
                            <button class="btn-icon-card" title="Sửa" onclick="editTracking('<%= t._id %>')">
                                <i class="fa-solid fa-pen"></i>
                            </button>
                            <button class="btn-icon-card btn-icon-danger" title="Xóa" onclick="deleteTracking('<%= t._id %>')">
                                <i class="fa-solid fa-trash-can"></i>
                            </button>
                        </div>
                    </div>
                </div>
                <% }); %>
                <% } %>
            </div>

            <!-- Pagination -->
            <% if (typeof pagination !== 'undefined' && pagination.totalPages > 1) { %>
            <%- include('partials/pagination', {
                currentPage: pagination.currentPage,
                totalPages: pagination.totalPages,
                totalItems: pagination.totalItems,
                baseUrl: pagination.baseUrl,
                queryParams: pagination.queryParams,
                mode: 'server',
                pageParam: 'page'
            }) %>
            <% } %>

            <!-- Posts Table -->
            <div id="postsSection" style="display:none; margin-top:24px;">
                <div class="tracking-hero" style="padding:20px 24px;">
                    <div style="display:flex; justify-content:space-between; align-items:center;">
                        <h2 style="margin:0; font-size:18px;"><i class="fa-solid fa-list"></i> Bài viết đã scrape</h2>
                        <button class="btn btn-ghost" onclick="closePosts()"><i class="fa-solid fa-xmark"></i> Đóng</button>
                    </div>
                </div>
                <div id="postsTableContainer" style="margin-top:16px;">
                    <div style="text-align:center; padding:40px; color:var(--text-muted);">Đang tải...</div>
                </div>
            </div>
        </main>
    </div>

    <!-- Modal: Thêm / Sửa đối tượng theo dõi -->
    <div class="modal-overlay" id="trackingModal" style="display: none;">
        <div class="modal-container modal-md">
            <div class="modal-header">
                <h3 class="modal-title" id="modalTitle">Thêm Đối Tượng Theo Dõi</h3>
                <button class="modal-close" onclick="closeModal()"><i class="fa-solid fa-xmark"></i></button>
            </div>
            <form id="trackingForm">
                <input type="hidden" id="trackingId" value="">
                <input type="hidden" id="trackingType" value="<%= typeof tType !== 'undefined' ? tType : 'profile' %>">
                <div class="modal-body">
                    <!-- Loại đối tượng -->
                    <div class="form-group">
                        <label class="form-label">Loại đối tượng <span class="required">*</span></label>
                        <div class="platform-selector">
                            <label class="platform-option" data-platform="profile">
                                <input type="radio" name="trackingTypeRadio" value="profile" <%= tType === 'profile' ? 'checked' : '' %>>
                                <span class="platform-label"><i class="fa-solid fa-user"></i> Profile</span>
                            </label>
                            <label class="platform-option" data-platform="page">
                                <input type="radio" name="trackingTypeRadio" value="page" <%= tType === 'page' ? 'checked' : '' %>>
                                <span class="platform-label"><i class="fa-solid fa-flag"></i> Page</span>
                            </label>
                            <label class="platform-option" data-platform="group">
                                <input type="radio" name="trackingTypeRadio" value="group" <%= tType === 'group' ? 'checked' : '' %>>
                                <span class="platform-label"><i class="fa-solid fa-users"></i> Group</span>
                            </label>
                        </div>
                    </div>

                    <!-- Tên đối tượng -->
                    <div class="form-group">
                        <label class="form-label">Tên đối tượng <span class="required">*</span></label>
                        <input type="text" class="form-input" id="trackingName" placeholder="VD: KOL Nguyễn Văn A, Group B..." required>
                    </div>

                    <!-- URL đối tượng -->
                    <div class="form-group">
                        <label class="form-label">URL đối tượng <span class="required">*</span></label>
                        <input type="url" class="form-input" id="trackingUrl" placeholder="https://facebook.com/..." required>
                    </div>

                    <!-- Nền tảng gốc -->
                    <div class="form-group">
                        <label class="form-label">Nền tảng theo dõi <span class="required">*</span></label>
                        <div class="platform-selector">
                            <label class="platform-option" data-platform="facebook">
                                <input type="radio" name="sourcePlatform" value="facebook" checked>
                                <span class="platform-label"><i class="fa-brands fa-facebook"></i> Facebook</span>
                            </label>
                        </div>
                    </div>

                    <!-- Tài khoản lấy dữ liệu -->
                    <div class="form-group">
                        <label class="form-label">Tài khoản lấy dữ liệu <span class="required">*</span></label>
                        <select class="form-input" id="sourceAccountId" required>
                            <option value="">-- Chọn tài khoản Facebook --</option>
                            <% 
                                var fbChannels = channels.filter(function(ch) { 
                                    return ch.platform === 'FB' || ch.platform === 'Facebook'; 
                                });
                                fbChannels.forEach(function(ch) { 
                            %>
                            <option value="<%= ch._id %>">
                                <%= ch.accountName %> (<%= ch.accountType || 'Cá nhân' %>)
                            </option>
                            <% }); %>
                        </select>
                        <div class="form-section__hint">
                            <i class="fa-solid fa-circle-info"></i> Chỉ sử dụng tài khoản Facebook để scrape dữ liệu.
                        </div>
                    </div>

                    <!-- Tự động đăng lại -->
                    <div class="form-group">
                        <label class="form-label">
                            <i class="fa-solid fa-share-from-square"></i> Tự động đăng lại
                        </label>
                        <div class="form-section__hint" style="margin-bottom:12px;">
                            <i class="fa-solid fa-circle-info"></i> Mỗi bài scrape về sẽ tự động đăng lên các tài khoản đã chọn.
                            <br>• Nội dung và hình ảnh được lấy tự động từ bài gốc, không cần chỉnh sửa.
                        </div>
                        <div class="platform-chips-row" id="platformChipsRow">
                            <%
                                var platformChipData = [
                                    { code: 'FB', label: 'Facebook', icon: 'fa-brands fa-facebook', color: '#1877F2' },
                                    { code: 'IG', label: 'Instagram', icon: 'fa-brands fa-instagram', color: '#E4405F' },
                                    { code: 'TT', label: 'TikTok', icon: 'fa-brands fa-tiktok', color: '#000000' },
                                    { code: 'YT', label: 'YouTube', icon: 'fa-brands fa-youtube', color: '#FF0000' },
                                    { code: 'PI', label: 'Pinterest', icon: 'fa-brands fa-pinterest', color: '#E60023' },
                                    { code: 'TH', label: 'Threads', icon: 'fa-brands fa-threads', color: '#000000' }
                                ];
                                var platformGroups = {};
                                channels.forEach(function(ch) {
                                    if (!platformGroups[ch.platform]) platformGroups[ch.platform] = [];
                                    platformGroups[ch.platform].push(ch);
                                });
                            %>
                            <% platformChipData.forEach(function(p) {
                                var hasAccounts = platformGroups[p.code] && platformGroups[p.code].length > 0;
                            %>
                            <div class="platform-chip-new <%= hasAccounts ? '' : 'disabled' %>" data-platform="<%= p.code %>" data-has-accounts="<%= hasAccounts ? '1' : '0' %>">
                                <i class="<%= p.icon %>" style="color: <%= p.color %>;"></i>
                                <span><%= p.label %></span>
                                <span class="chip-check"><i class="fa-solid fa-check"></i></span>
                            </div>
                            <% }); %>
                        </div>
                        <script>
window.__platformAccounts = <%- JSON.stringify(platformGroups) %>;
console.log('[Platform] __platformAccounts loaded:', Object.keys(window.__platformAccounts || {}));
</script>
                        <div class="account-grid" id="accountGrid"></div>
                        <div class="form-section__hint" style="margin-top:12px;">
                            <i class="fa-solid fa-circle-info"></i> Chọn nền tảng, sau đó chọn tài khoản để tự động đăng lại.
                        </div>

                    <!-- Tạm dừng auto-repost -->
                    <div class="form-group">
                        <label class="schedule-toggle" style="display:flex;align-items:center;gap:8px;cursor:pointer;">
                            <input type="checkbox" id="repostPaused">
                            <span><i class="fa-solid fa-hand"></i> Tạm dừng auto-repost (vẫn scrape bình thường)</span>
                        </label>
                    </div>

                    <!-- Upload cookies — TẠM ẨN (chỉ cho TikTok) -->
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-ghost" onclick="closeModal()">Hủy</button>
                    <button type="submit" class="btn btn-primary" id="modalSubmitBtn">
                        <i class="fa-solid fa-plus"></i> Thêm
                    </button>
                </div>
            </form>
        </div>
    </div>

    <script src="/socket.io/socket.io.js"></script>
    <script src="/js/base.js"></script>
    <script src="/js/tracking.js"></script>
    <script>
    // Socket.IO (safe init)
    let socket = null;
    try {
        socket = io({ transports: ['websocket', 'polling'] });
        socket.on('connect', () => console.log('[Socket] Connected'));
        socket.on('disconnect', () => console.log('[Socket] Disconnected'));
    } catch (e) {
        console.warn('[Socket] Init failed:', e.message);
    }

    const trackingSettings = {};
    let currentTrackingId = null;

    // Convert absolute Windows path → relative URL
    function toRelativeUrl(p) {
        if (!p) return p;
        if (p.includes('\\') || (p.includes(':') && p.includes('uploads'))) {
            const n = p.replace(/\\/g, '/');
            const i = n.indexOf('/uploads/');
            if (i >= 0) return n.substring(i);
        }
        return p;
    }
    function fixVideoPaths(arr) { return (arr || []).map(toRelativeUrl); }

    // Join tracking room khi xem bài viết
    function joinTrackingRoom(trackingId) {
        if (!socket) return;
        if (currentTrackingId) {
            socket.emit('tracking:leave', currentTrackingId);
        }
        currentTrackingId = trackingId;
        socket.emit('tracking:join', trackingId);
    }

    // Listen scrape events
    if (socket) {
        socket.on('scrape:start', (data) => {
            const { trackingId, total, message } = data;
            showScrapeProgress(trackingId, message, 0, total);
        });

        socket.on('scrape:progress', (data) => {
            const { trackingId, current, total, postId, text } = data;
            showScrapeProgress(trackingId, `Đang scrape ${current}/${total}...`, current, total);
        });

        socket.on('scrape:newpost', (data) => {
            const { trackingId, post, saved, total } = data;
            showScrapeProgress(trackingId, `Đã lưu ${saved}/${total} bài viết`, saved, total);
            if (currentTrackingId === trackingId) {
                addPostToTable(post);
            }
        });

        socket.on('scrape:done', (data) => {
            const { trackingId, saved, skipped, filtered, totalPosts, message } = data;
            hideScrapeProgress(trackingId);
            const card = document.querySelector(`.tracking-card[data-id="${trackingId}"]`);
            if (card) {
                const statNum = card.querySelector('.stat-num');
                if (statNum) statNum.textContent = totalPosts;
            }
            showToast('success', message + (filtered > 0 ? ` (loại bỏ ${filtered} bài trống)` : ''));
        });
    }

    // Hiển thị progress bar
    function showScrapeProgress(trackingId, message, current, total) {
        let progressEl = document.getElementById(`scrape-progress-${trackingId}`);
        if (!progressEl) {
            const card = document.querySelector(`.tracking-card[data-id="${trackingId}"]`);
            if (!card) return;
            progressEl = document.createElement('div');
            progressEl.id = `scrape-progress-${trackingId}`;
            progressEl.className = 'scrape-progress';
            progressEl.innerHTML = `
                <div class="scrape-progress-header">
                    <span class="scrape-progress-text"></span>
                    <span class="scrape-progress-count"></span>
                </div>
                <div class="scrape-progress-bar">
                    <div class="scrape-progress-fill"></div>
                </div>
            `;
            card.querySelector('.tracking-card-main').appendChild(progressEl);
        }

        const percent = total > 0 ? Math.round((current / total) * 100) : 0;
        progressEl.querySelector('.scrape-progress-text').textContent = message;
        progressEl.querySelector('.scrape-progress-count').textContent = `${current}/${total}`;
        progressEl.querySelector('.scrape-progress-fill').style.width = `${percent}%`;
        progressEl.style.display = 'block';
    }

    function hideScrapeProgress(trackingId) {
        setTimeout(() => {
            const progressEl = document.getElementById(`scrape-progress-${trackingId}`);
            if (progressEl) progressEl.style.display = 'none';
        }, 2000);
    }

    // Thêm post mới vào table
    function addPostToTable(post) {
        const container = document.getElementById('postsTableContainer');
        if (!container) return;
        const tbody = container.querySelector('tbody');
        if (!tbody) return;

        const images = post.images || [];
        const videos = fixVideoPaths(post.videos);
        const text = (post.text || '').substring(0, 100) + ((post.text || '').length > 100 ? '...' : '');

        let mediaHtml = '';
        if (images.length > 0) {
            mediaHtml = `<div class="table-media-cell">${images.slice(0, 2).map(img =>
                `<img src="${img}" class="table-thumb" onclick="previewImage('${img}')" loading="lazy">`
            ).join('')}${images.length > 2 ? `<span class="table-more-badge">+${images.length - 2}</span>` : ''}</div>`;
        } else if (videos.length > 0) {
            mediaHtml = `<div class="table-media-cell"><video src="${videos[0]}" class="table-thumb-video" preload="metadata" muted onclick="previewVideo('${videos[0]}')"></video></div>`;
        } else {
            mediaHtml = '<span class="table-no-media">Không có</span>';
        }

        const tr = document.createElement('tr');
        const currentType = document.getElementById('trackingType')?.value || 'profile';
        const showTime = currentType !== 'group';
        const publishTime = post.publishedAtText || (post.publishedAt ? new Date(post.publishedAt).toLocaleString('vi-VN') : '');
        tr.className = 'post-new-row';
        tr.innerHTML = `
            <td>${mediaHtml}</td>
            <td>
                <div class="table-post-text">${text || '<em style="color:var(--text-light)">Không có nội dung</em>'}</div>
                <div class="table-post-meta">
                    ${post.permalink ? `<a href="${post.permalink}" target="_blank"><i class="fa-solid fa-external-link"></i> Facebook</a>` : ''}
                </div>
            </td>
            ${showTime ? `<td><span class="table-time">${publishTime || new Date(post.scrapedAt).toLocaleString('vi-VN')}</span></td>` : ''}
            <td>
                <div class="table-actions">
                    <button class="btn-icon btn-icon--sm" title="Chỉnh sửa" onclick="editPost('${post._id}')"><i class="fa-solid fa-pen"></i></button>
                    <button class="btn-icon btn-icon--sm btn-icon--danger" title="Xóa" onclick="deletePost('${post._id}')"><i class="fa-solid fa-trash"></i></button>
                </div>
            </td>
        `;
        tbody.insertBefore(tr, tbody.firstChild);
    }

    // Scrape bài viết
    async function scrapeTracking(id) {
        const limit = trackingSettings[id]?.scrapeLimit || 10;
        if (!confirm(`Scrape ${limit} bài viết mới từ đối tượng này?`)) return;
        try {
            showToast('info', `Đang scrape ${limit} bài viết...`);
            joinTrackingRoom(id);
            const res = await fetch(`/tracking/api/scrape/${id}`, {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ limit })
            });
            const data = await res.json();
            if (data.success) {
                showToast('success', data.message);
                setTimeout(() => location.reload(), 1500);
            } else {
                showToast('error', data.message);
            }
        } catch (e) { showToast('error', 'Lỗi: ' + e.message); }
    }

    // Toggle repost pause
    async function toggleRepostPause(id, currentPaused) {
        if (!confirm(currentPaused ? 'Bật lại auto-repost cho đối tượng này?' : 'Tạm dừng auto-repost? Vẫn sẽ scrape bài viết bình thường.')) return;
        try {
            const res = await fetch(`/tracking/api/repost-pause/${id}`, {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ paused: !currentPaused })
            });
            const data = await res.json();
            if (data.success) {
                showToast('success', data.message);
                setTimeout(() => location.reload(), 600);
            } else {
                showToast('error', data.message || 'Lỗi');
            }
        } catch (e) { showToast('error', 'Lỗi: ' + e.message); }
    }

    // Render badge repost status cho posts table
    function renderRepostStatus(results) {
        if (!Array.isArray(results) || results.length === 0) return '';
        const codeMap = { facebook: 'FB', tiktok: 'TT', instagram: 'IG', youtube: 'YS', pinterest: 'PI', threads: 'TH' };
        const statusMap = { pending: { c: '#f59e0b', i: 'fa-clock' }, posted: { c: '#10b981', i: 'fa-check' }, failed: { c: '#ef4444', i: 'fa-xmark' }, skipped: { c: '#94a3b8', i: 'fa-forward' } };
        const badges = results.map(r => {
            const s = statusMap[r.status] || statusMap.pending;
            const code = r.platform && r.platform.length <= 3 ? r.platform : (codeMap[r.platform] || r.platform);
            return '<span class="repost-badge" title="' + (r.error || r.status || '').replace(/"/g, '&quot;') + '" style="display:inline-block;padding:2px 6px;margin:2px;border-radius:6px;font-size:10px;font-weight:600;background:' + s.c + '22;color:' + s.c + ';"><i class="fa-solid ' + s.i + '"></i> ' + code + '</span>';
        }).join('');
        return '<div style="margin-top:6px;display:flex;flex-wrap:wrap;gap:2px;">' + badges + '</div>';
    }

