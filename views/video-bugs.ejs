<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Video Bugging - ReelsFlow AI</title>
    <link rel="stylesheet" href="/css/base.css">
    <link rel="stylesheet" href="/css/style.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.6.0/css/all.min.css">
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
    <style>
        .bug-page { padding: 24px; max-width: 1200px; margin: 0 auto; }
        .bug-stats { display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 16px; margin-bottom: 24px; }
        .bug-stat-card { background: var(--bg-card, #fff); border: 1px solid var(--border-color, #e5e7eb); border-radius: 12px; padding: 20px; display: flex; align-items: center; gap: 16px; }
        .bug-stat-icon { width: 48px; height: 48px; border-radius: 12px; display: flex; align-items: center; justify-content: center; font-size: 20px; }
        .bug-stat-value { font-size: 24px; font-weight: 700; color: var(--text-main, #1f2937); }
        .bug-stat-label { font-size: 13px; color: var(--text-muted, #6b7280); margin-top: 2px; }
        .bug-actions { display: flex; gap: 12px; margin-bottom: 24px; flex-wrap: wrap; }
        .bug-btn { padding: 10px 20px; border-radius: 10px; font-weight: 600; font-size: 14px; cursor: pointer; border: none; display: inline-flex; align-items: center; gap: 8px; transition: all 0.2s; }
        .bug-btn-primary { background: #6366f1; color: #fff; }
        .bug-btn-primary:hover { background: #4f46e5; }
        .bug-btn-secondary { background: var(--bg-main, #f3f4f6); color: var(--text-main, #374151); border: 1px solid var(--border-color, #e5e7eb); }
        .bug-btn-secondary:hover { background: var(--bg-hover, #e5e7eb); }
        .bug-table { width: 100%; border-collapse: collapse; background: var(--bg-card, #fff); border-radius: 12px; overflow: hidden; border: 1px solid var(--border-color, #e5e7eb); }
        .bug-table th { background: var(--bg-main, #f9fafb); padding: 12px 16px; text-align: left; font-size: 13px; font-weight: 600; color: var(--text-muted, #6b7280); border-bottom: 1px solid var(--border-color, #e5e7eb); }
        .bug-table td { padding: 12px 16px; border-bottom: 1px solid var(--border-color, #f3f4f6); font-size: 14px; color: var(--text-main, #374151); }
        .bug-table tr:hover td { background: var(--bg-hover, #f9fafb); }
        .bug-badge { padding: 4px 10px; border-radius: 20px; font-size: 11px; font-weight: 600; display: inline-flex; align-items: center; gap: 4px; }
        .badge-active { background: #dcfce7; color: #166534; }
        .badge-verified { background: #dbeafe; color: #1e40af; }
        .badge-expired { background: #fee2e2; color: #991b1b; }
        .bug-steps { display: flex; gap: 4px; }
        .bug-step { width: 24px; height: 24px; border-radius: 6px; display: flex; align-items: center; justify-content: center; font-size: 10px; }
        .step-success { background: #dcfce7; color: #166534; }
        .step-fail { background: #fee2e2; color: #991b1b; }
        .modal-overlay { position: fixed; inset: 0; background: rgba(0,0,0,0.5); z-index: 1000; display: flex; align-items: center; justify-content: center; }
        .modal-box { background: var(--bg-card, #fff); border-radius: 16px; width: 90%; max-width: 600px; max-height: 90vh; overflow-y: auto; padding: 24px; }
        .modal-title { font-size: 18px; font-weight: 700; margin-bottom: 16px; display: flex; align-items: center; gap: 8px; }
        .form-group { margin-bottom: 16px; }
        .form-label { font-size: 13px; font-weight: 600; color: var(--text-muted, #6b7280); margin-bottom: 6px; display: block; }
        .form-input { width: 100%; padding: 10px 14px; border: 1px solid var(--border-color, #e5e7eb); border-radius: 8px; font-size: 14px; background: var(--bg-main, #f9fafb); }
        .form-input:focus { outline: none; border-color: #6366f1; box-shadow: 0 0 0 3px rgba(99,102,241,0.1); }
        .upload-zone { border: 2px dashed var(--border-color, #d1d5db); border-radius: 12px; padding: 40px; text-align: center; cursor: pointer; transition: all 0.2s; }
        .upload-zone:hover { border-color: #6366f1; background: rgba(99,102,241,0.02); }
        .upload-zone.dragover { border-color: #6366f1; background: rgba(99,102,241,0.05); }
        .upload-icon { font-size: 40px; color: var(--text-muted, #9ca3af); margin-bottom: 12px; }
        .upload-text { font-size: 14px; color: var(--text-muted, #6b7280); }
        .upload-hint { font-size: 12px; color: var(--text-light, #9ca3af); margin-top: 6px; }
        .result-box { background: var(--bg-main, #f3f4f6); border-radius: 10px; padding: 16px; margin-top: 16px; }
        .result-row { display: flex; justify-content: space-between; padding: 6px 0; font-size: 13px; }
        .result-label { color: var(--text-muted, #6b7280); }
        .result-value { font-weight: 600; color: var(--text-main, #374151); }
        .bug-empty { text-align: center; padding: 60px 20px; }
        .bug-empty-icon { font-size: 48px; color: var(--text-muted, #d1d5db); margin-bottom: 16px; }
        .bug-empty h3 { font-size: 16px; color: var(--text-main, #374151); margin-bottom: 8px; }
        .bug-empty p { font-size: 13px; color: var(--text-muted, #6b7280); }
        .progress-bar { width: 100%; height: 4px; background: var(--bg-main, #e5e7eb); border-radius: 2px; overflow: hidden; margin-top: 12px; }
        .progress-fill { height: 100%; background: #6366f1; border-radius: 2px; transition: width 0.3s; }
        .spinner { display: inline-block; width: 16px; height: 16px; border: 2px solid #fff; border-top-color: transparent; border-radius: 50%; animation: spin 0.6s linear infinite; }
        @keyframes spin { to { transform: rotate(360deg); } }
    </style>
</head>
<body>
    <%- include('partials/sidebar', { currentPage: 'video-bugs' }) %>

    <div class="main-content">
        <%- include('partials/header') %>

        <main class="content-body bug-page">
            <!-- Header -->
            <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:24px;">
                <div>
                    <h1 style="font-size:22px; font-weight:700; margin:0;">
                        <i class="fa-solid fa-bug" style="color:#6366f1;"></i> Video Bugging
                    </h1>
                    <p style="font-size:13px; color:var(--text-muted); margin-top:4px;">Embed dấu vết theo dõi vào video để bảo vệ nội dung</p>
                </div>
                <button class="bug-btn bug-btn-primary" onclick="openEmbedModal()">
                    <i class="fa-solid fa-plus"></i> Embed Bug Mới
                </button>
            </div>

            <!-- Stats -->
            <div class="bug-stats">
                <div class="bug-stat-card">
                    <div class="bug-stat-icon" style="background:rgba(99,102,241,0.1); color:#6366f1;">
                        <i class="fa-solid fa-video"></i>
                    </div>
                    <div>
                        <div class="bug-stat-value"><%= stats.total %></div>
                        <div class="bug-stat-label">Tổng video</div>
                    </div>
                </div>
                <div class="bug-stat-card">
                    <div class="bug-stat-icon" style="background:rgba(34,197,94,0.1); color:#22c55e;">
                        <i class="fa-solid fa-check-circle"></i>
                    </div>
                    <div>
                        <div class="bug-stat-value"><%= stats.active %></div>
                        <div class="bug-stat-label">Đang active</div>
                    </div>
                </div>
                <div class="bug-stat-card">
                    <div class="bug-stat-icon" style="background:rgba(59,130,246,0.1); color:#3b82f6;">
                        <i class="fa-solid fa-shield-check"></i>
                    </div>
                    <div>
                        <div class="bug-stat-value"><%= stats.verified %></div>
                        <div class="bug-stat-label">Đã verify</div>
                    </div>
                </div>
            </div>

            <!-- Actions -->
            <div class="bug-actions">
                <button class="bug-btn bug-btn-secondary" onclick="openExtractModal()">
                    <i class="fa-solid fa-magnifying-glass"></i> Trích Xuất Bug
                </button>
            </div>

            <!-- Table -->
            <% if (bugs.length === 0) { %>
            <div class="bug-empty" style="background:var(--bg-card); border:1px solid var(--border-color); border-radius:12px;">
                <div class="bug-empty-icon"><i class="fa-solid fa-bug"></i></div>
                <h3>Chưa có video bug nào</h3>
                <p>Nhấn "Embed Bug Mới" để bắt đầu bảo vệ video của bạn</p>
            </div>
            <% } else { %>
            <div style="overflow-x:auto;">
                <table class="bug-table">
                    <thead>
                        <tr>
                            <th>Tên video</th>
                            <th>Tracking ID</th>
                            <th>Trạng thái</th>
                            <th>Bugs</th>
                            <th>MD5</th>
                            <th>Ngày tạo</th>
                            <th>Hành động</th>
                        </tr>
                    </thead>
                    <tbody>
                        <% bugs.forEach(function(bug) { %>
                        <tr>
                            <td style="font-weight:500;"><%= bug.originalName || 'Video' %></td>
                            <td><code style="background:var(--bg-main); padding:2px 8px; border-radius:4px; font-size:12px;"><%= bug.trackingId %></code></td>
                            <td>
                                <span class="bug-badge badge-<%= bug.status %>">
                                    <i class="fa-solid <%= bug.status === 'active' ? 'fa-circle' : bug.status === 'verified' ? 'fa-check' : 'fa-clock' %>"></i>
                                    <%= bug.status === 'active' ? 'Active' : bug.status === 'verified' ? 'Verified' : 'Expired' %>
                                </span>
                            </td>
                            <td>
                                <div class="bug-steps">
                                    <% var types = ['metadata','frame','watermark','audio']; %>
                                    <% types.forEach(function(t) { %>
                                        <% var found = bug.bugs.find(function(b) { return b.type === t; }); %>
                                        <div class="bug-step <%= found ? 'step-success' : 'step-fail' %>" title="<%= t %>">
                                            <i class="fa-solid <%= found ? 'fa-check' : 'fa-xmark' %>"></i>
                                        </div>
                                    <% }); %>
                                </div>
                            </td>
                            <td><code style="font-size:11px; color:var(--text-muted);"><%= bug.md5Hash ? bug.md5Hash.substring(0, 12) + '...' : 'N/A' %></code></td>
                            <td><%= new Date(bug.createdAt).toLocaleDateString('vi-VN') %></td>
                            <td>
                                <div style="display:flex; gap:6px;">
                                    <button class="bug-btn bug-btn-secondary" style="padding:6px 10px; font-size:12px;" onclick="verifyBug('<%= bug._id %>')" title="Verify">
                                        <i class="fa-solid fa-shield-check"></i>
                                    </button>
                                    <button class="bug-btn bug-btn-secondary" style="padding:6px 10px; font-size:12px; color:#ef4444;" onclick="deleteBug('<%= bug._id %>')" title="Xóa">
                                        <i class="fa-solid fa-trash"></i>
                                    </button>
                                </div>
                            </td>
                        </tr>
                        <% }); %>
                    </tbody>
                </table>
            </div>
            <% } %>

            <!-- Pagination -->
            <% if (typeof pagination !== 'undefined' && pagination.totalPages > 1) { %>
            <div style="display:flex; justify-content:center; gap:8px; margin-top:24px;">
                <% for (let i = 1; i <= pagination.totalPages; i++) { %>
                <a href="/video-bugs?page=<%= i %>" class="bug-btn bug-btn-secondary" style="padding:8px 14px; font-size:13px; <%= i === pagination.currentPage ? 'background:#6366f1; color:#fff; border-color:#6366f1;' : '' %>"><%= i %></a>
                <% } %>
            </div>
            <% } %>
        </main>
    </div>

    <!-- Modal: Embed Bug -->
    <div class="modal-overlay" id="embedModal" style="display:none;" onclick="if(event.target===this)closeEmbedModal()">
        <div class="modal-box">
            <div class="modal-title">
                <i class="fa-solid fa-bug" style="color:#6366f1;"></i> Embed Bug Vào Video
            </div>
            <form id="embedForm" onsubmit="return submitEmbed(event)">
                <div class="form-group">
                    <label class="form-label">Chọn video</label>
                    <div class="upload-zone" id="uploadZone" onclick="document.getElementById('videoInput').click()">
                        <input type="file" id="videoInput" accept="video/*" style="display:none;" onchange="onFileSelected(this)">
                        <div class="upload-icon"><i class="fa-solid fa-cloud-arrow-up"></i></div>
                        <div class="upload-text" id="uploadText">Kéo thả hoặc nhấn để chọn video</div>
                        <div class="upload-hint">MP4, AVI, MOV, MKV, WebM (tối đa 200MB)</div>
                    </div>
                </div>

                <div id="embedProgress" style="display:none;">
                    <div style="font-size:13px; color:var(--text-muted);" id="embedStatus">Đang embed bug...</div>
                    <div class="progress-bar"><div class="progress-fill" id="embedProgressFill" style="width:0%"></div></div>
                </div>

                <div id="embedResult" style="display:none;"></div>

                <div style="display:flex; justify-content:flex-end; gap:10px; margin-top:20px;">
                    <button type="button" class="bug-btn bug-btn-secondary" onclick="closeEmbedModal()">Đóng</button>
                    <button type="submit" class="bug-btn bug-btn-primary" id="embedSubmitBtn">
                        <i class="fa-solid fa-bug"></i> Embed Bug
                    </button>
                </div>
            </form>
        </div>
    </div>

    <!-- Modal: Extract Bug -->
    <div class="modal-overlay" id="extractModal" style="display:none;" onclick="if(event.target===this)closeExtractModal()">
        <div class="modal-box">
            <div class="modal-title">
                <i class="fa-solid fa-magnifying-glass" style="color:#f59e0b;"></i> Trích Xuất Bug Từ Video
            </div>
            <form id="extractForm" onsubmit="return submitExtract(event)">
                <div class="form-group">
                    <label class="form-label">Chọn video cần trích xuất</label>
                    <div class="upload-zone" onclick="document.getElementById('extractInput').click()">
                        <input type="file" id="extractInput" accept="video/*" style="display:none;" onchange="onExtractFileSelected(this)">
                        <div class="upload-icon"><i class="fa-solid fa-magnifying-glass"></i></div>
                        <div class="upload-text" id="extractText">Chọn video để trích xuất bug</div>
                    </div>
                </div>

                <div id="extractResult" style="display:none;"></div>

                <div style="display:flex; justify-content:flex-end; gap:10px; margin-top:20px;">
                    <button type="button" class="bug-btn bug-btn-secondary" onclick="closeExtractModal()">Đóng</button>
                    <button type="submit" class="bug-btn bug-btn-primary" id="extractSubmitBtn">
                        <i class="fa-solid fa-magnifying-glass"></i> Trích Xuất
                    </button>
                </div>
            </form>
        </div>
    </div>

    <script src="/js/base.js"></script>
    <script>
    function openEmbedModal() {
        document.getElementById('embedModal').style.display = 'flex';
        document.getElementById('embedResult').style.display = 'none';
        document.getElementById('embedProgress').style.display = 'none';
        document.getElementById('videoInput').value = '';
        document.getElementById('uploadText').textContent = 'Kéo thả hoặc nhấn để chọn video';
    }
    function closeEmbedModal() {
        document.getElementById('embedModal').style.display = 'none';
    }
    function openExtractModal() {
        document.getElementById('extractModal').style.display = 'flex';
        document.getElementById('extractResult').style.display = 'none';
    }
    function closeExtractModal() {
        document.getElementById('extractModal').style.display = 'none';
    }
    function onFileSelected(input) {
        if (input.files.length > 0) {
            document.getElementById('uploadText').textContent = input.files[0].name;
        }
    }
    function onExtractFileSelected(input) {
        if (input.files.length > 0) {
            document.getElementById('extractText').textContent = input.files[0].name;
        }
    }

    async function submitEmbed(e) {
        e.preventDefault();
        const fileInput = document.getElementById('videoInput');
        if (!fileInput.files.length) { showToast('error', 'Vui lòng chọn video'); return false; }

        const formData = new FormData();
        formData.append('video', fileInput.files[0]);

        document.getElementById('embedProgress').style.display = 'block';
        document.getElementById('embedStatus').textContent = 'Đang upload và embed bug...';
        document.getElementById('embedProgressFill').style.width = '30%';
        document.getElementById('embedSubmitBtn').disabled = true;
        document.getElementById('embedSubmitBtn').innerHTML = '<span class="spinner"></span> Đang xử lý...';

        try {
            const res = await fetch('/video-bugs/api/embed', { method: 'POST', body: formData });
            const data = await res.json();
            document.getElementById('embedProgressFill').style.width = '100%';

            if (data.success) {
                document.getElementById('embedStatus').textContent = 'Embed thành công!';
                const result = data.data;
                document.getElementById('embedResult').style.display = 'block';
                document.getElementById('embedResult').innerHTML = `
                    <div class="result-box">
                        <div class="result-row"><span class="result-label">Tracking ID</span><span class="result-value" style="color:#6366f1;">${result.trackingId}</span></div>
                        <div class="result-row"><span class="result-label">File</span><span class="result-value">${result.originalName}</span></div>
                        <div class="result-row"><span class="result-label">MD5</span><span class="result-value" style="font-size:11px;">${result.md5}</span></div>
                        <div class="result-row"><span class="result-label">Duration</span><span class="result-value">${result.duration ? result.duration.toFixed(1) + 's' : 'N/A'}</span></div>
                        <div style="margin-top:12px; padding-top:12px; border-top:1px solid var(--border-color);">
                            <div style="font-size:12px; font-weight:600; margin-bottom:8px;">Bugs đã embed:</div>
                            <div class="bug-steps" style="gap:6px;">
                                ${result.steps.map(s => `<div class="bug-step ${s.success ? 'step-success' : 'step-fail'}" title="${s.type}"><i class="fa-solid ${s.success ? 'fa-check' : 'fa-xmark'}"></i></div>`).join('')}
                                <span style="font-size:12px; color:var(--text-muted);">${result.steps.filter(s=>s.success).length}/${result.steps.length}</span>
                            </div>
                        </div>
                    </div>`;
                showToast('success', data.message);
            } else {
                document.getElementById('embedStatus').textContent = 'Embed thất bại!';
                document.getElementById('embedResult').style.display = 'block';
                document.getElementById('embedResult').innerHTML = `<div class="result-box" style="color:#ef4444;"><i class="fa-solid fa-circle-exclamation"></i> ${data.message}</div>`;
                showToast('error', data.message);
            }
        } catch (err) {
            document.getElementById('embedStatus').textContent = 'Lỗi: ' + err.message;
            showToast('error', 'Lỗi: ' + err.message);
        }

        document.getElementById('embedSubmitBtn').disabled = false;
        document.getElementById('embedSubmitBtn').innerHTML = '<i class="fa-solid fa-bug"></i> Embed Bug';
        return false;
    }

    async function submitExtract(e) {
        e.preventDefault();
        const fileInput = document.getElementById('extractInput');
        if (!fileInput.files.length) { showToast('error', 'Vui lòng chọn video'); return false; }

        const formData = new FormData();
        formData.append('video', fileInput.files[0]);

        document.getElementById('extractSubmitBtn').disabled = true;
        document.getElementById('extractSubmitBtn').innerHTML = '<span class="spinner"></span> Đang trích xuất...';

        try {
            const res = await fetch('/video-bugs/api/extract', { method: 'POST', body: formData });
            const data = await res.json();

            document.getElementById('extractResult').style.display = 'block';
            if (data.success) {
                const d = data.data;
                document.getElementById('extractResult').innerHTML = `
                    <div class="result-box">
                        <div class="result-row"><span class="result-label">Tracking ID</span><span class="result-value" style="color:${d.trackingId ? '#22c55e' : '#ef4444'};">${d.trackingId || 'Không tìm thấy'}</span></div>
                        <div class="result-row"><span class="result-label">MD5</span><span class="result-value" style="font-size:11px;">${d.md5}</span></div>
                        <div class="result-row"><span class="result-label">Duration</span><span class="result-value">${d.videoInfo?.format?.duration ? parseFloat(d.videoInfo.format.duration).toFixed(1) + 's' : 'N/A'}</span></div>
                        ${d.metadata ? `
                        <div style="margin-top:8px; padding-top:8px; border-top:1px solid var(--border-color); font-size:12px;">
                            <div style="font-weight:600; margin-bottom:4px;">Metadata:</div>
                            ${d.metadata.title ? `<div>Title: ${d.metadata.title}</div>` : ''}
                            ${d.metadata.comment ? `<div>Comment: ${d.metadata.comment}</div>` : ''}
                            ${d.metadata.artist ? `<div>Artist: ${d.metadata.artist}</div>` : ''}
                        </div>` : ''}
                    </div>`;
                showToast('success', d.trackingId ? `Tìm thấy bug: ${d.trackingId}` : 'Không tìm thấy bug trong video');
            } else {
                document.getElementById('extractResult').innerHTML = `<div class="result-box" style="color:#ef4444;">${data.message}</div>`;
                showToast('error', data.message);
            }
        } catch (err) {
            document.getElementById('extractResult').style.display = 'block';
            document.getElementById('extractResult').innerHTML = `<div class="result-box" style="color:#ef4444;">Lỗi: ${err.message}</div>`;
            showToast('error', err.message);
        }

        document.getElementById('extractSubmitBtn').disabled = false;
        document.getElementById('extractSubmitBtn').innerHTML = '<i class="fa-solid fa-magnifying-glass"></i> Trích Xuất';
        return false;
    }

    async function verifyBug(id) {
        try {
            showToast('info', 'Đang verify...');
            const res = await fetch(`/video-bugs/api/verify/${id}`, { method: 'POST' });
            const data = await res.json();
            if (data.success && data.verified) {
                showToast('success', 'Verify thành công! Bug được xác nhận.');
                setTimeout(() => location.reload(), 1000);
            } else {
                showToast('error', data.verified ? 'Verify OK' : 'Verify thất bại - bug không khớp');
            }
        } catch (err) { showToast('error', err.message); }
    }

    async function deleteBug(id) {
        if (!confirm('Xóa video bug này?')) return;
        try {
            const res = await fetch(`/video-bugs/api/delete/${id}`, { method: 'DELETE' });
            const data = await res.json();
            if (data.success) {
                showToast('success', 'Đã xóa');
                setTimeout(() => location.reload(), 800);
            } else {
                showToast('error', data.message);
            }
        } catch (err) { showToast('error', err.message); }
    }
    </script>
</body>
</html>
